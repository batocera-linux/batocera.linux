#!/bin/bash
# Discord voice panel, opened by a hotkeygen action (the Share / Capture button by default, see discord.hotkey).
# Enable it from the main menu: System settings > Services > discord

PIDFILE=/var/run/batocera-discord-service.pid

start() {
    start-stop-daemon -S -b -q -m -p "$PIDFILE" --exec /usr/bin/batocera-discord -- run
    echo "done"
}

stop() {
    start-stop-daemon -K -q -p "$PIDFILE" --retry TERM/5/KILL/2
    rm -f "$PIDFILE"
    echo "done"
}

status() {
    if start-stop-daemon --status -q -p "$PIDFILE"; then
        echo "started"
    else
        echo "stopped"
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" ;;
esac
