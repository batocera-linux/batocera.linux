config BR2_PACKAGE_OPENGOAL
	bool "opengoal"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_ZLIB
	help
	  OpenGOAL - native PC ports of Jak and Daxter, Jak II and Jak 3,
	  decompiled from the PlayStation 2 originals.

	  Ships the runtime, the GOAL compiler and the ISO extractor. You
	  supply your own disc image; the first launch extracts and builds
	  the game from it.

	  https://opengoal.dev

comment "opengoal needs a toolchain w/ C++ and OpenGL"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_HAS_LIBGL
