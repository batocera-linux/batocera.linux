+# zipdir (built with the tools) links the internal miniz target for miniz.h.
+# The internal ZMusic library also provides miniz, but ZMusic is only built for
+# the full (non-TOOLS_ONLY) build, so pull miniz in directly here when
+# ZMUSIC_SYSTEM_INSTALL is set (as the host tools build does). This restored the
+# separate ZMUSIC_SYSTEM_INSTALL/libraries/miniz block that older releases had
+# and upstream dropped, keeping the TOOLS_ONLY host build able to build zipdir.
+if( ZMUSIC_SYSTEM_INSTALL )
+	add_subdirectory( libraries/miniz )
+endif()
