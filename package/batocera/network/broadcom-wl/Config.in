config BR2_PACKAGE_BROADCOM_WL
	bool "broadcom-wl"
	depends on BR2_LINUX_KERNEL
	depends on BR2_x86_64
	help
	  Broadcom STA (wl) wifi driver for older Macs.

	  https://docs.broadcom.com/docs-and-downloads/docs/linux_sta

comment "broadcom-wl needs a Linux kernel to be built"
	depends on BR2_x86_64
	depends on !BR2_LINUX_KERNEL
