comment "aic8800 needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL

config BR2_PACKAGE_AIC8800
	bool "aic8800"
	depends on BR2_LINUX_KERNEL
	help
	  Linux Driver for the aicsemi aic8800 WiFi / BT Adapter.

	  https://github.com/radxa-pkg/aic8800

config BR2_PACKAGE_AIC8800_SDIO
	bool "aic8800sdio"
	depends on BR2_LINUX_KERNEL
	select BR2_PACKAGE_AIC8800
	help
	  Linux Driver for the aicsemi aic8800 WiFi / BT Adapter, SDIO driver.

config BR2_PACKAGE_AIC8800_USB
	bool "aic8800usb"
	depends on BR2_LINUX_KERNEL
	select BR2_PACKAGE_AIC8800
	help
	  Linux Driver for the aicsemi aic8800 WiFi / BT Adapter, USB driver.
