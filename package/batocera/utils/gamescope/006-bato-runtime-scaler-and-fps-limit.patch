+gamescope::ConCommand cc_fps_limit( "fps_limit", "Limit the game frame rate, 0 for no limit",
+[](std::span<std::string_view> svArgs)
+{
+	std::optional<int32_t> onFps = svArgs.size() < 2 ? std::nullopt : gamescope::Parse<int32_t>( svArgs[1] );
+	if ( !onFps || *onFps < 0 )
+	{
+		console_log.errorf( "Usage: fps_limit <fps>" );
+		return;
