+static std::atomic<int32_t> g_nPendingUpscaleScaler = { -1 };
+
+static gamescope::ConCommand cc_scaling_scaler( "scaling_scaler", "Set the scaler (auto, integer, fit, fill, stretch)",
+[]( std::span<std::string_view> args )
+{
+	static constexpr std::pair<std::string_view, GamescopeUpscaleScaler> k_Scalers[] =
+	{
+		{ "auto",    GamescopeUpscaleScaler::AUTO },
+		{ "integer", GamescopeUpscaleScaler::INTEGER },
+		{ "fit",     GamescopeUpscaleScaler::FIT },
+		{ "fill",    GamescopeUpscaleScaler::FILL },
+		{ "stretch", GamescopeUpscaleScaler::STRETCH },
+	};
+
+	if ( args.size() < 2 )
+	{
+		console_log.errorf( "Usage: scaling_scaler <scaler>" );
+		return;
+	}
+
+	for ( const auto &[svName, eScaler] : k_Scalers )
+	{
+		if ( svName == args[1] )
+		{
+			g_nPendingUpscaleScaler = int32_t( eScaler );
+			return;
+		}
+	}
+
+	console_log.errorf( "Unknown scaler '%.*s'", (int)args[1].size(), args[1].data() );
+});
+
