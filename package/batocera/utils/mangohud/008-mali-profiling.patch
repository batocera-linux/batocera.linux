+// panfrost and panthor only put per-job GPU time in fdinfo with profiling on
+void GPU_fdinfo::enable_mali_profiling()
+{
+    std::string path = "/sys/class/drm/" + drm_node + "/device/profiling";
+    std::string val;
+    std::ifstream in(path);
+
+    if (!in.is_open() || !std::getline(in, val) || val == "1")
+        return;
+
+    std::ofstream out(path);
+    out << "1";
+
+    if (!out)
+        SPDLOG_WARN("{}: cannot enable profiling, gpu load will read 0", path);
+}
