output: set up a returning output the way it was before it went away

An output that is unplugged, or a screen that drops its hotplug signal in
standby, comes back in its preferred mode and at an automatic position.
Remember its state and apply it again when the same screen returns.

diff --git a/src/output.c b/src/output.c
index 67d4e6a..5babc74 100644
--- a/src/output.c
+++ b/src/output.c
@@ -39,6 +39,85 @@
 #include "view.h"
 #include "xwayland.h"
 
+/* how an output was set up when it went away, to set it up the same way if it comes back */
+struct saved_output {
+	struct wl_list link;
+	char *name, *make, *model, *serial;
+	bool enabled;
+	int32_t width, height, refresh;
+	enum wl_output_transform transform;
+	float scale;
+	struct wlr_box box;
+};
+
+static struct wl_list saved_outputs = { &saved_outputs, &saved_outputs };
+
+static void
+saved_output_free(struct saved_output *saved)
+{
+	wl_list_remove(&saved->link);
+	g_free(saved->name);
+	g_free(saved->make);
+	g_free(saved->model);
+	g_free(saved->serial);
+	free(saved);
+}
+
+static struct saved_output *
+saved_output_find(struct wlr_output *wlr_output)
+{
+	struct saved_output *saved;
+	wl_list_for_each(saved, &saved_outputs, link) {
+		if (str_equal(saved->name, wlr_output->name)
+				&& str_equal(saved->make, wlr_output->make)
+				&& str_equal(saved->model, wlr_output->model)
+				&& str_equal(saved->serial, wlr_output->serial)) {
+			return saved;
+		}
+	}
+	return NULL;
+}
+
+static void
+output_save(struct wlr_output *wlr_output)
+{
+	struct saved_output *saved, *tmp;
+	wl_list_for_each_safe(saved, tmp, &saved_outputs, link) {
+		if (str_equal(saved->name, wlr_output->name)) {
+			saved_output_free(saved);
+		}
+	}
+
+	saved = znew(*saved);
+	saved->name = g_strdup(wlr_output->name);
+	saved->make = g_strdup(wlr_output->make);
+	saved->model = g_strdup(wlr_output->model);
+	saved->serial = g_strdup(wlr_output->serial);
+	saved->enabled = wlr_output->enabled;
+	saved->width = wlr_output->width;
+	saved->height = wlr_output->height;
+	saved->refresh = wlr_output->refresh;
+	saved->transform = wlr_output->transform;
+	saved->scale = wlr_output->scale;
+	wlr_output_layout_get_box(server.output_layout, wlr_output, &saved->box);
+	wl_list_insert(&saved_outputs, &saved->link);
+}
+
+static bool
+saved_output_set_mode(struct saved_output *saved, struct wlr_output *wlr_output,
+		struct wlr_output_state *state)
+{
+	struct wlr_output_mode *mode;
+	wl_list_for_each(mode, &wlr_output->modes, link) {
+		if (mode->width == saved->width && mode->height == saved->height
+				&& mode->refresh == saved->refresh) {
+			wlr_output_state_set_mode(state, mode);
+			return true;
+		}
+	}
+	return false;
+}
+
 #if WLR_HAS_X11_BACKEND
 	#include <wlr/backend/x11.h>
 #endif
