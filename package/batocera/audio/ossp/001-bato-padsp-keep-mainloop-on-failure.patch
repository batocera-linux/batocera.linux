Keep the PulseAudio mainloop running when a stream fails

padsp_done() quit the threaded mainloop, but the main thread can be waiting
in pa_threaded_mainloop_wait() for an operation (a drain on close), so it
never woke up and osspd's reaper blocked on it for good. Flag the failure
and signal instead, and stop the waits when a failure is flagged.

--- a/ossp-padsp.c
+++ b/ossp-padsp.c
@@ -125,8 +125,9 @@
 
 static int padsp_done(void)
 {
+	/* quitting the mainloop would strand a main thread waiting on an op */
 	fail_code = -EIO;
-	mainloop_api->quit(mainloop_api, 1);
+	pa_threaded_mainloop_signal(mainloop, 0);
 	return fail_code;
 }
 
@@ -164,8 +165,11 @@
 	pa_operation *_o;						\
 	_o = op(args);							\
 	if (_o) {							\
-		while (pa_operation_get_state(_o) != PA_OPERATION_DONE)	\
+		while (pa_operation_get_state(_o) == PA_OPERATION_RUNNING && \
+		       !fail_code)					\
 			pa_threaded_mainloop_wait(mainloop);		\
+		if (pa_operation_get_state(_o) == PA_OPERATION_RUNNING)	\
+			pa_operation_cancel(_o);			\
 		pa_operation_unref(_o);					\
 	} } while (0)
 
@@ -182,14 +186,14 @@
 }
 
