@@ -2327,7 +2333,18 @@
     NvLength length
 )
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+    // Rel. commit "string: Remove strncpy() from the kernel" (Kees Cook, 18 Jun 2026)
+    // Open-coded strncpy().
+    NvLength i;
+    for (i = 0; i < length && src[i] != '\0'; i++)
+        dest[i] = src[i];
+    for (; i < length; i++)
+        dest[i] = '\0';
+    return dest;
+#else
     return strncpy(dest, src, length);
+#endif
 }
 
