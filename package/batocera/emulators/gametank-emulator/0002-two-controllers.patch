Date: Thu, 17 Sep 2026 22:03:23 +1000
Subject: [PATCH] Route each connected pad to its own controller port

Only one controller was opened and every joystick binding drove port 1.
Track up to two pads and pick the port from the device the event came from.
---
 src/joystick_adapter.cpp | 114 +++++++++++++++++++++++++++++----------
 src/joystick_adapter.h   |   8 ++-
 2 files changed, 93 insertions(+), 29 deletions(-)

diff --git a/src/joystick_adapter.cpp b/src/joystick_adapter.cpp
index 4d34ba2..59cbe74 100644
--- a/src/joystick_adapter.cpp
+++ b/src/joystick_adapter.cpp
@@ -8,19 +8,74 @@
 #include "imgui/backends/imgui_impl_sdl2.h"
 #endif
 
+// The pad an event came from decides which port it drives, so the joystick
+// bindings are all kept in their player 1 form and shifted here.
+static GameTankButtons::ButtonId slot_button(GameTankButtons::ButtonId button, int slot) {
+	return (GameTankButtons::ButtonId)((button % BUTTON_COUNT) + (slot * BUTTON_COUNT));
+}
+
+int JoystickAdapter::ControllerSlot(SDL_JoystickID which) {
+	for(int slot = 0; slot < MAX_CONTROLLERS; ++slot) {
+		if((gGameControllers[slot] != NULL) && (gGameControllerIds[slot] == which)) {
+			return slot;
+		}
+	}
+	return -1;
+}
+
+void JoystickAdapter::OpenController(int deviceIndex) {
+	if(ControllerSlot(SDL_JoystickGetDeviceInstanceID(deviceIndex)) >= 0) {
+		return;
+	}
+
+	for(int slot = 0; slot < MAX_CONTROLLERS; ++slot) {
+		if(gGameControllers[slot] != NULL) {
+			continue;
+		}
+
+		SDL_GameController* controller = SDL_GameControllerOpen(deviceIndex);
+		if(controller == NULL) {
+			return;
+		}
+
+		gGameControllers[slot] = controller;
+		gGameControllerIds[slot] = SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller));
+		printf("Joystick found for player %d\n", slot + 1);
+		RefreshImguiGamepads();
+		return;
+	}
+}
+
+void JoystickAdapter::RefreshImguiGamepads() {
+#ifndef WASM_BUILD
+	SDL_GameController* openControllers[MAX_CONTROLLERS];
+	int count = 0;
+
+	for(int slot = 0; slot < MAX_CONTROLLERS; ++slot) {
+		if(gGameControllers[slot] != NULL) {
+			openControllers[count++] = gGameControllers[slot];
+		}
+	}
+
+	if(count > 0) {
+		ImGui_ImplSDL2_SetGamepadMode(ImGui_ImplSDL2_GamepadMode_Manual, openControllers, count);
+	} else {
+		ImGui_ImplSDL2_SetGamepadMode(ImGui_ImplSDL2_GamepadMode_Manual);
+	}
+#endif
+}
