config BR2_PACKAGE_GAMETANK_EMULATOR
	bool "gametank-emulator"
	depends on BR2_PACKAGE_SDL2
	depends on BR2_INSTALL_LIBSTDCPP
	help
	  Emulator for the GameTank, an 8-bit homebrew game console
	  built around the 6502.

	  https://github.com/clydeshaffer/GameTankEmulator
	  https://gametank.zone/

comment "gametank-emulator needs SDL2 and a toolchain w/ C++"
	depends on !BR2_PACKAGE_SDL2 || !BR2_INSTALL_LIBSTDCPP
