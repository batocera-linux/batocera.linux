+    // A centred stick sends no events until it moves, so start each analogue channel from the axis position,
+    // otherwise a gun on a stick sits at 0,0 (off-screen) until the stick moves
+    for (int code = 0; code < ABS_MAX; code++)
+    {
+        ArcadeInput *trigger = &args->controller->absTriggers[code];
+        struct input_absinfo absInfo;
+        if (!trigger->enabled || !trigger->isAnalogue || ioctl(fd, EVIOCGABS(code), &absInfo) < 0 ||
+            absInfo.maximum <= absInfo.minimum)
+            continue;
+
+        double scaled = ((double)absInfo.value - absInfo.minimum) / ((double)absInfo.maximum - absInfo.minimum);
+        if (trigger->isNeg == 1)
+            scaled = 1.0 - scaled;
+        if (scaled > analogue_deadzones[trigger->channel].middle_min && scaled < analogue_deadzones[trigger->channel].middle_max)
+            scaled = 0.5;
+
+        args->controller->lastAnalogueValue[trigger->channel] = scaled;
+        setAnalogue(trigger->channel, scaled * (pow(2, jvsBits) - 1));
+    }
