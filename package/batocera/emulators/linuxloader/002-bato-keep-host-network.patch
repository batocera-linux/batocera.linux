+static int (*_unlink)(const char *path) = NULL;
+int unlink(const char *path)
+{
+    if (_unlink == NULL)
+        _unlink = REAL_FUNC(unlink);
+
+    if (strcmp(path, "/etc/resolv.conf") == 0)
+        path = "resolv.conf";
+
+    return _unlink(path);
+}
