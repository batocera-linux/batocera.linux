Report a 1920x1080 max geometry instead of 4096x4096 so GLES2 GPUs with a
2048 texture limit can open the frame texture. Larger paks grow it through
SET_SYSTEM_AV_INFO.

--- a/src/glue/libretro.cpp
+++ b/src/glue/libretro.cpp
@@ -81,6 +81,8 @@
 static uint32_t g_state_capacity;
 static bool g_variable_state_size;
 static int g_width = 320, g_height = 240;
+/* GL drivers size the frame texture from these; grow them only on demand. */
+static unsigned g_max_width = 1920, g_max_height = 1080;
 static uint32_t *g_crt_pixels; /* presentation scratch, outside engine states */
 static char g_engine[48];           /* physical engine actually loaded */
 static char g_logical_engine[48];   /* selected logical compatibility profile */
@@ -1056,8 +1058,10 @@
     memset(info, 0, sizeof(*info));
     info->geometry.base_width = (unsigned)g_width;
     info->geometry.base_height = (unsigned)g_height;
-    info->geometry.max_width = 4096;
-    info->geometry.max_height = 4096;
+    if ((unsigned)g_width > g_max_width) g_max_width = (unsigned)g_width;
+    if ((unsigned)g_height > g_max_height) g_max_height = (unsigned)g_height;
+    info->geometry.max_width = g_max_width;
+    info->geometry.max_height = g_max_height;
     info->geometry.aspect_ratio = (float)g_width / (float)g_height;
     info->timing.fps = 60.0;
     info->timing.sample_rate = 44100.0;
@@ -1436,11 +1440,13 @@
             pitch = out_w;
         }
         if (w != g_width || h != g_height) {
+            bool grow = (unsigned)w > g_max_width || (unsigned)h > g_max_height;
             g_width = w;
             g_height = h;
             struct retro_system_av_info av;
             retro_get_system_av_info(&av);
-            env_cb(RETRO_ENVIRONMENT_SET_GEOMETRY, &av.geometry);
+            if (!grow || !env_cb(RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO, &av))
+                env_cb(RETRO_ENVIRONMENT_SET_GEOMETRY, &av.geometry);
         }
         glue_dump_maybe(px, w, h, pitch);
         video_cb(px, (unsigned)w, (unsigned)h, (size_t)pitch * sizeof(uint32_t));
