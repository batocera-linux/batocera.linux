From: Batocera <batocera@batocera.org>
Subject: [PATCH] Allow callers to request the compiler host for dependencies

Buildroot may run on a different architecture from its target. Let its
package recipe request --host explicitly, using the selected compiler's
-dumpmachine result for the bundled Autoconf dependencies. Direct builds
retain their existing behavior unless they pass the flag.

---
diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -7,6 +7,7 @@
 platform ?= $(if $(filter Darwin,$(shell uname -s)),osx,unix)
 TARGET ?= auto
 DIST_DIR ?= dist
+ANYBOR_BUILD_ARGS ?=
 
 # Do not export GNU make's built-in CC=cc / CXX=g++ to a cross build.
 ifeq ($(filter default undefined,$(origin CC)),)
@@ -21,10 +22,10 @@
 export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
 
 all:
-	+$(PYTHON) tools/build.py --target $(TARGET) --platform $(platform)
+	+$(PYTHON) tools/build.py --target $(TARGET) --platform $(platform) $(ANYBOR_BUILD_ARGS)
 
 glue:
-	+$(PYTHON) tools/build.py --target $(TARGET) --platform $(platform) --glue-only
+	+$(PYTHON) tools/build.py --target $(TARGET) --platform $(platform) --glue-only $(ANYBOR_BUILD_ARGS)
 
 release deploy:
 	$(PYTHON) tools/check.py --sources-only
diff --git a/tools/build.py b/tools/build.py
--- a/tools/build.py
+++ b/tools/build.py
@@ -683,7 +683,7 @@
         sym.unlink()
 
 
-def configure_target(requested, build_platform):
+def configure_target(requested, build_platform, always_get_host_triple=False):
     """Honor the tools supplied by libretro runners, including native ARM64."""
     inferred_native = False
     if requested == "auto":
@@ -726,7 +726,7 @@
         "aarch64" if "aarch64" in requested or spec.get("android") else "x86_64")
     if spec.get("android"):
         spec["ext"] = "_android.so"
-    if spec.get("configure_host"):
+    if always_get_host_triple or spec.get("configure_host"):
         spec["configure_host"] = subprocess.check_output(
             shlex.split(spec["cc"]) + ["-dumpmachine"], universal_newlines=True).strip()
     TARGETS[requested] = spec
@@ -737,11 +737,13 @@
     ap = argparse.ArgumentParser()
     ap.add_argument("--target", choices=["auto"] + list(TARGETS), default="auto")
     ap.add_argument("--platform", default=os.environ.get("platform", "unix"))
+    ap.add_argument("--host", action="store_true",
+                    help="pass the selected compiler's target triplet to dependency configure scripts")
     ap.add_argument("--glue-only", action="store_true")
     args = ap.parse_args()
     epoch = load_pin()["source_date_epoch"]
     os.environ.setdefault("SOURCE_DATE_EPOCH", str(epoch))
-    args.target, spec = configure_target(args.target, args.platform)
+    args.target, spec = configure_target(args.target, args.platform, args.host)
     outdir = BUILD_ROOT / "dist" / args.target
     outdir.mkdir(parents=True, exist_ok=True)
     import release
-- 
