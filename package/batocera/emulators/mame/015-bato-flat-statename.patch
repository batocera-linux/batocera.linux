@@ -618,6 +618,20 @@
 
 
 //-------------------------------------------------
+//  state_file_prefix - a plain statename keeps
+//  states flat as <statename>.<slot>.sta
+//-------------------------------------------------
+
+std::string running_machine::state_file_prefix() const
+{
+	std::string_view const stateopt(options().state_name());
+	if (stateopt.empty() || stateopt.find_first_of("%/\\") != std::string_view::npos)
+		return std::string();
+	return get_statename(options().state_name()) + '.';
+}
+
+
+//-------------------------------------------------
 //  compose_saveload_filename - composes a filename
 //  for state loading/saving
 //-------------------------------------------------
@@ -641,9 +655,17 @@
 			*searchpath = options().state_directory();
 
 		// take into account the statename option
-		const char *stateopt = options().state_name();
-		std::string statename = get_statename(stateopt);
-		result = string_format("%s%s%s.sta", statename, PATH_SEPARATOR, filename);
+		std::string const prefix = state_file_prefix();
+		if (!prefix.empty())
+		{
+			result = string_format("%s%s.sta", prefix, filename);
+		}
+		else
+		{
+			const char *stateopt = options().state_name();
+			std::string statename = get_statename(stateopt);
+			result = string_format("%s%s%s.sta", statename, PATH_SEPARATOR, filename);
+		}
 	}
 	return result;
 }
