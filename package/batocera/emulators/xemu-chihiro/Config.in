config BR2_PACKAGE_XEMU_CHIHIRO
    bool "xemu-chihiro"
    depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8
    select BR2_PACKAGE_PYTHON3
    select BR2_PACKAGE_BZIP2
    select BR2_PACKAGE_PIXMAN
    select BR2_PACKAGE_ZLIB
    select BR2_PACKAGE_SDL3
    select BR2_PACKAGE_LIBSAMPLERATE
    select BR2_PACKAGE_SLIRP
    select BR2_PACKAGE_LIBGBM
    select BR2_PACKAGE_LIBOPENSSL
    select BR2_PACKAGE_LIBCAP
    select BR2_PACKAGE_GMP
    select BR2_PACKAGE_LIBGTK3
    select BR2_PACKAGE_XLIB_LIBX11
    select BR2_PACKAGE_KEYUTILS
    select BR2_PACKAGE_BATOCERA_LAUNCH_XEMU_CHIHIRO if BR2_PACKAGE_BATOCERA_LAUNCH
    help
      Sega Chihiro emulator, a fork of xemu

      https://github.com/Tovarichtch/xemu
