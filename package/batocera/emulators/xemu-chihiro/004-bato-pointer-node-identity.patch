+/* A "node:" selection also names a device by its event node, whatever
+ * identity it was given, so twins can be told apart before the scan. */
+static bool pointer_is(const Pointer *p, const char *identity)
+{
+    return strcmp(p->info.identity, identity) == 0 ||
+           (p->fd >= 0 && strncmp(identity, "node:", 5) == 0 &&
+            strcmp(p->node, identity + 5) == 0);
+}
+
 static Pointer *find_identity(const char *identity)
 {
     for (int i = 0; i < npointers; i++) {
-        if (strcmp(pointers[i].info.identity, identity) == 0) {
+        if (pointer_is(&pointers[i], identity)) {
             return &pointers[i];
         }
     }
