 src/emu/dispatch/src/audio.cpp                |  77 +++-
 src/emu/drivers/CMakeLists.txt                |   2 +
 .../drivers/include/drivers/audio/ringtone.h  |  45 +++
 src/emu/drivers/src/audio/ringtone.cpp        | 373 ++++++++++++++++++
 src/tests/epoc/CMakeLists.txt                 |   1 +
 src/tests/epoc/drivers/ringtone.cpp           | 164 ++++++++
 7 files changed, 664 insertions(+), 1 deletion(-)
 create mode 100755 src/emu/drivers/include/drivers/audio/ringtone.h
