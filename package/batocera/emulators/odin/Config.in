config BR2_PACKAGE_ODIN
    bool "odin"
    depends on BR2_INSTALL_LIBSTDCPP
    depends on (BR2_x86_64 && BR2_PACKAGE_HAS_LIBGL) || \
        (BR2_aarch64 && BR2_PACKAGE_HAS_LIBGLES)
    select BR2_PACKAGE_SDL3
    select BR2_PACKAGE_LIBGLEW if BR2_x86_64
    select BR2_PACKAGE_JANSSON
    select BR2_PACKAGE_XLIB_LIBX11
    select BR2_PACKAGE_VULKAN_HEADERS
    help
      A low-level emulator of the SEGA Hikaru and Gaelco ATV Track
      arcade boards, drawing with OpenGL (ES on aarch64) or Vulkan.

      https://github.com/Tovarichtch/Odin

comment "odin needs a toolchain w/ C++ and OpenGL (ES on aarch64)"
    depends on BR2_aarch64 || BR2_x86_64
    depends on !BR2_INSTALL_LIBSTDCPP || \
        (BR2_x86_64 && !BR2_PACKAGE_HAS_LIBGL) || \
        (BR2_aarch64 && !BR2_PACKAGE_HAS_LIBGLES)
