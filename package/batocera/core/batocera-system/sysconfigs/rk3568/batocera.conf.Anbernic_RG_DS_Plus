# --- Anbernic RG-DS Plus default values ---

# Preferred output
global.videooutput=DSI-2
global.videooutput2=DSI-1

# Splash video on the bottom panel, the logo stays on the top
splash.screen.output=DSI-1

display.position=top-bottom

# Touchscreen on the bottom panel
display.touchscreen.DSI-1=Goodix Capacitive TouchScreen
display.touchrotate.DSI-1=0

# default suspend on handled boards
system.suspendmode=suspend
