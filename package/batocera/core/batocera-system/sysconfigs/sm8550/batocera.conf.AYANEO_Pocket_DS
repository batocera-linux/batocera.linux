# AYANEO Pocket DS default values

global.videooutput=DSI-1
global.videooutput2=DSI-2
display.position=top-bottom

# Splash video on the bottom panel, the logo stays on the top
splash.screen.output=DSI-2

display.handheld.DSI-1=1
display.handheld.DSI-2=1

# Rotate DRM for splash
display.rotate.DSI=3

display.rotate.DSI-1=3
display.rotate.DSI-2=3

display.touchscreen.DSI-1=generic ft5x06 (44)
display.touchscreen.DSI-2=Goodix Capacitive TouchScreen

# default suspend on handled boards
system.suspendmode=suspend
