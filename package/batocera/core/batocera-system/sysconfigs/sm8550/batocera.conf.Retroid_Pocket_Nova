# Retroid Pocket Nova default values

# The add-on top screen is primary when attached
global.videooutput=DP-1
global.videooutput2=DSI-1
display.position=top-bottom

# Add-on top screen, matched by its EDID model so a TV on DP-1 is left alone
display.rotate.Lontium=1
display.touchscreen.Lontium=RetroidPocket RDS Touchscreen
display.touchscreen.DSI-1=generic ft5x06 (8d)

# default suspend on handled boards
system.suspendmode=suspend
