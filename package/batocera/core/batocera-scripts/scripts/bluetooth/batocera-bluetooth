#!/bin/sh

ACTION=$1

do_help() {
    echo "$1 list" >&2
    echo "$1 trust <device address>" >&2
    echo "$1 trust input" >&2
    echo "$1 remove <device address>" >&2
    echo "$1 save" >&2
    echo "$1 restore" >&2
    echo "$1 start_live_devices" >&2
    echo "$1 stop_live_devices" >&2
    echo "$1 enable" >&2
    echo "$1 disable" >&2
    echo "$1 connect <device address>" >&2
    echo "$1 disconnect <device address>" >&2
}

get_bt_name() {
    local addr="$1"
    find /var/lib/bluetooth -type f -path "*/$addr/info" -print -quit 2>/dev/null \
    | xargs -r sed -n 's/^Name=//p'
}

is_device_trusted() {
  addr="$1"
  [ -z "$addr" ] && return 1

  info="$(find /var/lib/bluetooth -type f -path "*/$addr/info" -print -quit 2>/dev/null)"
  [ -z "$info" ] && return 1

  grep -q '^Trusted=true$' "$info"
}

get_bt_agent_pid() {
  NPID="$(cat /var/run/bluetooth-agent.pid 2>/dev/null)"
  [ -z "$NPID" ] && return 1
  kill -0 "$NPID" 2>/dev/null || return 1
  echo "$NPID"
}

stop_bt_agent() {
  NPID="$(get_bt_agent_pid)"
  [ -n "$NPID" ] && kill -USR2 "$NPID" 2>/dev/null
  rm -f /var/run/bt_device /var/run/bt_listing
}

BCKDIR=/userdata/system/bluetooth
BCK="$BCKDIR/bluetooth.tar"

BT_LOCK=/var/run/bt_discovery.lock

take_bt_lock() {
  while ! mkdir "$BT_LOCK" 2>/dev/null; do
      OPID="$(cat "$BT_LOCK/pid" 2>/dev/null)"
      if [ -z "$OPID" ] || ! kill -0 "$OPID" 2>/dev/null; then
          rm -rf "$BT_LOCK"
          continue
      fi
      return 1
  done
  echo $$ > "$BT_LOCK/pid"
  return 0
}

release_bt_lock() {
  OPID="$(cat "$BT_LOCK/pid" 2>/dev/null)"
  [ "$OPID" = "$$" ] && rm -rf "$BT_LOCK"
  return 0
}

notify_ui() {
    curl -s -m 2 http://localhost:1234/notify -d "$1" >/dev/null 2>&1
    return 0
}

bt_result_is() {
    grep -qixF "$1 $2" /var/run/bt_result 2>/dev/null
}

normalize_addr() {
    echo "$1" | tr 'a-f' 'A-F'
}

is_valid_addr() {
    echo "$1" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'
}

do_save() {
    mkdir -p "$BCKDIR" || return 1

    (cd /var/lib && tar cf "$BCK.tmp" bluetooth) || { rm -f "$BCK.tmp" ; return 1 ; }
    mv -f "$BCK.tmp" "$BCK"
}

do_restore() {
    [ -f "$BCK" ] || return 0

    if ! tar tf "$BCK" >/dev/null 2>&1; then
        echo "ignoring the corrupted bluetooth backup $BCK" >&2
        return 1
    fi

    (cd /var/lib && tar xf "$BCK")
}

class2type() {
    CLASS="$1"

    echo "$CLASS" | grep -qE '^0x[0-9A-Fa-f]{1,6}$' || { echo "unknown" ; return 0 ; }

    MAJOR=$(( ( CLASS >> 8 ) & 0x1F ))
    MINOR=$(( ( CLASS >> 2 ) & 0x3F ))

    case "$MAJOR" in
        4)
            echo "audio" ; return 0 ;;
        5)
            case $(( MINOR >> 4 )) in
                1|3) echo "keyboard" ; return 0 ;;
                2)   echo "mouse"    ; return 0 ;;
            esac
            case $(( MINOR & 0x0F )) in
                1|2) echo "joystick" ; return 0 ;;
            esac
            ;;
    esac

    echo "unknown"
}

do_list() {
    CONNECTED_LIST="$(bluetoothctl devices Connected 2>/dev/null | sed -n 's/^Device \([0-9A-Fa-f:]\{17\}\).*/\1/p' | tr 'a-f' 'A-F')"

    find /var/lib/bluetooth/ -type f -name info |
    while IFS= read -r FILE; do
        grep -qE '^Trusted=true$' "$FILE" \
            || grep -qE '^\[(LinkKey|LongTermKey|SlaveLongTermKey|PeripheralLongTermKey)\]$' "$FILE" \
            || continue

        DEVADDR="$(basename "$(dirname "$FILE")")"
        DEVNAME="$(sed -n 's/^Name=//p' "$FILE" | head -n 1)"
        DEVCLASS="$(sed -n 's/^Class=//p' "$FILE" | head -n 1)"

        [ -z "$DEVNAME" ] && DEVNAME="$DEVADDR"

        DEVTYPE="$(class2type "$DEVCLASS")"

        if printf '%s\n' "$CONNECTED_LIST" | grep -Fxq "$(echo "$DEVADDR" | tr 'a-f' 'A-F')"; then
            CONNECTED="yes"
        else
            CONNECTED="no"
        fi

        printf '<device id="%s" name="%s" type="%s" connected="%s"/>\n' \
               "$DEVADDR" "$DEVNAME" "$DEVTYPE" "$CONNECTED"
    done
}

do_remove() {
    DEV="$(normalize_addr "$1")"

    if ! is_valid_addr "$DEV"; then
        echo "Invalid device address format. Please use the format XX:XX:XX:XX:XX:XX" >&2
        return 1
    fi

    # output is never nice
    (echo "disconnect $DEV" ; echo "untrust $DEV" ; echo "remove $DEV") | bluetoothctl >/dev/null 2>/dev/null
    find /var/lib/bluetooth -type d -name "$DEV" -prune -exec rm -rf {} + 2>/dev/null

    do_save # save
    return 0
}

do_devlist() {
    NPID="$(get_bt_agent_pid)"
    if [ -z "$NPID" ]; then
        echo "The bluetooth agent is not running" >&2
        return 1
    fi

    take_bt_lock || { echo "A bluetooth scan is already running" >&2 ; return 1 ; }

    # clean any remining previous info
    : > /var/run/bt_device || { release_bt_lock ; return 1 ; }

    # tell listing mode
    : > /var/run/bt_listing || { release_bt_lock ; return 1 ; }

    trap 'stop_bt_agent ; release_bt_lock' INT QUIT TERM

    tail -n +1 -f /var/run/bt_listing &
    echo $! > "/var/run/bt_listing.pid"

    kill -USR1 "$NPID" 2>/dev/null

    wait
    release_bt_lock
}

do_stopdevlist() {
    KPID="$(cat /var/run/bt_listing.pid 2>/dev/null)"
    [ -n "$KPID" ] && kill -15 "$KPID" 2>/dev/null
    rm -f /var/run/bt_listing.pid

    stop_bt_agent
}

do_trust() {
    if [ "$1" != "input" ]; then
        do_trust_device "$1"
        return $?
    fi

    take_bt_lock || { echo "A bluetooth scan is already running" >&2 ; return 1 ; }
    do_trust_device "$1"
    TRUSTRET=$?
    release_bt_lock
    return $TRUSTRET
}

do_trust_device() {
    TRUSTDEV="$1"

    NPID="$(get_bt_agent_pid)"
    if [ -z "$NPID" ]; then
        echo "The bluetooth agent is not running" >&2
        notify_ui "Bluetooth is not started"
        return 1
    fi

    if [ "$TRUSTDEV" != "input" ]; then
        TRUSTDEV="$(normalize_addr "$TRUSTDEV")"
        if ! is_valid_addr "$TRUSTDEV"; then
            echo "Invalid device address format. Please use the format XX:XX:XX:XX:XX:XX" >&2
            return 1
        fi
    fi

    # Snapshot trusted devices at start (used for both explicit MAC + input mode)
    BASE_TRUSTED="$(
      find /var/lib/bluetooth/ -type f -name info \
        -exec grep -l '^Trusted=true$' {} + 2>/dev/null \
      | xargs -r -n1 dirname | xargs -r -n1 basename | sort -u
    )"

    SEEN_CONNECTED=""
    if [ "$TRUSTDEV" = "input" ]; then
        SEEN_CONNECTED="$(bluetoothctl devices Connected 2>/dev/null | sed -n 's/^Device \([0-9A-Fa-f:]\{17\}\).*/\1/p' | tr 'a-f' 'A-F' | sort -u)"
    fi

    touch /var/run/bt_status || return 1
    LAST_MSG="$(cat /var/run/bt_status 2>/dev/null)"

    : > /var/run/bt_result || return 1

    rm -f /var/run/bt_cancel

    echo "$TRUSTDEV" > /var/run/bt_device || return 1

    # cleanup
    trap 'stop_bt_agent ; release_bt_lock' INT QUIT TERM

    if [ "$TRUSTDEV" = "input" ]; then
        rm -f /var/run/bt_listing
    fi

    kill -USR1 "$NPID" 2>/dev/null

    GRACE_TICKS=20
    GRACE_LEFT=0
    CHANGED=0
    N=120
    while [ $N -gt 0 ]; do
        STATUS_CHANGED=0
        NEW_MSG="$(cat /var/run/bt_status 2>/dev/null)"
        if [ "$LAST_MSG" != "$NEW_MSG" ]; then
            LAST_MSG="$NEW_MSG"
            STATUS_CHANGED=1
            echo "$NEW_MSG"
            if [ "$TRUSTDEV" != "input" ] && [ -n "$NEW_MSG" ]; then
                notify_ui "$NEW_MSG"
            fi
        fi

        # Early cancel
        if [ -e /var/run/bt_cancel ]; then
            rm -f /var/run/bt_cancel
            stop_bt_agent
            echo "Pairing canceled"
            sleep 1.5 # for toast notification
            return 0
        fi

        # Success: explicit device(manual pairing)
        if [ "$TRUSTDEV" != "input" ]; then
            if bt_result_is "connected" "$TRUSTDEV"; then
                stop_bt_agent
                DEVNAME="$(get_bt_name "$TRUSTDEV")"
                [ -z "$DEVNAME" ] && DEVNAME="$TRUSTDEV"

                if printf '%s\n' "$BASE_TRUSTED" | tr 'a-f' 'A-F' | grep -Fxq "$TRUSTDEV"; then
                    notify_ui "Already paired: $DEVNAME"
                else
                    do_save
                    notify_ui "Paired: $DEVNAME"
                fi

                return 0
            fi

            if bt_result_is "failed" "$TRUSTDEV"; then
                stop_bt_agent
                DEVNAME="$(get_bt_name "$TRUSTDEV")"
                [ -z "$DEVNAME" ] && DEVNAME="$TRUSTDEV"

                if is_device_trusted "$TRUSTDEV"; then
                    do_save
                    echo "Paired, but not connected"
                    notify_ui "Paired, but not connected: $DEVNAME"
                else
                    echo "Pairing failed"
                    notify_ui "Pairing failed: $DEVNAME"
                fi

                sleep 1.5 # for toast notification
                return 1
            fi
        fi

        # Success: first new device (auto pairing controllers)
        if [ "$TRUSTDEV" = "input" ]; then
            if [ $STATUS_CHANGED -eq 1 ] && [ $GRACE_LEFT -gt 0 ]; then
                GRACE_LEFT=$GRACE_TICKS
            fi

            NEW_DEVICE=0
            for addr in $(sed -n 's/^connected //p' /var/run/bt_result 2>/dev/null | sort -u); do
                printf '%s\n' "$SEEN_CONNECTED" | grep -Fxq "$addr" && continue

                # Each newly paired controller extends the grace window
                CHANGED=1
                NEW_DEVICE=1
                GRACE_LEFT=$GRACE_TICKS

                # Mark it seen
                SEEN_CONNECTED="$(printf '%s\n%s' "$SEEN_CONNECTED" "$addr")"
            done

            # Countdown grace window for additional controllers
            if [ $GRACE_LEFT -gt 0 ] && [ $NEW_DEVICE -eq 0 ]; then
                GRACE_LEFT=$((GRACE_LEFT - 1))
                if [ $GRACE_LEFT -le 0 ]; then
                    stop_bt_agent
                    do_save
                    return 0
                fi
            fi
        fi

        sleep 0.5
        N=$((N-1))
    done

    # Timeout cleanup
    stop_bt_agent

    if [ "$TRUSTDEV" != "input" ]; then
        DEVNAME="$(get_bt_name "$TRUSTDEV")"
        [ -z "$DEVNAME" ] && DEVNAME="$TRUSTDEV"
        echo "Pairing timed out"
        notify_ui "Pairing timed out: $DEVNAME"
        sleep 1.5 # for toast notification
        return 1
    fi

    if [ "$CHANGED" -eq 0 ]; then
        echo "Pairing timed out"
        sleep 1.5 # for toast notification
        return 1
    fi

    return 0
}

do_sixad() {
  [ -x /etc/init.d/S31sixad ] && /etc/init.d/S31sixad "$1"
  return 0
}

do_enable() {
  /etc/init.d/S32bluetooth stop
  do_sixad stop
  /usr/bin/batocera-settings-set controllers.bluetooth.enabled 1
  do_sixad start
  /etc/init.d/S32bluetooth start
}

do_disable() {
  /usr/bin/batocera-settings-set controllers.bluetooth.enabled 0

  # set cancel flag for pairing early exit
  touch /var/run/bt_cancel

  do_stopdevlist

  /etc/init.d/S32bluetooth stop
  do_sixad stop
}

do_connect() {
    DEV="$(normalize_addr "$1")"
    if ! is_valid_addr "$DEV"; then
        echo "Invalid device address format. Please use the format XX:XX:XX:XX:XX:XX" >&2
        return 1
    fi

    if bluetoothctl -- info "$DEV" | grep -q "Connected: yes"; then
        echo "Device $DEV is already connected." >&2
        return 0
    fi

    echo "Attempting to connect to device $DEV..."
    if bluetoothctl -- connect "$DEV"; then
        echo "Successfully connected to device $DEV"
        return 0
    else
        echo "Failed to connect to device $DEV" >&2
        return 1
    fi
}

do_disconnect() {
    DEV="$(normalize_addr "$1")"
    if ! is_valid_addr "$DEV"; then
        echo "Invalid device address format. Please use the format XX:XX:XX:XX:XX:XX" >&2
        return 1
    fi

    if ! bluetoothctl -- info "$DEV" | grep -q "Connected: yes"; then
        echo "Device ${DEV} is not connected." >&2
        return 1
    fi

    if bluetoothctl -- disconnect "$DEV"; then
        echo "Successfully disconnected device $DEV"
        return 0
    else
        echo "Failed to disconnect device $DEV" >&2
        return 1
    fi
}

case "$ACTION" in
    "list")
        do_list
        ;;
    "trust")
        if [ "$#" -eq 2 ]; then
            do_trust "$2" || exit 1
        else
            do_help "$0"
            exit 1
        fi
        ;;
    "remove")
        if [ "$#" -eq 2 ]; then
            do_remove "$2" || exit 1
        else
            do_help "$0"
            exit 1
        fi
        ;;
    "save")
        do_save || exit 1
        ;;
    "restore")
        do_restore || exit 1
        ;;
    "start_live_devices"|"live_devices")
        do_devlist || exit 1
        ;;
    "stop_live_devices")
        do_stopdevlist
        ;;
    "enable")
        do_enable
        ;;
    "disable")
        do_disable
        ;;
    "connect")
        if [ "$#" -eq 2 ]; then
            do_connect "$2" || exit 1
        else
            do_help "$0"
            exit 1
        fi
        ;;
    "disconnect")
        if [ "$#" -eq 2 ]; then
            do_disconnect "$2" || exit 1
        else
            do_help "$0"
            exit 1
        fi
        ;;
    *)
        do_help "$0"
        exit 1
esac

exit 0
