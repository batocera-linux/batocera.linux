#!/bin/sh

export LC_ALL=C

updateurl="https://updates.batocera.org"

# customizable upgrade url website
settingsupdateurl="$(/usr/bin/batocera-settings-get updates.url)"
test -n "${settingsupdateurl}" && updateurl="${settingsupdateurl}"

IMGFOLDER="/userdata/system/installs"

do_help() {
	echo "$0 listDisks" >&2
	echo "$0 listArchs" >&2
	echo "$0 listFiles" >&2
	echo "$0 checkDisk <disk>" >&2
	echo "$0 checkPower" >&2
	echo "$0 install <disk> <arch|file>" >&2
	echo "$0 install <disk> internal --android-size <GB> --copy-data <all|bios|none>" >&2
}

if [ $# -eq 0 ]; then
	do_help
	exit 1
fi

ACTION=$1
shift

determine_part_prefix() {
    # /dev/mmcblk0p3 => /dev/mmcblk0
    # /dev/sda1      => /dev/sda

    # sometimes, it's pX, sometimes just an X : http://www.tldp.org/HOWTO/Partition-Mass-Storage-Definitions-Naming-HOWTO/x160.html
    if echo "${1}" | grep -qE 'p[0-9]$'
    then
	echo "$1" | sed -e s+'p[0-9]$'+''+
	return 0
    fi
    echo "$1" | sed -e s+'[0-9]$'++
}

disks_to_keep() {
    grep -E '^[^ ]* /boot |^[^ ]* /userdata' /proc/mounts | sed -e s+"^\([^ ]*\) .*$"+'\1'+ |
	while read X
	do
	    determine_part_prefix "${X}"
	done |
	sed -e s+'^/dev/'++ |
	sort -u
}

# the internal disk of an Android device that batocera-install-internal can resize
internal_disk() {
    command -v batocera-install-internal >/dev/null || return 0
    batocera-install-internal disk 2>/dev/null | grep '^/dev/' | sed -e s+'^/dev/'++
}

do_listDisks() {
    KEEP=$(disks_to_keep)
    INTERNAL=$(internal_disk)
    # the other Qualcomm UFS LUNs and eMMC hold the bootloaders, only USB disks are safe to overwrite
    QCOM=0
    grep -qs '^PARTNAME=abl_a$' /sys/class/block/*/uevent && QCOM=1

    lsblk -n -P -o TYPE,NAME,SIZE,MODEL |
	grep -E '^TYPE="disk" ' |
	sed -e s+' [ ]*"$'+'"'+ | # remove trailing spaces
	sed -e s+'^TYPE="[^"]*" NAME=\"\([^"]*\)\" SIZE=\"\([^"]*\)\" MODEL=\"\([^"]*\)\"$'+'\1 \3 (\2)'+ |
	while read XDRIVE XTEXT
	do
	    echo "${KEEP}" | grep -qx "${XDRIVE}" && continue
	    if test "${QCOM}" = 1 && test "$(lsblk -d -n -o TRAN "/dev/${XDRIVE}")" != "usb" && test "${XDRIVE}" != "${INTERNAL}"
	    then
		continue
	    fi
	    echo "${XDRIVE} ${XTEXT}"
	done
}

do_checkDisk() {
    CDISK=${1#/dev/}
    if test -n "${CDISK}" && test "${CDISK}" = "$(internal_disk)"
    then
	echo "TYPE=android_internal"
	batocera-install-internal check
	return $?
    fi
    echo "TYPE=standard"
}

do_listArchs() {
	wget -qO - "${updateurl}/installs.txt" | sed -e s+'^\([^/]*\)/.*$'+'\1'+ | sort -u
}

do_listFiles() {
    if test -d "${IMGFOLDER}"
    then
	find "${IMGFOLDER}" -name "*.img.gz" -type f
    fi
}

getPer() {
    TARVAL=$1
    TARFILE=$2

    while true
    do
	CURVAL=$(stat "${TARFILE}" | grep -E '^\s*Size:' | sed -e s+'^\s*Size: \([0-9][0-9]*\)\s.*$'+'\1'+)
	CURVAL=$((CURVAL / 1024 / 1024))
	PER=$(expr ${CURVAL} '*' 100 / ${TARVAL})
	echo "downloading >>> ${PER}%"
	sleep 5
    done
}

do_unmount_disk() {
    UDSK=$1

    grep "/dev/${UDSK}" /proc/mounts | cut -d ' ' -f 2 |
	while read X
	do
	    umount "${X}"
	done

    grep -qE "^/dev/${UDSK}" /proc/mounts && return 1
    return 0
}

do_install() {
    INSDISK=$1
    INSIMG=
    INSARCH=

    if test -f "${2}"
    then
	INSIMG=$2
    else
	INSARCH=$2
    fi

    if ! test -e "/dev/${INSDISK}"
    then
	echo "invalid disk ${INSDISK}" >&2
	return 1
    fi

    if test "${INSDISK}" = "$(internal_disk)"
    then
	echo "${INSDISK} holds Android, install to it with the internal option" >&2
	return 1
    fi

    if ! do_listDisks | cut -d ' ' -f 1 | grep -qx "${INSDISK}"
    then
	echo "${INSDISK} is not an install target" >&2
	return 1
    fi

    # unmount mounts associated with the disk
    if ! do_unmount_disk "${INSDISK}"
    then
	echo "unable to free the disk ${INSDISK}" >&2
	return 1
    fi

    ### DOWNLOADING
    if test -n "${INSARCH}"
    then
	# download directory
	mkdir -p "${IMGFOLDER}/${INSARCH}" || return 1

	# url
	RELATIVPATH=$(wget -qO - "${updateurl}/installs.txt" | grep -E "^${INSARCH}/" | head -1)
	FILEBASENAME=$(basename "${RELATIVPATH}")
	INSIMG="${IMGFOLDER}/${INSARCH}/${FILEBASENAME}"
	test -z "${RELATIVPATH}" && return 1
	url="${updateurl}/${RELATIVPATH}"

	# get size to download
	echo "url: ${url}"
	headers=$(curl -A "batocera-install.header" -sfIL ${url})
	test $? -eq 0 || return 1
	bytessize=$(echo "$headers" | grep -i "Content-Length: " | tail -1 | sed -e s+'^Content-Length: \([0-9]*\).*$'+'\1'+I) # take the last one in case of redirection
	size=$((bytessize / 1024 / 1024))
	test $? -eq 0 || return 1

	FILETHERE=0
	if test -f "${INSIMG}"
	then
	    CURVAL=$(stat "${INSIMG}" | grep -E '^\s*Size:' | sed -e s+'^\s*Size: \([0-9][0-9]*\)\s.*$'+'\1'+)
	    if test "${CURVAL}" = "${bytessize}"
	    then
		FILETHERE=1
	    fi
	fi
    
	# if the file is already there, skip the download
	if test "${FILETHERE}" = 1
	then
	    echo "file already downloaded at ${INSIMG}."
	    echo "skip the download."
	else
	    echo "need to download ${size}mB"

	    # check free space on fs
	    for fs in /userdata
	    do
		freespace=$(df -m "${fs}" | tail -1 | awk '{print $4}')
		test $? -eq 0 || return 1
		if test "${size}" -gt "${freespace}"
		then
		    echo "Not enough space on ${fs} to download the update"
		    return 1
		fi
	    done

	    # download
	    touch "${INSIMG}"
	    getPer "${size}" "${INSIMG}" &
	    GETPERPID=$!

	    if ! curl -A "batocera-install" -sfL "${url}" -o "${INSIMG}"
	    then
		echo "Downloading failed" >&2
		kill -9 "${GETPERPID}"
		return 1
	    fi
	    kill -9 "${GETPERPID}"
	    wait "${GETPERPID}" 2>/dev/null # hide the Killed message
	    GETPERPID=
	fi
    fi

    # install
    echo "zcat \"${INSIMG}\" | dd of=\"/dev/${INSDISK}\" bs=40M"
    echo "writing to disk ${INSDISK}, please wait..."
    if ! zcat "${INSIMG}" | dd of="/dev/${INSDISK}" bs=40M
    then
	return 1
    fi
    echo "synchronizing..."
    sync
    echo "done"
    return 0
}

do_clean() {
    test -n "${GETPERPID}" && kill -9 "${GETPERPID}"
}
trap do_clean EXIT

case "${ACTION}" in
    listDisks)
	do_listDisks
	;;
    listArchs)
	do_listArchs
	;;
    listFiles)
	do_listFiles
	;;
    checkDisk)
	if test $# -ne 1
	then
	    do_help
	    exit 1
	fi
	do_checkDisk "${1}" || exit 1
	;;
    checkPower)
	command -v batocera-install-internal >/dev/null || exit 1
	batocera-install-internal power
	;;
    install)
	if test "${2}" = "internal"
	then
	    if test "${1#/dev/}" != "$(internal_disk)"
	    then
		echo "${1} is not the internal Android disk" >&2
		exit 1
	    fi
	    shift 2
	    exec batocera-install-internal install "$@"
	fi
	if test $# -ne 2
	then
	    do_help
	    exit 1
	fi
	if ! do_install "${1}" "${2}"
	then
	    exit 1
	fi
	;;
	*)
		do_help
		>&2 echo "error: invalid command ${ACTION}"
		exit 1
esac
exit 0
