# Saves or loads a save state of the running game, by the slot ES lists it under: through the
# launcher's save state manager when it handles the emulator, then RetroArch's command pipe,
# otherwise ES starts the game again from the state. Slot -1 is the quick slot, listed as the
# autosave; a save without a slot makes a new state.
# Usage: batocera-savestate save [-1]
#        batocera-savestate load [<slot>]

# batocera-launch gives RetroArch this pipe as stdin
RETROARCH_COMMANDS=/var/run/retroarch-commands

ACTION="$1"
SLOT="$2"
case "${ACTION}" in
    save) [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "${SLOT}" = -1 ]; } ;;
    load) [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "${SLOT}" -eq "${SLOT}" ] 2>/dev/null; } ;;
    *) false ;;
esac || {
    echo "usage: $0 save [-1] | load [<slot>]" >&2
    exit 1
}

# 0 done, 1 no launcher, 2 no state handling, 3 only a restart loads it
batocera-launch-savestate "$@"
CODE=$?
[ "${CODE}" -eq 0 ] && exit 0

has_action() {
    hotkeygen --list | sed "/^#/q" | grep -q "^  $1-"
}

# save_state and restore_state run this script, so without the launcher only the manager's raw keys are left
send_first() {
    for action in "$@"; do
        has_action "${action}" && exec hotkeygen --send "${action}"
    done
    exit 1
}

if [ "${ACTION}" = save ]; then
    [ "${CODE}" -eq 2 ] && exec hotkeygen --send save_state
    [ "${CODE}" -eq 1 ] || exit 1
    [ "${SLOT}" = -1 ] && send_first savestate_quick_save savestate_save
    send_first savestate_save savestate_quick_save
fi

if [ "${CODE}" -eq 1 ]; then
    case "${SLOT}" in
        -1) send_first savestate_quick_load ;;
        '') send_first savestate_restore savestate_quick_load ;;
    esac
fi
[ -n "${SLOT}" ] || exit 1

# RetroArch, which takes commands on stdin; the pipe goes when it quits, the timeout covers a crash
if [ -p "${RETROARCH_COMMANDS}" ]; then
    timeout 2 sh -c "echo 'LOAD_STATE_SLOT ${SLOT}' >'${RETROARCH_COMMANDS}'" && exit 0
fi

exec curl -sf -X POST -d "${SLOT}" http://127.0.0.1:1234/runningGame/savestates/load
