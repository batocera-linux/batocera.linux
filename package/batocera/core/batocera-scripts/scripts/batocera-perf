#

# Shows and changes the power settings for the control center
# Usage: batocera-perf status|ingame|has battery|tdp|profile|fan|get <setting>|show <setting>|set <setting> <value>|save game|system
# outside a game: acmode, batterymode, tdp, profile and fan are the global settings
# in a game: mode, tdp, profile and fan change now and last until the game ends, unless saved
# <setting>level is the setting as a slider step

CHANGES=/var/run/batocera-perf.changes
FAN_LEVELS="quiet balanced performance max"
MODE_LEVELS="powersaver conservative balanced highperformance"
# a fan daemon follows the profile in it while it runs
FAN_PROFILE=/var/run/batocera-fan.profile
CPUFREQ=/sys/devices/system/cpu/cpufreq/policy0

running_game() {
    curl -sf --max-time 1 http://127.0.0.1:1234/runningGame | jq -e 'select(.path != null)' 2>/dev/null
}

# dash's echo breaks the \n in descriptions
game() {
    printf '%s\n' "${GAME}" | jq -r "$1"
}

on_charger() {
    for d in /sys/class/power_supply/*; do
        case "$(cat "$d/type" 2>/dev/null)" in
            Mains|USB|Wireless) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && return 0 ;;
        esac
    done
    return 1
}

has_battery() {
    grep -qx Battery /sys/class/power_supply/*/type 2>/dev/null
}

has() {
    case "$1" in
        battery) has_battery ;;
        tdp)     [ -x /usr/bin/ryzenadj ] && [ -n "$(batocera-settings-get system.cpu.tdp)" ] ;;
        profile) [ -n "$(batocera-platform-profile list 2>/dev/null)" ] ;;
        fan)     [ -e "${FAN_PROFILE}" ] ;;
        *) return 1 ;;
    esac
}

apply_tdp() {
    has tdp && batocera-amd-tdp "$(watts "$1")" >/dev/null 2>&1
}

# a profile change resets the firmware's power limits, the TDP goes back on after it
apply_profile() {
    batocera-platform-profile set "$1"
    has tdp && apply_tdp "$(get tdp)"
}

watts() {
    awk -v max="$(batocera-settings-get system.cpu.tdp)" -v pct="$1" 'BEGIN { printf "%.0f", max * pct / 100 }'
}

# the game's settings, as batocera.conf keys, most specific first
game_keys() {
    SYSTEM=$(game .systemName)
    # the same name ES gives the game in batocera.conf
    ROM=$(basename "$(game .path)" | tr -d '=#')
    echo "${SYSTEM}[\"${ROM}\"].$1"
    echo "${SYSTEM}.$1"
}

game_setting() {
    game_keys "$1" | while IFS= read -r KEY; do
        VALUE=$(batocera-settings-get "${KEY}")
        [ -n "${VALUE}" ] && echo "${VALUE}" && break
    done
}

# the first of the commands that prints something
first() {
    for CMD in "$@"; do
        VALUE=$(eval "${CMD}")
        [ -n "${VALUE}" ] && echo "${VALUE}" && return
    done
}

# a change made in this game, dropped once another game starts
changed() {
    [ "$(sed -n 's/^game=//p' "${CHANGES}" 2>/dev/null)" = "$(game .path)" ] || return 1
    sed -n "s/^$1=//p" "${CHANGES}" | grep .
}

record() {
    PATH_NOW=$(game .path)
    [ "$(sed -n 's/^game=//p' "${CHANGES}" 2>/dev/null)" = "${PATH_NOW}" ] || echo "game=${PATH_NOW}" >"${CHANGES}"
    { sed "/^$1=/d" "${CHANGES}"; echo "$1=$2"; } >"${CHANGES}.new" && mv "${CHANGES}.new" "${CHANGES}"
}

# anything else inherits
is_mode() {
    case " ${MODE_LEVELS} " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

levels() {
    case "$1" in
        fan) echo ${FAN_LEVELS} ;;
        *mode) echo ${MODE_LEVELS} ;;
    esac
}

# an unset mode shows the one it runs
level() {
    case "$1" in
        acmode)      VALUE=$(batocera-power-mode get ac) ;;
        batterymode) VALUE=$(batocera-power-mode get battery) ;;
        mode)        VALUE=$(batocera-power-mode get) ;;
        *)           VALUE=$(get "$1") ;;
    esac
    [ "$1" = fan ] && VALUE=${VALUE:-balanced}
    levels "$1" | tr ' ' '\n' | grep -nx -- "${VALUE}" | cut -d: -f1 | awk '{ print $1 - 1 }' | grep . || echo 0
}

mode_label() {
    case "$1" in
        highperformance) echo "High Perf" ;;
        balanced)        echo "Balanced" ;;
        conservative)    echo "Conservative" ;;
        powersaver)      echo "Power Saver" ;;
    esac
}

get() {
    if [ -n "${GAME}" ]; then
        case "$1" in
            mode)    first "changed mode" "game_setting powermode" ;;
            tdp)     first "changed tdp" "game_setting tdp" "batocera-settings-get global.tdp" "echo 100" ;;
            profile) first "changed profile" "game_setting platformprofile" "batocera-platform-profile get" ;;
            fan)     first "changed fan" "game_setting fanprofile" "batocera-settings-get global.fanprofile" "echo balanced" ;;
        esac
    else
        case "$1" in
            acmode)      batocera-settings-get global.powermode ;;
            batterymode) batocera-settings-get global.batterymode ;;
            tdp)         first "batocera-settings-get global.tdp" "echo 100" ;;
            profile)     first "batocera-settings-get global.platformprofile" "batocera-platform-profile get" ;;
            fan)         first "batocera-settings-get global.fanprofile" "echo balanced" ;;
        esac
    fi
}

GAME=$(running_game)

case "$1" in
    status)
        TEMP=$(batocera-temp --cpu 2>/dev/null)
        MHZ=$(cat /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq 2>/dev/null | sort -n | tail -n1)
        OUT=""
        has_battery && { on_charger && OUT="On charger" || OUT="On battery"; }
        [ -n "${TEMP}" ] && OUT="${OUT:+${OUT} · }${TEMP}°C"
        [ -n "${MHZ}" ] && OUT="${OUT:+${OUT} · }$(awk -v k="${MHZ}" 'BEGIN { printf "%.1f GHz", k / 1000000 }')"
        STATE_W=$(cat /var/run/amd-tdp.state 2>/dev/null)
        has tdp && [ -n "${STATE_W}" ] && OUT="${OUT:+${OUT} · }${STATE_W} W"
        NOW=$(cat "${CPUFREQ}/scaling_governor" 2>/dev/null)
        [ -n "${NOW}" ] && OUT="${OUT:+${OUT} · }${NOW}"
        echo "${OUT}"
        ;;
    ingame)
        [ -n "${GAME}" ] && echo 1
        ;;
    has)
        has "$2" && echo 1
        ;;
    get)
        if [ -n "$(levels "${2%level}")" ] && [ "${2%level}" != "$2" ]; then
            level "${2%level}"
        else
            get "$2"
        fi
        ;;
    show)
        VALUE=$(get "$2")
        case "$2:${VALUE}" in
            acmode:*)      mode_label "$(batocera-power-mode get ac)" ;;
            batterymode:*) mode_label "$(batocera-power-mode get battery)" ;;
            mode:*)        mode_label "$(batocera-power-mode get)" ;;
            tdp:*)                 has tdp && echo "${VALUE}% · $(watts "${VALUE}") W" ;;
            fan:quiet)             echo "Quiet" ;;
            fan:performance)       echo "Performance" ;;
            fan:max)               echo "Max" ;;
            fan:*)                 echo "Balanced" ;;
            *) echo "${VALUE}" ;;
        esac
        ;;
    set)
        SETTING="${2%level}"
        if [ "${SETTING}" != "$2" ] && [ -n "$(levels "${SETTING}")" ]; then
            LEVEL="$3"
            # +n and -n move from the current step
            case "${LEVEL}" in
                [+-]*) LEVEL=$(($(level "${SETTING}") ${LEVEL})) ;;
            esac
            COUNT=$(levels "${SETTING}" | wc -w)
            LEVEL=$((LEVEL < 0 ? 0 : LEVEL >= COUNT ? COUNT - 1 : LEVEL))
            exec "$0" set "${SETTING}" "$(levels "${SETTING}" | cut -d' ' -f$((LEVEL + 1)))"
        fi
        VALUE="$3"
        # +n and -n move from the current value
        case "$2:${VALUE}" in
            tdp:[+-]*) VALUE=$(($(get tdp) ${VALUE})) ;;
        esac
        [ "$2" = tdp ] && VALUE=$((VALUE < 10 ? 10 : VALUE > 120 ? 120 : VALUE))
        case "$2" in
            *mode) is_mode "${VALUE}" || VALUE= ;;
            tdp|fan) [ "${VALUE}" = default ] && VALUE= ;;
        esac
        if [ -n "${GAME}" ]; then
            case "$2" in
                mode)
                    record mode "${VALUE:-auto}"
                    batocera-power-mode
                    exit 0
                    ;;
                tdp)     apply_tdp "${VALUE}" ;;
                profile) apply_profile "${VALUE}" ;;
                fan)     has fan && echo "${VALUE}" >"${FAN_PROFILE}" ;;
                *) exit 1 ;;
            esac
            record "$2" "${VALUE:-auto}"
        else
            case "$2" in
                acmode)
                    batocera-settings-set global.powermode "${VALUE}"
                    batocera-power-mode
                    ;;
                batterymode)
                    batocera-settings-set global.batterymode "${VALUE}"
                    batocera-power-mode
                    ;;
                tdp)
                    batocera-settings-set global.tdp "${VALUE}"
                    apply_tdp "${VALUE}"
                    ;;
                profile)
                    batocera-settings-set global.platformprofile "${VALUE}"
                    apply_profile "${VALUE}"
                    ;;
                fan)
                    batocera-settings-set global.fanprofile "${VALUE}"
                    has fan && echo "${VALUE}" >"${FAN_PROFILE}"
                    ;;
                *) exit 1 ;;
            esac
        fi
        ;;
    save)
        [ -n "${GAME}" ] || exit 1
        case "$2" in
            game)   KEYS=$(game_keys X | head -n1) ;;
            system) KEYS=$(game_keys X | tail -n1) ;;
            *) exit 1 ;;
        esac
        PREFIX="${KEYS%.X}"
        # a key starting with [ hides the lines after it
        case "${PREFIX}" in
            ""|\[*|*'[""]') exit 1 ;;
        esac
        MODE=$(get mode)
        is_mode "${MODE}" || MODE=
        batocera-settings-set "${PREFIX}.powermode" "${MODE}"
        has tdp && batocera-settings-set "${PREFIX}.tdp" "$(get tdp)"
        has profile && batocera-settings-set "${PREFIX}.platformprofile" "$(get profile)"
        has fan && batocera-settings-set "${PREFIX}.fanprofile" "$(get fan)"
        ;;
    *)
        echo "usage: $0 status|ingame|has battery|tdp|profile|fan|get <setting>|show <setting>|set <setting> <value>|save game|system" >&2
        exit 1
        ;;
esac
