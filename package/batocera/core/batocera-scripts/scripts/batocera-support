#!/bin/sh

GTMP="/tmp"
DHOME="/userdata/system"

# to be callable by any external tool
if test $# -eq 1
then
    REPORTNAME=$(basename "$1" | sed -e s+'^\([^.]*\)\..*$'+'\1'+)
    OUTPUTFILE=$1
else
    REPORTNAME="batocera-support-"$(date +%Y%m%d%H%M%S)
    OUTPUTFILE="/userdata/saves/${REPORTNAME}.tar.gz"
fi

TMPDIR="${GTMP}/${REPORTNAME}"

f_cp() {
    test -e "$1" && cp "$1" "$2"
}

d_cp() {
    test -d "$1" && cp -pr "$1" "$2"
}

# stdout to the file, stderr beside it (empty files are removed at the end)
capture() {
    OUT="$1"
    shift
    "$@" > "${OUT}" 2> "${OUT}.err"
}

rm -rf "${TMPDIR}"
if mkdir "${TMPDIR}" && mkdir "${TMPDIR}/system" \
                          "${TMPDIR}/boot" \
                          "${TMPDIR}/audio" \
                          "${TMPDIR}/bluetooth" \
                          "${TMPDIR}/display" \
                          "${TMPDIR}/network" \
                          "${TMPDIR}/hardware" \
                          "${TMPDIR}/configs" \
                          "${TMPDIR}/logs" \
                          "${TMPDIR}/joysticks"
then
    if ! cd "${TMPDIR}"
    then
	echo "Change directory failed" >&2
	exit 1
    fi
else
    echo "Reporting directory creation failed" >&2
    exit 1
fi

# Define path shortcuts
DSYSTEM="${TMPDIR}/system"
DBOOT="${TMPDIR}/boot"
DAUDIO="${TMPDIR}/audio"
DBLUETOOTH="${TMPDIR}/bluetooth"
DDISPLAY="${TMPDIR}/display"
DNETWORK="${TMPDIR}/network"
DHARDWARE="${TMPDIR}/hardware"
DCONFIGS="${TMPDIR}/configs"
DLOGS="${TMPDIR}/logs"
DJOYS="${TMPDIR}/joysticks"

# the session environment is missing when run from ssh
if test -z "${DISPLAY}"; then
    export DISPLAY=$(getLocalXDisplay 2>/dev/null)
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run}"
if test -z "${WAYLAND_DISPLAY}" && test -S "${XDG_RUNTIME_DIR}/wayland-0"; then
    export WAYLAND_DISPLAY=wayland-0
fi

# -----------------------------------------------------------------------------
# SYSTEM / GENERAL (Processes, Version, Kernel)
# -----------------------------------------------------------------------------
dmesg 	         	    > "${DSYSTEM}/dmesg.txt"
ps -ef 	         	    > "${DSYSTEM}/ps.txt"
batocera-version        > "${DSYSTEM}/batocera.version"
capture "${DSYSTEM}/batocera.info" batocera-info
capture "${DSYSTEM}/services.txt"  batocera-services list
find /boot -type f      > "${DSYSTEM}/boot_files.txt"
ldconfig -p             > "${DSYSTEM}/ldcache.txt"
top -b -n 1             > "${DSYSTEM}/top_processes.txt"
env                     > "${DSYSTEM}/environment_variables.txt"
uptime                  > "${DSYSTEM}/uptime.txt"

for Z in /sys/class/thermal/thermal_zone*; do
    test -e "${Z}/temp" || continue
    echo "$(basename "${Z}") $(cat "${Z}/type" 2>/dev/null) $(cat "${Z}/temp" 2>/dev/null)"
done > "${DSYSTEM}/thermal.txt"

{
    echo "state: $(cat /sys/power/state 2>/dev/null)"
    echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
} > "${DSYSTEM}/power.txt"

# files changed on top of the system image: the saved boot overlay plus this boot's changes
if test -e /boot/boot/overlay; then
    ls -l /boot/boot/overlay > "${DSYSTEM}/overlay.txt"
fi
if test -d /overlay/overlay; then
    find /overlay/overlay \( -path /overlay/overlay/var -o -name .cache -o -name __pycache__ \) -prune \
         -o -type f -exec ls -l {} + > "${DSYSTEM}/overlay_files.txt" 2>/dev/null
fi

for U in "${DHOME}/custom.sh" "${DHOME}/services" "${DHOME}/scripts"; do
    test -e "${U}" && ls -lR "${U}"
done > "${DSYSTEM}/user_scripts.txt" 2>/dev/null

# Libinput (Wayland input Diagnostics)
if command -v libinput >/dev/null; then
    capture "${DJOYS}/libinput_list.txt" libinput list-devices
fi

# -----------------------------------------------------------------------------
# BOOT / FIRMWARE
# -----------------------------------------------------------------------------
cat /proc/cmdline       > "${DBOOT}/cmdline.txt"
d_cp /boot/loader                                              "${DBOOT}"
for L in /boot/boot/*.log; do
    f_cp "${L}" "${DBOOT}"
done

if test -e /proc/device-tree/model; then
    {
        echo "model: $(tr -d '\0' < /proc/device-tree/model)"
        echo "compatible: $(tr '\0' ' ' < /proc/device-tree/compatible)"
    } > "${DBOOT}/devicetree.txt"
fi

if test -d /sys/class/dmi/id; then
    for F in sys_vendor product_name product_version product_family board_vendor board_name board_version bios_vendor bios_version bios_date; do
        echo "${F}: $(cat /sys/class/dmi/id/${F} 2>/dev/null)"
    done > "${DBOOT}/dmi.txt"
fi

for E in /sys/firmware/efi/esrt/entries/*; do
    test -d "${E}" || continue
    echo "$(cat "${E}/fw_class") fw_version=$(cat "${E}/fw_version") last_attempt_status=$(cat "${E}/last_attempt_status")"
done > "${DBOOT}/esrt.txt" 2>/dev/null

# -----------------------------------------------------------------------------
# AUDIO SUBSYSTEM
# -----------------------------------------------------------------------------
f_cp /proc/asound/cards "${DAUDIO}/cards.txt"
for C in /proc/asound/card[0-9]*; do
    test -d "${C}" || continue
    N=${C#/proc/asound/card}
    capture "${DAUDIO}/amixer-card${N}.txt" amixer -c "${N}" contents
done
capture "${DAUDIO}/aplay-l.txt"       aplay -l
capture "${DAUDIO}/aplay-L.txt"       aplay -L
capture "${DAUDIO}/alsactl-info.txt"  alsactl info
command -v alsaucm >/dev/null && capture "${DAUDIO}/alsaucm-cards.txt" alsaucm listcards
if pidof pipewire >/dev/null; then
    capture "${DAUDIO}/batocera-audio-list.txt" batocera-audio list
    capture "${DAUDIO}/wireplumber.txt"         wpctl status
    capture "${DAUDIO}/default-sink.txt"        wpctl inspect @DEFAULT_AUDIO_SINK@
    capture "${DAUDIO}/pipewire_dump.json"      pw-dump
fi

# -----------------------------------------------------------------------------
# BLUETOOTH SUBSYSTEM
# -----------------------------------------------------------------------------
if test -n "$(ls /sys/class/bluetooth 2>/dev/null)"; then
    capture "${DBLUETOOTH}/bt-capabilities.txt" hciconfig -a
    # bluetoothctl waits forever for a bluetoothd that is not running
    if pidof bluetoothd >/dev/null; then
        capture "${DBLUETOOTH}/controller_info.txt" bluetoothctl show
        capture "${DBLUETOOTH}/paired_devices.txt"  bluetoothctl devices
    fi
fi
f_cp /var/log/bluetooth-agent.log "${DBLUETOOTH}"
command -v rfkill >/dev/null && capture "${DBLUETOOTH}/rfkill_status.txt" rfkill list

# -----------------------------------------------------------------------------
# NETWORK SUBSYSTEM
# -----------------------------------------------------------------------------
netstat -tuan    	    > "${DNETWORK}/netstat.txt"
ifconfig -a             > "${DNETWORK}/ifconfig.txt"
ip a                    > "${DNETWORK}/ip_addr_show.txt"
ip route                > "${DNETWORK}/ip_route.txt"
f_cp /etc/resolv.conf "${DNETWORK}"
if pidof connmand >/dev/null; then
    capture "${DNETWORK}/connman-technologies.txt" connmanctl technologies
    capture "${DNETWORK}/connman-services.txt"     connmanctl services
    # network names, in clear and hex in the service id
    sed -i -E 's/^(....)[^ ].* (wifi_[0-9a-f]+_)[0-9a-f]+(_.*)$/\1[ssid] \2[ssid]\3/' "${DNETWORK}/connman-services.txt"
fi
if test -n "$(ls /sys/class/ieee80211 2>/dev/null)"; then
    capture "${DNETWORK}/iw-dev.txt" iw dev
    sed -i -e 's/^\(\s*ssid \).*$/\1[ssid]/' "${DNETWORK}/iw-dev.txt"
    capture "${DNETWORK}/iw-reg.txt" iw reg get
    for P in $(ls /sys/class/ieee80211); do
        capture "${DNETWORK}/iw-${P}-info.txt" iw phy "${P}" info
    done
fi

# -----------------------------------------------------------------------------
# HARDWARE (Storage, USB, PCI, Memory, Power)
# -----------------------------------------------------------------------------
lsmod 	         	    > "${DHARDWARE}/lsmod.txt"
df -h 	         	    > "${DHARDWARE}/df.txt"
df -i                   > "${DHARDWARE}/df_inodes.txt"
mount                   > "${DHARDWARE}/mount_options.txt"
capture "${DHARDWARE}/lsusb.txt"   lsusb
capture "${DHARDWARE}/lsusb_v.txt" lsusb -v
capture "${DHARDWARE}/lspci.txt"   lspci
capture "${DHARDWARE}/lspci_v.txt" lspci -v
blkid                   > "${DHARDWARE}/disks.txt"
lsblk -f                > "${DHARDWARE}/lsblk.txt"
free -m                 > "${DHARDWARE}/memory.txt"
cat /proc/meminfo      >> "${DHARDWARE}/memory.txt"
dmesg | grep -iE "firmware.*(fail|error|not found)|direct firmware load" > "${DHARDWARE}/firmware_errors.txt"

for P in /sys/class/power_supply/*; do
    test -e "${P}/uevent" || continue
    echo "--- $(basename "${P}") ---"
    cat "${P}/uevent"
done > "${DHARDWARE}/power_supply.txt" 2>/dev/null

# Disk Health (Smartctl)
if command -v smartctl >/dev/null; then
    for drive in /dev/sd? /dev/nvme?n?; do
        if [ -e "$drive" ]; then
            NAME=$(basename "$drive")
            capture "${DHARDWARE}/smart_${NAME}.txt" smartctl -H -A "$drive"
        fi
    done
fi

# -----------------------------------------------------------------------------
# DISPLAY SUBSYSTEM (GPU, DRM, X11, Wayland)
# -----------------------------------------------------------------------------
command -v tvservice >/dev/null && capture "${DDISPLAY}/tvservice-CEA.txt" tvservice -m CEA
command -v tvservice >/dev/null && capture "${DDISPLAY}/tvservice-DMT.txt" tvservice -m DMT

for R in listOutputs currentOutput outputModel currentMode currentResolution refreshRate getRotation getDisplayMode getDisplayComp listModes; do
    echo "--- ${R} ---"
    batocera-resolution "${R}"
done > "${DDISPLAY}/batocera-resolution.txt" 2>&1

# Graphics: X11 (glxinfo, xrandr)
if test -n "${DISPLAY}"; then
    command -v glxinfo >/dev/null && capture "${DDISPLAY}/glxinfo.txt"          glxinfo
    command -v xrandr >/dev/null  && capture "${DDISPLAY}/xrandr.txt"           xrandr
    command -v xrandr >/dev/null  && capture "${DDISPLAY}/xrandr-providers.txt" xrandr --listproviders
fi

# Graphics: Wayland
if test -n "${WAYLAND_DISPLAY}"; then
    command -v wlr-randr >/dev/null && capture "${DDISPLAY}/wlr-randr.txt" wlr-randr
fi
command -v eglinfo >/dev/null && capture "${DDISPLAY}/eglinfo.txt" eglinfo -B

# Graphics: DRM / KMS
# Raw DRM status from kernel
for card in /sys/class/drm/card*-*; do
    if [ -e "$card/status" ]; then
        echo "--- $card ---" >> "${DDISPLAY}/drm_status.txt"
        cat "$card/status" >> "${DDISPLAY}/drm_status.txt" 2>/dev/null
        cat "$card/enabled" >> "${DDISPLAY}/drm_status.txt" 2>/dev/null
        cat "$card/modes" >> "${DDISPLAY}/drm_status.txt" 2>/dev/null
        if command -v edid-decode >/dev/null && test -s "$card/edid"; then
            capture "${DDISPLAY}/edid-$(basename "$card").txt" edid-decode "$card/edid"
        fi
    fi
done

# Modetest (KMS debugging)
if command -v modetest >/dev/null; then
    capture "${DDISPLAY}/modetest_generic.txt" modetest
fi

# Vulkan
if command -v vulkaninfo >/dev/null; then
    capture "${DDISPLAY}/vulkan_summary.txt" vulkaninfo --summary
    capture "${DDISPLAY}/vulkan_info.txt"    vulkaninfo
fi

# Display related logs
if [ -f /var/log/Xorg.0.log ]; then
    f_cp /var/log/Xorg.0.log                                   "${DDISPLAY}"
fi
if [ -f /var/log/splash.log ]; then
    f_cp /var/log/splash.log                                   "${DDISPLAY}"
fi
# Labwc Log (if present)
if [ -f /var/log/labwc.log ]; then
    f_cp /var/log/labwc.log                                    "${DDISPLAY}"
fi

# -----------------------------------------------------------------------------
# CONFIGURATION FILES
# -----------------------------------------------------------------------------
f_cp /boot/boot/batocera.board                                 "${DCONFIGS}"
f_cp /boot/config.txt                                          "${DCONFIGS}"
f_cp /userdata/system/batocera.conf                            "${DCONFIGS}"
f_cp /userdata/system/configs/emulationstation/es_settings.cfg "${DCONFIGS}"
f_cp /userdata/system/configs/emulationstation/es_input.cfg    "${DCONFIGS}"
f_cp /boot/batocera-boot.conf                                  "${DCONFIGS}"

capture "${DCONFIGS}/bios.txt" batocera-systems

# Labwc Configs (if present)
if [ -f /var/log/labwc.log ]; then
    d_cp /userdata/system/.config/labwc                        "${DCONFIGS}/labwc"
fi

# emulator configs written since the last game launch (ES writes /tmp/game.xml when it starts one)
if test -e /tmp/game.xml; then
    mkdir "${DCONFIGS}/lastgame"
    (cd "${DHOME}/configs" && find . -type f -newer /tmp/game.xml -size -256k \
         ! -path "./emulationstation/*" ! -path "./pulse/*" ! -path "*/playlists/*" ! -ipath "*cache*" ! -name "*.log" |
     while IFS= read -r C; do
         grep -Iq . "${C}" && cp --parents "${C}" "${DCONFIGS}/lastgame"
     done)
fi

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
# Copy entire logs folder, core dumps are handled below
tar -C "${DHOME}" --exclude='logs/core.*' -cf - logs 2>/dev/null | tar -C "${TMPDIR}" -xf -
find "${DLOGS}" -type f -size +1M | while IFS= read -r L; do
    tail -c 1M "${L}" > "${L}.tail" && mv "${L}.tail" "${L}"
done
# Copy specific logs
f_cp /var/log/messages                                         "${DLOGS}"
f_cp /userdata/system/configs/emulationstation/es_log.txt      "${DLOGS}"
f_cp /userdata/system/configs/emulationstation/es_log.0.txt    "${DLOGS}"
f_cp /var/log/hotkeygen.log                                    "${DLOGS}"
f_cp /var/log/controlcenter-crash.log                          "${DLOGS}"

if [ -f /tmp/resize.log ]; then
    f_cp /tmp/resize.log                                       "${DLOGS}"
fi

if [ -f /var/run/boot.log ]; then
    f_cp /var/run/boot.log                                     "${DLOGS}"
fi
if [ -f /var/run/amd.log ]; then
    f_cp /var/run/amd.log                                      "${DLOGS}"
fi
if [ -f /var/log/batocera-storage.log ]; then
    f_cp /var/log/batocera-storage.log                         "${DLOGS}"
fi

# -----------------------------------------------------------------------------
# SECURITY / SANITIZATION
# -----------------------------------------------------------------------------
# Clear passwords etc
# filter some dangerous options (may include some path with /userdata)
sed -i -e s+"^.*password.*$"+""+gI -e s+"^.*token.*$"+""+gI "${DLOGS}/"*.log "${DLOGS}/"*.txt "${DLOGS}/messages" 2>/dev/null
sed -i -e s+"^.*user.*$"+""+gI "${DCONFIGS}/es_settings.cfg"
sed -i -e s+"^.*pass.*$"+""+gI "${DCONFIGS}/es_settings.cfg"
sed -i -e s+"^.*wifi.*$"+""+gI "${DCONFIGS}/batocera.conf"
sed -i -e s+"^.*retroachievements.*$"+""+gI "${DCONFIGS}/batocera.conf"
sed -i -e s+"^.*password.*$"+""+gI "${DCONFIGS}/batocera.conf"
sed -i -e s+"^.*token.*$"+""+gI "${DCONFIGS}/batocera.conf"
sed -i -e s+"^.*wifi.*$"+""+gI "${DCONFIGS}/batocera-boot.conf"
if test -d "${DCONFIGS}/lastgame"; then
    find "${DCONFIGS}/lastgame" -type f -exec sed -i -e s+"^.*pass.*$"+""+gI -e s+"^.*token.*$"+""+gI -e s+"^.*username.*$"+""+gI {} +
fi

# -----------------------------------------------------------------------------
# PERIPHERALS & EXTRAS
# -----------------------------------------------------------------------------
# Emulators configs
#d_cp /userdata/system/configs                           "${TMPDIR}/configs", disabled, too big

# joysticks
find /dev/input > "${DJOYS}/inputs.txt"
f_cp /proc/bus/input/devices "${DJOYS}/input_devices.txt"
for J in /dev/input/event*
do
    N=$(basename ${J})
    evtest --info "${J}"          > "${DJOYS}/evtest.${N}.txt"
    udevadm info -q all -n "${J}" > "${DJOYS}/udevadm.${N}.txt"
done
capture "${DJOYS}/sdl2-jstest.txt" sdl2-jstest -l
cp "/var/run/sinden/p"*"/sinden-"*".log" "${DJOYS}" 2>/dev/null

# lirc
if test -e "${DHOME}/.config/lirc/lircd.conf"; then
    mkdir "${TMPDIR}/lirc"
    cp "${DHOME}/.config/lirc/lircd.conf" "${TMPDIR}/lirc"
fi

# kodi, once it has run
if test -e "${DHOME}/.kodi/temp/kodi.log"; then
    DKODI="${TMPDIR}/kodi"
    mkdir "${DKODI}"
    f_cp "${DHOME}/.kodi/temp/kodi.log"                       "${DKODI}"
    f_cp "${DHOME}/.kodi/temp/kodi.old.log"                   "${DKODI}"
    f_cp "${DHOME}/.kodi/userdata/Lircmap.xml"                "${DKODI}"
    d_cp "${DHOME}/.kodi/userdata/addon_data/peripheral.joystick" "${DKODI}"
    d_cp "${DHOME}/.kodi/userdata/remotes"                    "${DKODI}"
fi

# core dumps: list them all, copy only the small ones
if ls "${DHOME}/logs/"core.* >/dev/null 2>&1; then
    DCORE="${TMPDIR}/coredumps"
    mkdir "${DCORE}"
    ls -l "${DHOME}/logs/"core.* > "${DCORE}/list.txt"
    find "${DHOME}/logs" -maxdepth 1 -name 'core.*' -size -20M -exec cp {} "${DCORE}" \;
fi

find "${TMPDIR}" -empty -delete

if ! (cd "${GTMP}" && tar cf -  "${REPORTNAME}" | gzip -c > "${OUTPUTFILE}")
then
    echo "Reporting zip creation failed" >&2
    exit 1
fi

rm -rf "${TMPDIR}"
echo "${OUTPUTFILE}"
exit 0
