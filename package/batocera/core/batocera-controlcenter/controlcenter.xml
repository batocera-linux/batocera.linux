<features>
	<vgroup name="Top bar" role="header">
		<feature>
			<text display="${batocera-info --short}" refresh="2" />
			<img display="/usr/share/batocera/controlcenter/bato-record.gif" if='${/usr/bin/batocera-record is_running | grep true}' refresh="2" height="3%" />
		</feature>
		<feature display="Batocera">
			<text display="${batocera-version | cut -d' ' -f1}" />
		</feature>
		<feature display="Touch keyboard" if='${[ -n "$(getLocalWaylandDisplay)" ] &amp;&amp; [ -n "$(touchscreen-detect)" ] &amp;&amp;  echo 1}' refresh="10">
			<button display="Toggle" action="onscreen-keyboard-toggle" afterclick="bcc_close"/>
		</feature>
	</vgroup>

	<feature name="shortcuts_tabs" display="Quick Access">
		<tab display="Game" target="Game" align="right" if="${curl http://127.0.0.1:1234/runningGame | jq -r '.systemName' | sed 's/^null$//'}" />
		<tab display="Save States" target="SaveStates" if="${curl -s http://127.0.0.1:1234/runningGame/savestates | jq -e 'length &gt; 0' &gt;/dev/null &amp;&amp; echo 1}" />
		<tab display="Gun" target="Gun" if="${curl -s http://127.0.0.1:1234/runningGame | jq -r '.name' | grep -qE '^null$' || ls /var/run/batocera-overlays/gun_help.png}" />
		<tab display="System" target="System" align="right" />
		<tab display="Performance" target="Performance" if="${ls /sys/devices/system/cpu/cpufreq/policy0/scaling_governor}" />
		<tab display="Monitor" target="Monitor" />
		<tab display="Outputs" target="Outputs" />
		<tab display="Record" target="Record" />
	</feature>

	<!-- RECORDING TAB -->
	<hgroup name="Record" display="Record">
		<!-- Main Controls Row -->
		<feature display="Recording in progress">
			<switch value='${batocera-record is_running | grep true}'
				action_on="batocera-record start" action_off="batocera-record stop"
				afterclick="bcc_close" refresh="2" />
		</feature>

		<!-- Quality Row: Clicking 'Select' will open the choice popup -->
		<feature display="Quality">
			<text display='${batocera-record get-quality}' refresh="1" />
			<choice display="Ultra (60fps)" action="batocera-record set-quality ultra" afterclick="bcc_refresh" />
			<choice display="High (60fps)"  action="batocera-record set-quality high" afterclick="bcc_refresh" />
			<choice display="Mid (30fps)"   action="batocera-record set-quality mid" afterclick="bcc_refresh" />
			<choice display="Low (30fps)"   action="batocera-record set-quality low" afterclick="bcc_refresh" />
		</feature>

		<!-- Audio Row -->
		<feature display="Audio Source">
			<text display='${batocera-record get-audio}' refresh="1" />
			<choice display="System (Default)" action="batocera-record set-audio auto" afterclick="bcc_refresh" />
			<choice display="Microphone"       action="batocera-record set-audio mic" afterclick="bcc_refresh" />
			<choice display="No Audio"         action="batocera-record set-audio none" afterclick="bcc_refresh" />
		</feature>

		<!-- Multi-Screen Row -->
		<feature display="Record All Screens">
			<switch value='${[ "$(batocera-record get-all)" = "true" ] &amp;&amp; echo "true"}'
					action_on="batocera-record set-all true"
					action_off="batocera-record set-all false"
					afterclick="bcc_refresh" refresh="1" />
		</feature>
                <!-- Screenshot -->
                <feature display="Screenshot">
                  <button display="Take screenshot"
                     action='DELAY=$(cat /tmp/batocera-screenshot-delay 2>/dev/null || echo 2); (sleep "$DELAY"; batocera-screenshot) >/tmp/batocera-screenshot-from-bcc.log &amp;'
                     afterclick="bcc_close" />
                    <choice display="Immediately (with Control Center)" action="echo 0 >/tmp/batocera-screenshot-delay" afterclick="bcc_refresh" />
                    <choice display="2 sec"  action="echo 2 >/tmp/batocera-screenshot-delay" afterclick="bcc_refresh" />
                    <choice display="5 sec"  action="echo 5 >/tmp/batocera-screenshot-delay" afterclick="bcc_refresh" />
                    <choice display="10 sec" action="echo 10 >/tmp/batocera-screenshot-delay" afterclick="bcc_refresh" />
                    <text display='${printf "after %s sec" $(cat /tmp/batocera-screenshot-delay || echo 2)}' refresh="1" />
        </feature>
	</hgroup>

	<hgroup name="Game" display="Game">
		<hgroup>
			<feature>
				<img display='${IMG=$(curl http://127.0.0.1:1234/runningGame | jq -r ".marquee"); [ -n "$IMG" ] &amp;&amp; [ "$IMG" != "null" ] &amp;&amp; echo http://127.0.0.1:1234$IMG }' height="10%" refresh="3" align="left" id="gamemarquee" />
				<text display="${curl http://127.0.0.1:1234/runningGame | jq -r '.name' | sed 's/null//'}" align="left" refresh="3" if="!id(gamemarquee)" />
			</feature>
			<feature>
                            <text display="${/usr/bin/batocera-controlcenter-play-time}" align="left" refresh="1" id="playtime" />
			</feature>
		</hgroup>
		<vgroup>
			<feature>
				<button_confirm display="Quit game" action="hotkeygen --send exit" afterclick="bcc_close" />
				<doc display="Manual" content='${IMG=$(curl http://127.0.0.1:1234/runningGame | jq -r .manual | sed "s/null//"); [ -n "$IMG" ] &amp;&amp; [ "$IMG" != "null" ] &amp;&amp; echo http://127.0.0.1:1234$IMG}' id="manual" refresh="3"/>
				<doc display="Map" content='${IMG=$(curl http://127.0.0.1:1234/runningGame | jq -r .map | sed "s/null//"); [ -n "$IMG" ] &amp;&amp; [ "$IMG" != "null" ] &amp;&amp; echo http://127.0.0.1:1234$IMG}' id="map" refresh="3"/>
			</feature>
			<feature>
				<button display="Save state" action="hotkeygen --send save_state" afterclick="bcc_close" if='${hotkeygen --list | sed "/^#/q" | grep -q "^  save_state-" &amp;&amp; echo 1}' />
				<button display="Load state" action="hotkeygen --send restore_state" afterclick="bcc_close" if='${hotkeygen --list | sed "/^#/q" | grep -q "^  restore_state-" &amp;&amp; echo 1}' />
				<button_confirm display="Reset game" action="hotkeygen --send reset" afterclick="bcc_close" if='${hotkeygen --list | sed "/^#/q" | grep -q "^  reset-" &amp;&amp; echo 1}' />
				<button display="Screenshot" action="hotkeygen --send screenshot" afterclick="bcc_close" />
			</feature>
			<feature display="Mouse Pointer">
				<switch value='${cat /var/run/bcc-mouse || echo 0}'
					action_on="batocera-mouse show; echo 1 >/var/run/bcc-mouse" action_off="batocera-mouse hide; echo 0 >/var/run/bcc-mouse"
					afterclick="bcc_close" refresh="2" />
			</feature>
		</vgroup>
		<vgroup>
                        <img display='${IMG=$(curl http://127.0.0.1:1234/runningGame | jq -r ".thumbnail"); [ -n "$IMG" ] &amp;&amp; [ "$IMG" != "null" ] &amp;&amp; echo http://127.0.0.1:1234$IMG || echo "/usr/share/emulationstation/resources/services/logo-tri.png"}' height="25%" refresh="3" />
			<qrcode display='${IMG=$(curl http://127.0.0.1:1234/runningGame | jq -r ".cheevosId"); [ -n "$IMG" ] &amp;&amp; [ "$IMG" != "null" ] &amp;&amp; echo https://retroachievements.org/game/$IMG}' height="25%" refresh="2" id="cheevos" bg="#141821" style="card" logo="/usr/share/batocera/controlcenter/resources/ra-icon.png" font="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" />
			<img display="${curl http://127.0.0.1:1234/runningGame | jq -r '.systemName' | sed 's:\(.*\):/usr/share/batocera/controller-overlays/\1.png:'}" height="25%" refresh="5" align="center" />
		</vgroup>
	</hgroup>
	<!-- the running game's save states, newest first; picking one loads it -->
	<hgroup name="SaveStates" display="Save States">
		<feature>
			<button display="Save new state" action="batocera-savestate save" afterclick="bcc_close" if='${hotkeygen --list | sed "/^#/q" | grep -q "^  save_state-" &amp;&amp; echo 1}' />
		</feature>
		<feature>
			<gallery display="${curl -s http://127.0.0.1:1234/runningGame/savestates}" refresh="5"
				action="batocera-savestate load {id}"
				confirm="Load this state? Progress since it was saved is lost." afterclick="bcc_close" />
		</feature>
	</hgroup>

        <hgroup name="Gun" display="Gun">
          <img display='${echo /var/run/batocera-overlays/gun_help.png}' height="50%" refresh="5" align="center" />
        </hgroup>
	<hgroup name="System" display="System">
		<feature display="Volume">
				<button display="Vol -" action="batocera-audio setSystemVolume -5" updateids="volumebar" />
				<progressbar id="volumebar" display="${batocera-audio getSystemVolume}" min="0" max="100" refresh="1" action_set="batocera-audio setSystemVolume {value}" />
				<button display="Vol +" action="batocera-audio setSystemVolume +5" updateids="volumebar" />
		</feature>
		<feature display="Brightness" if='${printf "%s" $(batocera-brightness 2&gt;/dev/null)}'>
				<button display="Bright -" action="batocera-brightness - 10" updateids="brightnessbar" />
				<progressbar id="brightnessbar" display="${batocera-brightness}" min="0" max="100" refresh="1" action_set="batocera-brightness {value}" />
				<button display="Bright +" action="batocera-brightness + 10" updateids="brightnessbar" />
		</feature>
		<feature display="Mute Sound" group="Audio/Video">
                       <switch value="${batocera-audio getSystemMute}" refresh="2"
                               action_on="batocera-audio setSystemVolume mute" action_off="batocera-audio setSystemVolume unmute" />
		</feature>
		<feature display="Wi-Fi" if='${ls -d /sys/class/net/*/wireless 2&gt;/dev/null | head -n1}'>
			<switch id="wifi" value='${[ "$(batocera-planemode status)" = "off" ] &amp;&amp; [ "$(batocera-settings-get wifi.enabled)" = "1" ] &amp;&amp; echo true}'
			enabled='${[ "$(batocera-planemode status)" = "off" ] &amp;&amp; echo 1}' disabled_display="Plane mode"
			action_on="batocera-wifi enable" action_off="batocera-wifi disable" refresh="2" align="left"/>
		</feature>
		<feature display="Bluetooth" if='${ls -d /sys/class/bluetooth/hci* 2&gt;/dev/null | head -n1}'>
			<switch id="bluetooth" value='${[ "$(batocera-planemode status)" = "off" ] &amp;&amp; [ "$(batocera-settings-get controllers.bluetooth.enabled)" = "1" ] &amp;&amp; echo true}'
			enabled='${[ "$(batocera-planemode status)" = "off" ] &amp;&amp; echo 1}' disabled_display="Plane mode"
			action_on="batocera-bluetooth enable" action_off="batocera-bluetooth disable" refresh="2" align="left"/>
		</feature>
		<feature display="Plane Mode">
			<switch value="${batocera-planemode status}"
			action_on="batocera-planemode enable" action_off="batocera-planemode disable" refresh="2" align="left" updateids="wifi bluetooth"/>
		</feature>
		<feature display="Pause game">
			<switch value='${[ "$(batocera-settings-get controlcenter.pause)" = "1" ] &amp;&amp; echo true}'
			action_on="batocera-settings-set controlcenter.pause 1" action_off="batocera-settings-set controlcenter.pause 0" refresh="5" align="left"
			enabled='${curl -s http://127.0.0.1:1234/runningGame | jq -e .name &gt;/dev/null &amp;&amp; echo 1}' disabled_display="No game running"/>
		</feature>
		<feature display="Kill emulator?">
			<button_confirm display="Kill it!" action="curl http://127.0.0.1:1234/emukill" align="left" afterclick="bcc_close"
			enabled='${curl -s http://127.0.0.1:1234/runningGame | jq -e .name &gt;/dev/null &amp;&amp; echo 1}' disabled_display="No game running" />
		</feature>
		<feature name="Screen" display="Control center screen" if='${[ "$(batocera-resolution listOutputs | wc -l)" -gt 1 ] &amp;&amp; echo 1}'>
			<choice display="Secondary" action="batocera-settings-set controlcenter.screen secondary" afterclick="bcc_rescreen" />
			<choice display="Primary"   action="batocera-settings-set controlcenter.screen primary" afterclick="bcc_rescreen" />
			<text display='${[ "$(batocera-settings-get controlcenter.screen)" = primary ] &amp;&amp; echo Primary || echo Secondary}' refresh="2" />
		</feature>
		<vgroup>
		  <feature display="Network IP address:">
			<text display='${printf "%s " "$(ip -4 addr show | grep -oP "(?&lt;=inet\s)\d+(\.\d+){3}" | grep -v "127.0.0.1" | head -n1)" ; for d in /sys/class/net/*; do n=$(basename "$d"); if [ "$n" != lo ]; then printf "%s: %s, " "$n" "$(cat "$d/operstate")"; fi; done | sed "s/, $//"}' refresh="5" align="left" />
		  </feature>
		  <feature display="Free data storage:">
			<text display="${df -h $(batocera-part share) | awk '/\/userdata$/ {print $4}'}" refresh="10" align="left" />
		  </feature>
		</vgroup>

	</hgroup>

	<hgroup name="Performance" display="Performance">
		<feature display="Performance">
			<text display="${batocera-perf status}" refresh="2" />
		</feature>

		<!-- outside a game: the global settings -->
		<feature display="On charger" refresh="5" if='${[ -z &quot;$(batocera-perf ingame)&quot; ] &amp;&amp; batocera-perf has battery}'>
			<button display="On charger -" action="batocera-perf set acmodelevel -1" updateids="perfacmode" />
			<progressbar id="perfacmode" display="${batocera-perf get acmodelevel}" min="0" max="3" labels="Power Saver|Conservative|Balanced|High Perf" refresh="2" action_set="batocera-perf set acmodelevel {value}" />
			<button display="On charger +" action="batocera-perf set acmodelevel +1" updateids="perfacmode" />
		</feature>
		<feature display="On battery" refresh="5" if='${[ -z &quot;$(batocera-perf ingame)&quot; ] &amp;&amp; batocera-perf has battery}'>
			<button display="On battery -" action="batocera-perf set batterymodelevel -1" updateids="perfbatterymode" />
			<progressbar id="perfbatterymode" display="${batocera-perf get batterymodelevel}" min="0" max="3" labels="Power Saver|Conservative|Balanced|High Perf" refresh="2" action_set="batocera-perf set batterymodelevel {value}" />
			<button display="On battery +" action="batocera-perf set batterymodelevel +1" updateids="perfbatterymode" />
		</feature>
		<feature display="Power Mode" refresh="5" if='${[ -z &quot;$(batocera-perf ingame)&quot; ] &amp;&amp; [ -z &quot;$(batocera-perf has battery)&quot; ] &amp;&amp; echo 1}'>
			<button display="Power Mode -" action="batocera-perf set acmodelevel -1" updateids="perfpowermode" />
			<progressbar id="perfpowermode" display="${batocera-perf get acmodelevel}" min="0" max="3" labels="Power Saver|Conservative|Balanced|High Perf" refresh="2" action_set="batocera-perf set acmodelevel {value}" />
			<button display="Power Mode +" action="batocera-perf set acmodelevel +1" updateids="perfpowermode" />
		</feature>

		<!-- in a game: changes apply now and last until the game ends, unless saved -->
		<feature display="Power Mode" refresh="5" if='${batocera-perf ingame}'>
			<button display="Power Mode -" action="batocera-perf set modelevel -1" updateids="perfmode" />
			<progressbar id="perfmode" display="${batocera-perf get modelevel}" min="0" max="3" labels="Power Saver|Conservative|Balanced|High Perf" refresh="2" action_set="batocera-perf set modelevel {value}" />
			<button display="Power Mode +" action="batocera-perf set modelevel +1" updateids="perfmode" />
		</feature>

		<feature display="TDP" if='${batocera-perf has tdp}'>
			<button display="TDP -" action="batocera-perf set tdp -5" updateids="perftdp" />
			<progressbar id="perftdp" display="${batocera-perf get tdp}" min="10" max="120" refresh="2" action_set="batocera-perf set tdp {value}" />
			<button display="TDP +" action="batocera-perf set tdp +5" updateids="perftdp" />
		</feature>
		<feature display="Platform Profile" if='${batocera-perf has profile}'>
			<choice_cmd display="${batocera-platform-profile list | tr ' ' '\n'}"
				action="batocera-perf set profile"
				action_arg="${batocera-platform-profile list | tr ' ' '\n'}"
				cache="30" />
			<text display="${batocera-perf show profile}" refresh="2" />
		</feature>

		<feature display="Fan" if='${batocera-perf has fan}'>
			<button display="Fan -" action="batocera-perf set fanlevel -1" updateids="perffan" />
			<progressbar id="perffan" display="${batocera-perf get fanlevel}" min="0" max="3" labels="Quiet|Balanced|Performance|Max" refresh="2" action_set="batocera-perf set fanlevel {value}" />
			<button display="Fan +" action="batocera-perf set fanlevel +1" updateids="perffan" />
		</feature>

		<feature if='${batocera-perf ingame}' refresh="5">
			<button display="Save for this game" action="batocera-perf save game" />
			<button display="Save for system" action="batocera-perf save system" />
		</feature>
	</hgroup>

	<hgroup name="Monitor" display="Monitor">
		<feature display="CPU">
			<graph display="${batocera-resources cpu}" refresh="1" history="60" />
			<text display="${batocera-resources cpu-detail}" refresh="2" />
		</feature>
		<feature display="GPU">
			<graph display="${batocera-resources gpu}" refresh="1" history="60" />
			<text display="${batocera-resources gpu-detail}" refresh="2" />
		</feature>
		<feature display="Memory">
			<graph display="${batocera-resources mem}" refresh="1" history="60" />
			<text display="${batocera-resources mem-detail}" refresh="2" />
		</feature>
		<feature display="Temperature">
			<graph display="${batocera-resources temp}" refresh="1" history="60" min="30" max="100" unit="°C" warn="80" />
		</feature>
		<feature display="Battery" if="${batocera-resources battery}">
			<graph display="${batocera-resources battery}" refresh="5" history="60" warn="101" />
			<text display="${batocera-resources battery-detail}" refresh="2" />
		</feature>
		<feature display="Network">
			<graph display="${batocera-resources net}" refresh="1" history="60" max="auto" unit=" KB/s" warn="-1" />
			<text display="${batocera-resources net-detail}" refresh="2" />
		</feature>
	</hgroup>

	<hgroup name="Outputs" display="Outputs">
	  <feature display="Gamescope" if="${batocera-gamescope status}" refresh="5">
	    <text display="${batocera-gamescope status}" refresh="5" />
	  </feature>
	  <feature display="Upscale Filter" if="${batocera-gamescope status}" refresh="5">
	    <choice display="Linear"  action="batocera-gamescope set filter linear"  afterclick="bcc_refresh" />
	    <choice display="Nearest" action="batocera-gamescope set filter nearest" afterclick="bcc_refresh" />
	    <choice display="FSR"     action="batocera-gamescope set filter fsr"     afterclick="bcc_refresh" />
	    <choice display="NIS"     action="batocera-gamescope set filter nis"     afterclick="bcc_refresh" />
	    <choice display="SGSR"    action="batocera-gamescope set filter sgsr"    afterclick="bcc_refresh" />
	    <choice display="Pixel"   action="batocera-gamescope set filter pixel"   afterclick="bcc_refresh" />
	    <text display="${batocera-gamescope show filter}" refresh="2" />
	  </feature>
	  <feature display="Sharpness" if='${batocera-gamescope get filter | grep -xE "fsr|nis|sgsr"}' refresh="2">
	    <button display="Sharpness -" action="batocera-gamescope set sharpness -1" updateids="gamescopesharpness" />
	    <progressbar id="gamescopesharpness" display="${batocera-gamescope get sharpness}" min="0" max="20" unit="" refresh="2" action_set="batocera-gamescope set sharpness {value}" />
	    <button display="Sharpness +" action="batocera-gamescope set sharpness +1" updateids="gamescopesharpness" />
	  </feature>
	  <feature display="Scaling" if="${batocera-gamescope status}" refresh="5">
	    <choice display="Fit"     action="batocera-gamescope set scaler fit"     afterclick="bcc_refresh" />
	    <choice display="Integer" action="batocera-gamescope set scaler integer" afterclick="bcc_refresh" />
	    <choice display="Fill"    action="batocera-gamescope set scaler fill"    afterclick="bcc_refresh" />
	    <choice display="Stretch" action="batocera-gamescope set scaler stretch" afterclick="bcc_refresh" />
	    <text display="${batocera-gamescope show scaler}" refresh="2" />
	  </feature>
	  <feature display="Frame Rate Limit" if="${batocera-gamescope status}" refresh="5">
	    <choice_cmd display="${batocera-gamescope fps-limits | cut -f 2}"
			action="batocera-gamescope set fps_limit"
			action_arg="${batocera-gamescope fps-limits | cut -f 1}"
			cache="10" />
	    <text display="${batocera-gamescope show fps_limit}" refresh="2" />
	  </feature>
	  <feature if="${batocera-gamescope status}" refresh="5">
	    <button display="Save for this game" action="batocera-gamescope save game" />
	    <button display="Save for system" action="batocera-gamescope save system" />
	  </feature>
	  <feature display="Audio Output">
	    <choice_cmd display="${batocera-audio list | grep -vE '^auto' | cut -f 2}"
			action="batocera-audio set"
			action_arg="${batocera-audio list | grep -vE '^auto' | cut -f 1}"
			cache="10" />
	    <text display="${batocera-audio get | cut -f 2}" refresh="3" />
	  </feature>
	  <feature display="Audio Profile">
	    <choice_cmd display="${batocera-audio list-profiles | grep -vE '^auto' | cut -f 2}"
			action="batocera-audio set-profile"
			action_arg="${batocera-audio list-profiles | grep -vE '^auto' | cut -f 1}"
			cache="10" />
	    <text display="${batocera-audio get-profile | cut -f 2}" refresh="3" />
	  </feature>
	</hgroup>
	<vgroup name="Bottom bar" role="footer">
		<feature display="CPU:">
			<progressbar display='${ read -r _ u2 n2 s2 i2 w2 r2 &lt; /proc/stat; F=/tmp/.bcc_cpu_prev; if [ -f "$F" ]; then read -r _ u1 n1 s1 i1 w1 r1 &lt; "$F"; else u1=$u2; s1=$s2; i1=$i2; w1=$w2; fi; echo "cpu $u2 $n2 $s2 $i2 $w2" &gt; "$F"; du=$((u2-u1)); ds=$((s2-s1)); di=$((i2-i1)); dw=$((w2-w1)); t=$((du+ds+di+dw)); if [ "$t" -gt 0 ]; then echo $(( (100*(du+ds+dw)+t/2)/t )); else echo 0; fi }' min="0" max="100" refresh="1" />
		</feature>
		<feature display="CPU Temp:">
			<text display="${batocera-temp --cpu}C" refresh="3" />
		</feature>
		<feature display="Resolution:">
			<text display="${batocera-resolution currentResolution}" />
		</feature>
	</vgroup>
</features>
