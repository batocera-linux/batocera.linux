#!/bin/sh

# This is the BATOCERA system splash service
# It shows the unique BATOCERA logo in early boot stage

LOG_FILE="/var/log/splash.log"
READY_FILE="/var/run/system-splash.ready"
FB_NAME="/sys/class/graphics/fb0/name"
FIFO="/var/run/system-splash.fifo"
DAEMON="[ $(basename $0) ]:"

do_start () {
    local fbname drawn line watcher
    LOG_DIR="${LOG_FILE%/*}"
    [ -d "${LOG_DIR}" ] || mkdir -p "${LOG_DIR}"
    exec >> "${LOG_FILE}" 2>&1

    echo "${DAEMON} Starting ..."
    # one persistent watch, so an fb0 change between checks is never missed
    rm -f "${FIFO}"
    mkfifo "${FIFO}"
    timeout 30 inotifywait -m -e create,delete,delete_self "${READY_FILE}" /dev > "${FIFO}" 2>&1 &
    watcher=$!
    exec 3< "${FIFO}"
    rm -f "${FIFO}"
    while read -r line <&3; do
        [ "${line}" = "Watches established." ] && break
    done

    # redraw whenever the gpu driver replaces fb0, until the user splash removes the ready file
    while [ -e "${READY_FILE}" ]; do
        [ -e /dev/fb0 ] || drawn=""
        fbname=""
        [ -e /dev/fb0 ] && [ -r "${FB_NAME}" ] && read -r fbname < "${FB_NAME}"
        if [ -n "${fbname}" ] && [ "${fbname}" != "${drawn}" ]; then
            echo "${DAEMON} Drawing logo on ${fbname}"
            draw_logo || break
            drawn="${fbname}"
            continue
        fi
        if ! read -r line <&3; then
            if [ -n "${drawn}" ]; then
                echo "${DAEMON} No user splash after 30s, stopping."
            else
                echo "${DAEMON} Error! Framebuffer device /dev/fb0 not found."
            fi
            break
        fi
    done
    kill "${watcher}" 2>/dev/null
    exec 3<&-
    rm -f "${READY_FILE}"
    echo "${DAEMON} Done."
}

draw_logo () {
    # Default image
    image="/usr/share/batocera/splash/boot-logo.png"
    # Standard FBV options
    FBV_OPTS="-f -e -i -y"   
    # Variables for screen dimensions
    WIDTH=""
    HEIGHT=""

    # Detect active DRM connector type (batocera-drminfo returns "EDP", "DSI", "HDMIA", etc.)
    effectiveDrmOutput=$(for GPU in /dev/dri/card*; do batocera-drminfo "${GPU}" "current" 2>/dev/null | grep -oP '^[0-9]+\.[0-9]+:\K[^ ]+'; done | head -1)

    V_BOARD_MODEL=$(batocera-model)
    video_rotation=""
    BOOT_CONF="/boot/batocera-boot.conf"
    MODEL_CONF="/usr/share/batocera/sysconfigs/batocera.conf.${V_BOARD_MODEL}"

    # Check connector-specific settings
    if [ -n "${effectiveDrmOutput}" ]; then
        if [ -f "${BOOT_CONF}" ]; then
            video_rotation=$(/usr/bin/batocera-settings-get -f "${BOOT_CONF}" "display.rotate.${effectiveDrmOutput}")
        fi
        if [ -z "${video_rotation}" ] && [ -f "${MODEL_CONF}" ]; then
            video_rotation=$(grep -iE "^display\.rotate\.${effectiveDrmOutput}=" "${MODEL_CONF}" | head -1 | cut -d'=' -f2)
        fi
    fi

    # Fall back to generic global settings
    if [ -z "${video_rotation}" ]; then
        if [ -f "${BOOT_CONF}" ]; then
            video_rotation=$(/usr/bin/batocera-settings-get -f "${BOOT_CONF}" "display.rotate")
        fi
        if [ -z "${video_rotation}" ] && [ -f "${MODEL_CONF}" ]; then
            video_rotation=$(grep -iE '^display\.rotate=' "${MODEL_CONF}" | head -1 | cut -d'=' -f2)
        fi
    fi

    # firmware framebuffers have no connector, follow the console's panel rotation
    if [ -z "${video_rotation}" ] && [ -z "${effectiveDrmOutput}" ] && [ -r /sys/class/graphics/fbcon/rotate ]; then
        read -r video_rotation < /sys/class/graphics/fbcon/rotate
    fi

    video_rotation=$(echo "${video_rotation}" | tr -d '[:space:]')
    echo "${DAEMON} Active DRM Output: [${effectiveDrmOutput}]"
    echo "${DAEMON} Final Rotation Value: [${video_rotation}]"
    
    # Get the screen's physical dimensions
    if [ -r /sys/class/graphics/fb0/modes ]; then
        if read -r MODE_STR < /sys/class/graphics/fb0/modes; then
            DIM_PART=${MODE_STR#*:}
            WIDTH=${DIM_PART%%x*}
            remaining=${DIM_PART#*x}
            HEIGHT=${remaining%%[!0-9]*}
        fi

        if [ -n "${WIDTH}" ] && [ -n "${HEIGHT}" ]; then
            echo "${DAEMON} Resolution detected via modes: ${WIDTH}x${HEIGHT}"
            
            # Determine target size for cropping.
            # If rotated 90 or 270 degrees (1 or 3), swap width and height.
            if [ "${video_rotation}" = "1" ] || [ "${video_rotation}" = "3" ]; then
                CROP_WIDTH="${HEIGHT}"
                CROP_HEIGHT="${WIDTH}"
            else
                CROP_WIDTH="${WIDTH}"
                CROP_HEIGHT="${HEIGHT}"
            fi

            # Automatically crops and centers the master logo to target aspect ratio
            cropped_image="/tmp/boot-logo-cropped.bmp"
            if [ -f "${image}" ]; then
                echo "${DAEMON} Pre-cropping logo to logical size ${CROP_WIDTH}x${CROP_HEIGHT} via FFmpeg..."
                if ffmpeg -y -threads 1 -sws_flags fast_bilinear \
                    -i "${image}" \
                    -vf "scale=w=${CROP_WIDTH}:h=${CROP_HEIGHT}:force_original_aspect_ratio=increase,crop=${CROP_WIDTH}:${CROP_HEIGHT}" \
                    "${cropped_image}" >/dev/null 2>&1 \
                   && [ -f "${cropped_image}" ]; then
                    image="${cropped_image}"
                fi
            fi
        fi
    fi

    if ! [ -f "${image}" ]; then
        echo "${DAEMON} Error! Splash image not found at ${image}"
        return 1
    fi

    case "${video_rotation}" in
        1|2|3)
            FBV_OPTS="${FBV_OPTS} -o ${video_rotation}"
            echo "${DAEMON} Applying FBV rotation: -o ${video_rotation}"
            ;;
    esac

    MODELOPTS="/etc/opts.${V_BOARD_MODEL}"
    [ -e "${MODELOPTS}" ] && . "${MODELOPTS}"

    # the user splash may have taken over while the logo was being prepared
    [ -e "${READY_FILE}" ] || return 0
    echo "${DAEMON} Executing Command: fbv ${FBV_OPTS} \"${image}\""
    fbv ${FBV_OPTS} "${image}" >/dev/null 2>&1
}

do_stop () {
    rm -f "${READY_FILE}"
    [ -e /dev/fb0 ] && dd if=/dev/zero of=/dev/fb0 >/dev/null 2>&1
    return 0
}

case "$1" in
    start)
        touch "${READY_FILE}"
        do_start &
        ;;
    stop)
        do_stop
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit $?
