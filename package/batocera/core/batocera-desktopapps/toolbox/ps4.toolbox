# ──────────────────────────────────────────────────────────────────
# AES backend (OpenSSL through ctypes: AES-128-CBC and AES-128-XTS)
# ──────────────────────────────────────────────────────────────────

def _load_library(names):
    for name in names:
        try:
            return ctypes.CDLL(name)
        except OSError:
            continue
    found = ctypes.util.find_library(names[-1])
    if found:
        return ctypes.CDLL(found)
    return None


class _OpenSSL:
    """The handful of libcrypto EVP calls the PKG decryption needs."""

    _instance = None

    def __init__(self):
        lib = _load_library(["libcrypto.so.3", "libcrypto.so.1.1", "libcrypto.so", "crypto"])
        if lib is None:
            raise PkgError("libcrypto (OpenSSL) not found; cannot decrypt PKG data")
        lib.EVP_CIPHER_CTX_new.restype = ctypes.c_void_p
        lib.EVP_CIPHER_CTX_free.argtypes = [ctypes.c_void_p]
        lib.EVP_CIPHER_CTX_set_padding.argtypes = [ctypes.c_void_p, ctypes.c_int]
        lib.EVP_aes_128_cbc.restype = ctypes.c_void_p
        lib.EVP_aes_128_xts.restype = ctypes.c_void_p
        lib.EVP_DecryptInit_ex.argtypes = [ctypes.c_void_p] * 5
        lib.EVP_DecryptUpdate.argtypes = [
            ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int),
            ctypes.c_void_p, ctypes.c_int,
        ]
        self.lib = lib

    @classmethod
    def get(cls):
        if cls._instance is None:
            cls._instance = cls()
        return cls._instance

    def new_ctx(self, cipher, key, iv):
        ctx = ctypes.c_void_p(self.lib.EVP_CIPHER_CTX_new())
        if not ctx:
            raise PkgError("EVP_CIPHER_CTX_new failed")
        if self.lib.EVP_DecryptInit_ex(ctx, ctypes.c_void_p(cipher), None, key, iv) != 1:
            self.lib.EVP_CIPHER_CTX_free(ctx)
            raise PkgError("EVP_DecryptInit_ex failed")
        self.lib.EVP_CIPHER_CTX_set_padding(ctx, 0)
        return ctx

    def free_ctx(self, ctx):
        self.lib.EVP_CIPHER_CTX_free(ctx)

    def update(self, ctx, data, out, outl):
        if self.lib.EVP_DecryptUpdate(ctx, out, ctypes.byref(outl), data, len(data)) != 1:
            raise PkgError("EVP_DecryptUpdate failed")
        return out.raw[:outl.value]


def _aes_cbc_decrypt(key: bytes, iv: bytes, data: bytes) -> bytes:
    """Decrypt an AES-128-CBC buffer whose length is already block aligned."""
    ssl = _OpenSSL.get()
    ctx = ssl.new_ctx(ssl.lib.EVP_aes_128_cbc(), key, iv)
    try:
        out = ctypes.create_string_buffer(len(data) + 16)
        return ssl.update(ctx, data, out, ctypes.c_int(0))
    finally:
        ssl.free_ctx(ctx)


class _XtsDecryptor:
    """AES-128-XTS over fixed 0x1000-byte sectors, as used by the PFS image."""

    def __init__(self, data_key: bytes, tweak_key: bytes) -> None:
        self._ssl = _OpenSSL.get()
        self._ctx = self._ssl.new_ctx(
            self._ssl.lib.EVP_aes_128_xts(), data_key + tweak_key, bytes(16))
        self._out = ctypes.create_string_buffer(XTS_SECTOR_SIZE + 16)
        self._outl = ctypes.c_int(0)

    def __del__(self):
        ctx = getattr(self, "_ctx", None)
        if ctx is not None:
            self._ssl.free_ctx(ctx)
            self._ctx = None

    def decrypt(self, data: bytes, first_sector: int) -> bytes:
        if len(data) % XTS_SECTOR_SIZE:
            raise PkgError("XTS input must be a multiple of the sector size")
        view = memoryview(data)
        parts = []
        for i in range(len(data) // XTS_SECTOR_SIZE):
            tweak = (first_sector + i).to_bytes(16, "little")
            if self._ssl.lib.EVP_DecryptInit_ex(self._ctx, None, None, None, tweak) != 1:
                raise PkgError("EVP_DecryptInit_ex failed to reset the XTS tweak")
            sector = bytes(view[i * XTS_SECTOR_SIZE:(i + 1) * XTS_SECTOR_SIZE])
            parts.append(self._ssl.update(self._ctx, sector, self._out, self._outl))
        return b"".join(parts)


# ──────────────────────────────────────────────────────────────────
# zstd backend (stdlib on python 3.14, otherwise libzstd through ctypes)
# ──────────────────────────────────────────────────────────────────

class _LibZstd:
    """ZSTD_compress/ZSTD_decompress from libzstd, for pythons without _zstd."""

    _instance = None

    def __init__(self):
        lib = _load_library(["libzstd.so.1", "libzstd.so", "zstd"])
        if lib is None:
            raise ZArchiveError(
                "no zstd support: neither the python zstd module nor libzstd was found")
        lib.ZSTD_compressBound.restype = ctypes.c_size_t
        lib.ZSTD_compressBound.argtypes = [ctypes.c_size_t]
        lib.ZSTD_compress.restype = ctypes.c_size_t
        lib.ZSTD_compress.argtypes = [
            ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int,
        ]
        lib.ZSTD_decompress.restype = ctypes.c_size_t
        lib.ZSTD_decompress.argtypes = [
            ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t,
        ]
        lib.ZSTD_isError.restype = ctypes.c_uint
        lib.ZSTD_isError.argtypes = [ctypes.c_size_t]
        lib.ZSTD_getErrorName.restype = ctypes.c_char_p
        lib.ZSTD_getErrorName.argtypes = [ctypes.c_size_t]
        self.lib = lib

    @classmethod
    def get(cls):
        if cls._instance is None:
            cls._instance = cls()
        return cls._instance

    def _check(self, size):
        if self.lib.ZSTD_isError(size):
            raise ZArchiveError(
                f"zstd error: {self.lib.ZSTD_getErrorName(size).decode('utf-8', 'replace')}")
        return size

    def compress(self, data: bytes, level: int) -> bytes:
        bound = self.lib.ZSTD_compressBound(len(data))
        dst = ctypes.create_string_buffer(bound)
        size = self._check(self.lib.ZSTD_compress(dst, bound, data, len(data), level))
        return dst.raw[:size]

    def decompress(self, data: bytes, size: int) -> bytes:
        dst = ctypes.create_string_buffer(size)
        got = self._check(self.lib.ZSTD_decompress(dst, size, data, len(data)))
        return dst.raw[:got]

def _make_compressor(level: int) -> Callable[[bytes], bytes]:
    """Return a ``bytes -> bytes`` zstd compressor from whatever backend exists.

    The reference ZArchive implementation calls ``ZSTD_compress(..., level)``,
    so any backend producing a standard single frame is interchangeable here.
    """
    try:
        from compression import zstd
    except ImportError:
        pass
    else:
        return lambda data: zstd.compress(data, level)

    try:
        import zstandard
    except ImportError:
        pass
    else:
        return zstandard.ZstdCompressor(level=level).compress

    lib = _LibZstd.get()
    return lambda data: lib.compress(data, level)


def _zstd_decompress(data: bytes, size: int) -> bytes:
    """Decompress one zstd frame known to expand to at most ``size`` bytes."""
    try:
        from compression import zstd
    except ImportError:
        pass
    else:
        return zstd.decompress(data)

    try:
        import zstandard
    except ImportError:
        pass
    else:
        return zstandard.ZstdDecompressor().decompress(data, max_output_size=size)

    return _LibZstd.get().decompress(data, size)


