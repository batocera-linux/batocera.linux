#
# OpenGOAL Toolbox is a script integration for PCManFM
#
# The first launch of an OpenGOAL disc image builds the game into a folder of
# the same name beside it. Packing that folder into a .squashfs roughly halves
# it, ES lists the .squashfs as the game, and neither the folder nor the disc
# image is needed afterwards.
#

# Works only if PCManFM process is detected and if an argument is setted
pgrep -x pcmanfm >/dev/null && [[ -n "$1" ]] || { echo "error: No instance of PCManFM found... exit now!"; exit 1; }

Squash_Game() {
  local gname="${2%.*}.squashfs"
  cd "$1" || exit 1

  [[ -d "$2/out" ]] || { echo "error: '$2' holds no built game, launch the disc image first" | yad --text-info --wrap --fontname="${f[2]}"; exit 1; }
  [[ -e "$gname" ]] && gname="$(printf '%x' $(date +%s))_$gname"

  mksquashfs "${2}" "${gname}" -comp zstd -percentage | yad --progress --text="<span font='${f[0]}'>Creating $gname${fx}" --auto-close
  [[ -s "$gname" ]] || exit 1

  Remove_Sources "$2" "$gname"
}

Remove_Sources() {
  # whichever disc image the folder was built from, which the .squashfs replaces
  local leftovers=("$1") image
  for image in "$1".iso "$1".ISO; do
    [[ -f "$image" ]] && leftovers+=("$image")
  done

  printf '%s\n' "$2 is ready. Delete what it replaces?" "" "${leftovers[@]/#/  }" \
    | yad --text-info --wrap --fontname="${f[2]}" --button="Keep everything":1 --button="Delete":0 || return 0

  rm -rf -- "${leftovers[@]}"
}

Extract_Game() {
  local gname="${2%.*}"
  cd "$1" || exit 1
  [[ -e "$gname" ]] && gname="$(printf '%x' $(date +%s))_$gname"
  unsquashfs -li -d "$gname" "$2" | yad --text-info --tail --fontname="${f[0]}"
}

#### MAIN
CONF_FILE=/userdata/system/.config/pcmanfm/toolbox.conf
CONF_KEY=$(basename $0).font
CONF_VALS=3

# init font: read from conf, or check if dejavu-font is available or fallback to default
ft="DejaVu Sans Mono"
if grep -q "^${CONF_KEY}" "${CONF_FILE}"; then
  readarray -t -d "|" f < <(batocera-settings-get -f "${CONF_FILE}" "${CONF_KEY}")
  [[ ${#f[@]} -ge ${CONF_VALS} ]] && fx="</span>" || { unset f; sed -i "s/^[^#]*${CONF_KEY}/#&/" "${CONF_FILE}"; }
elif fc-list -q "${ft}"; then
  f=("${ft} Bold 12" "${ft} Book 16" "${ft} Book 20")
  fx="</span>"
fi

case ${1} in
  --squash-game)
    #use %d for basedir and %b for basename (gamename)
    [[ ${#@} -eq 3 ]] || exit 1
    Squash_Game "$2" "$3"
  ;;
  --extract-game)
    #use %d for basedir, %b for basename
    [[ ${#@} -eq 3 ]] || exit 1
    Extract_Game "$2" "$3"
  ;;
esac
