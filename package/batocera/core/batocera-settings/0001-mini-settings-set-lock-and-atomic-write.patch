       config_contents_size = 0;
     } else {
       perror(config_in_path);
+      close(lock_fd);
       return EXIT_FAILURE;
     }
   }
@@ -99,24 +184,18 @@ int main(int argc, char *argv[]) {
     goto set_failed;
   }
 
-  FILE *config_file = fopen(config_out_path, "w");
-  if (config_file == NULL) {
-    perror(config_out_path);
-    goto set_failed;
-  }
-  fwrite(result.contents, sizeof(char), result.contents_size, config_file);
-  if (ferror(config_file)) {
-    perror("write error");
+  if (write_file_atomic(config_out_path, result.contents, result.contents_size) != 0) {
     goto set_failed;
   }
-  fclose(config_file);
 
   free(result.contents);
   free(config_contents);
+  close(lock_fd);
   return EXIT_SUCCESS;
 
 set_failed:
   free(result.contents);
   free(config_contents);
+  close(lock_fd);
