#. TRANSLATION: duckstation, libretro/beetle-saturn, libretro/dolphin, libretro/dosbox, libretro/dosbox_pure, ...
msgctxt "game_options"
msgid "CONTROLLER 2 TYPE"
msgstr "TIPO DE CONTROL 2"

#. TRANSLATION: libretro/bluemsx, libretro/fuse, libretro/vice_x128, libretro/vice_x64, libretro/vice_x64sc, ...
msgctxt "game_options"
msgid "Hides borders on many games. Some games used the borders."
msgstr "Oculta los bordes en muchos juegos. Algunos juegos utilizan esos bordes."

#. TRANSLATION: libretro/bluemsx, libretro/fuse, vice
msgctxt "game_options"
msgid "ZOOM (HIDE BORDERS)"
msgstr "ZOOM (OCULTAR BORDES)"

#. TRANSLATION: libretro/bluemsx
msgctxt "game_options"
msgid "MSX2"
msgstr "MSX2"

#. TRANSLATION: libretro/bluemsx
msgctxt "game_options"
msgid "Enhancement. Remove the four sprites per line limit."
msgstr "Mejora que elimina el límite de cuatro graficos por línea."

#. TRANSLATION: libretro/bluemsx, libretro/fceumm, libretro/genesisplusgx, libretro/genesisplusgx-expanded, libretro/mednafen_supergrafx, ...
