msgctxt "game_options"
msgid "Off"
msgstr "Desactivado"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Load latest save state on game launch and save state when exiting game."
msgstr "Carga el último estado guardado al iniciar el juego y guarda el estado al salir."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "AUTO SAVE/LOAD ON GAME LAUNCH"
msgstr "GUARDADO Y CARGA AUTOMÁTICOS AL INICIAR EL JUEGO"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "GAME RENDERING & SHADERS"
msgstr "RENDERIZADO DEL JUEGO Y SHADERS"

#. TRANSLATION: pcsx2, shared
msgctxt "game_options"
msgid "SHADER SET"
msgstr "CONJUNTO DE SHADER"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Disabled if using a shader set or the output display matches the game's "
"resolution."
msgstr ""
"Se desactiva si se utiliza un conjunto de shaders o si la resolución de "
"salida coincide con la resolución del juego."

#. TRANSLATION: hypseus-singe, play, shared
msgctxt "game_options"
msgid "SMOOTH GAMES (BILINEAR FILTERING)"
msgstr "SUAVIZAR JUEGOS (FILTRADO BILINEAL)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Only increase the image size in integer multiples."
msgstr "Aumenta el tamaño de la imagen únicamente en múltiplos enteros."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "INTEGER SCALING (PIXEL PERFECT)"
msgstr "ESCALADO ENTERO (PIXEL PERFECTO)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "DECORATIONS"
msgstr "DECORACIONES"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "DECORATION SET"
msgstr "CONJUNTO DE DECORACIONES"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "STRETCH BEZELS (4K & ULTRAWIDE)"
msgstr "ESTIRAR MARCOS (4K Y ULTRAWIDE)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Show context-sensitive info over the game."
msgstr "Muestra información contextual sobre el juego."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "HEADS UP DISPLAY"
msgstr "INTERFAZ EN PANTALLA (HUD)"

#. TRANSLATION: citron, dolphin, dolphin_triforce, drastic, fallout1-ce, ...
msgctxt "game_options"
msgid "None"
msgstr "Ninguno"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Game info/art"
msgstr "Información e ilustraciones del juego"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Performance"
msgstr "Rendimiento"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "HEADS UP DISPLAY CORNER"
msgstr "ESQUINA DE LA INTERFAZ EN PANTALLA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "TOP LEFT (NW)"
msgstr "SUPERIOR IZQUIERDA (NO)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "TOP RIGHT (NE)"
msgstr "SUPERIOR DERECHA (NE)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "BOTTOM RIGHT (SE)"
msgstr "INFERIOR DERECHA (SE)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "BOTTOM LEFT (SW)"
msgstr "INFERIOR IZQUIERDA (SO)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Show an image overlaid on top of the bezel."
msgstr "Muestra una imagen superpuesta sobre el marco."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "SHOW TATTOO OVER BEZEL"
msgstr "MOSTRAR IMAGEN SOBRE EL MARCO"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "NO"
msgstr "NO"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "SYSTEM CONTROLLERS"
msgstr "CONTROLES DEL SISTEMA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "CUSTOM IMAGE"
msgstr "IMAGEN PERSONALIZADA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "TATTOO CORNER"
msgstr "ESQUINA DE LA IMAGEN"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "CUSTOM .PNG IMAGE PATH"
msgstr "RUTA DE LA IMAGEN .PNG PERSONALIZADA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Shrink/expand tattoo to fit within the bezel's border."
msgstr "Reduce o amplía la imagen para ajustarla al borde del marco."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "RESIZE TATTOO"
msgstr "CAMBIAR TAMAÑO DE LA IMAGEN"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"During gameplay, press Hotkey + R1 to translate on-screen text. Only on "
"libretro cores."
msgstr ""
"Durante el juego, presiona Hotkey + R1 para traducir el texto en pantalla. "
"Esta función solo está disponible en los núcleos de Libretro."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "AI GAME TRANSLATION"
msgstr "TRADUCCIÓN DE JUEGOS CON IA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "ENABLE AI TRANSLATION SERVICE"
msgstr "ACTIVAR SERVICIO DE TRADUCCIÓN CON IA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "The language to translate into."
msgstr "Idioma al que se traducirá el texto."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "TARGET LANGUAGE"
msgstr "IDIOMA DE DESTINO"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "If nothing is specified, will use ZTranslate by default."
msgstr "Si no se especifica nada, se utilizará ZTranslate de forma predeterminada."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "AI TRANSLATION SERVICE URL"
msgstr "URL DEL SERVICIO DE TRADUCCIÓN CON IA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "PAUSE ON TRANSLATED SCREEN"
msgstr "PAUSAR EN LA PANTALLA TRADUCIDA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Enables run-ahead. Doubles CPU requirements. High numbers can result in "
"visible jitter."
msgstr ""
"Activa la función Run-Ahead. Duplica los requisitos de CPU. Los valores "
"altos pueden provocar saltos visibles en la imagen."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "LATENCY REDUCTION"
msgstr "REDUCCIÓN DE LATENCIA"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "RUN-AHEAD FRAMES"
msgstr "FOTOGRAMAS DE ANTICIPACIÓN (RUN-AHEAD)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Can prevent audio skips on button presses when using run-ahead."
msgstr "Puede evitar cortes de audio al presionar botones cuando se utiliza encabezado"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "USE SECOND INSTANCE FOR RUN-AHEAD"
msgstr "USAR UNA SEGUNDA INSTANCIA PARA RUN-AHEAD"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Use preemptive frames instead of run-ahead. Only runs ahead when controller "
"state changes."
msgstr ""
"Utiliza fotogramas preventivos en lugar de Run-Ahead. Solo adelanta la "
"ejecución cuando cambia el estado del control."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "USE PRE-EMPTIVE FRAMES"
msgstr "USAR FOTOGRAMAS PREVENTIVOS"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Automatically decrease frame delay temporarily to prevent frame drops. Can "
"introduce stuttering."
msgstr ""
"Reduce temporalmente y de forma automática el retraso de los fotogramas para "
"evitar caídas de FPS. Puede provocar tirones en la imagen."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "AUTOMATIC FRAME DELAY"
msgstr "RETRASO AUTOMÁTICO DE FOTOGRAMAS"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Don't deviate from core requested timing. G-Sync, FreeSync, HDMI 2.1 VRR."
msgstr ""
"Respeta la sincronización solicitada por el núcleo. Compatible con G-Sync, "
"FreeSync y VRR de HDMI 2.1."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "VARIABLE REFRESH RATE"
msgstr "FRECUENCIA DE ACTUALIZACIÓN VARIABLE"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Improves performance at the cost of latency and more video stuttering."
msgstr "Mejora el rendimiento, pero aumenta la latencia y los tirones en el video."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "THREADED VIDEO"
msgstr "VIDEO MULTIHILO"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Use light guns instead of pads if light guns are connected."
msgstr "Utiliza pistolas de luz en lugar de controles convencionales si hay pistolas conectadas."

#. TRANSLATION: dolphin, rpcs3, shared
msgctxt "game_options"
msgid "LIGHT GUNS"
msgstr "PISTOLAS DE LUZ"

#. TRANSLATION: dolphin, libretro/dice, libretro/stella, rpcs3, shared
msgctxt "game_options"
msgid "CONTROLS"
msgstr "CONTROLES"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "USE LIGHT GUNS"
msgstr "USAR PISTOLAS DE LUZ"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Use wheels instead of pads if wheels are connected."
msgstr "Utiliza volantes en lugar de controles convencionales si hay volantes conectados."

#. TRANSLATION: pcsx2, shared
msgctxt "game_options"
msgid "WHEELS"
msgstr "VOLANTES"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "USE WHEELS"
msgstr "USAR VOLANTES"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Maximum wheel rotation from left to right (in degrees)"
msgstr "Rotación máxima del volante de izquierda a derecha (en grados)."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "WHEEL ROTATION"
msgstr "ROTACIÓN DEL VOLANTE"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Zone for which the game doesn't react to the wheel (in degrees)"
msgstr "Zona en la que el juego no responde al movimiento del volante (en grados)."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "WHEEL DEADZONE"
msgstr "ZONA MUERTA DEL VOLANTE"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Reserve a non dead zone at the center of the wheel to go straight ahead (in "
"degrees)"
msgstr ""
"Establece una zona sin zona muerta en el centro del volante para mantener "
"la trayectoria recta (en grados)."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "WHEEL MIDZONE"
msgstr "ZONA CENTRAL DEL VOLANTE"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "For emulators and controllers supporting force feedback."
msgstr "Para emuladores y controles compatibles con la respuesta de fuerza."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "RUMBLE LEVEL"
msgstr "NIVEL DE VIBRACIÓN"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Set game audio level gain in dB."
msgstr "Configura la ganancia del audio del juego en dB."

#. TRANSLATION: shared
msgctxt "game_options"
msgid "AUDIO VOLUME GAIN"
msgstr "GANANCIA DEL VOLUMEN DE AUDIO"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "0 (No gain)"
msgstr "0 (Sin ganancia)"

#. TRANSLATION: shared
msgctxt "game_options"
msgid "Show/Hide guns borders for specific systems"
msgstr "Mostrar u ocultar los bordes de las pistolas de luz en sistemas específicos."

