"Automatically sets aspect ratio to 16/9 for games that natively support it. "
"2D elements like HUD/UI may be stretched."
msgstr ""
"Establece automáticamente una relación de aspecto de 16:9 en los juegos que "
"la admiten de forma nativa. Los elementos 2D, como la interfaz y el HUD, "
"pueden estirarse."

#. TRANSLATION: libretro/beetle-saturn, libretro/flycast, libretro/kronos, libretro/mupen64plus-next, libretro/parallel_n64, ...
msgctxt "game_options"
msgid "AUTO WIDESCREEN"
msgstr "PANTALLA ANCHA AUTOMÁTICA"

#. TRANSLATION: libretro/beetle-saturn, libretro/yabasanshiro
msgctxt "game_options"
msgid "Not all games support 3D pad."
msgstr "No todos los juegos son compatibles con el control 3D."

