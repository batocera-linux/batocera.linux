From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anton Bambura <jenneron@protonmail.com>
Date: Tue, 20 Oct 2026 01:39:21 +0300
Subject: [PATCH] boot: disable EFI runtime shutdown on sdm845

---
 Efi/Handover.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Efi/Handover.c b/Efi/Handover.c
index 49fe9e8..0f1639d 100644
--- a/Efi/Handover.c
+++ b/Efi/Handover.c
@@ -476,7 +476,9 @@ STATIC CONST struct {
   UINT32 ChipId;
   UINT32 Unsupported;
 } mRuntimeGaps[] = {
-  {321, RT_NO_VMAP},
+  // EFI runtime shutdown is broken on SDM845.
+  // Let kernel use PSCI for reset/shutdown.
+  {321, RT_NO_VMAP | UEFI_RT_RESET_SYSTEM},
   {341, RT_NO_VMAP},
   {444, UEFI_RT_ALL},
   {467, RT_NO_VMAP},
