#!/bin/sh

case "$1" in
    start)
        [ "$(cat /boot/boot/batocera.board 2>/dev/null)" = "fun-r1" ] || exit 0
        # 1 = BACK is BTN_BACK, 2 = BACK is the 2P coin
        BACK_MODE=1
        if [ "$(/usr/bin/batocera-settings-get controllers.fun-r1-gamepad.back-is-2p-coin)" = "2" ]; then
            BACK_MODE=2
        fi
        /usr/bin/fun_r1_gamepad "$BACK_MODE" &
        ;;
    stop)
        killall fun_r1_gamepad >/dev/null 2>&1
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
