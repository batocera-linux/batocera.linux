config BR2_PACKAGE_FIRMWARE_ARMBIAN
	bool "firmware-armbian"
	help
	  Armbian firmware repository to support various boards
	  to work correctly with the Linux kernel.

	  https://github.com/armbian/firmware

config BR2_PACKAGE_FIRMWARE_ARMBIAN_FILES
	string "files to install"
	depends on BR2_PACKAGE_FIRMWARE_ARMBIAN
	help
	  Space-separated paths in the repository to install.
	  Leave empty to install the whole repository.
