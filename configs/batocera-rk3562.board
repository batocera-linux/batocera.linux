include batocera-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_RK3562=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_TARGET_GENERIC_GETTY_PORT="/dev/ttyFIQ0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/rk3562/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/rk3562/fsoverlay"

# Linux headers same as kernel, a 6.1 series
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/retro98boy/armbian-linux-rockchip.git"
# Branch: kickpi-k3b, Commit date: Aug 2, 2026
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="c9befde862529479d8652ff3b7404a26e80385c3"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/rk3562/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/rockchip/rk3562/linux-defconfig.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Build the DTB from the kernel sources
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3562-kickpi-k3b"
# Support DTB overlays
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y

# Bootloader
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_UBOOT_RK3562=y

# System
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_PACKAGE_BATOCERA_KODI21=y

# GPU
BR2_PACKAGE_BATOCERA_PANFROST_MESA3D=y

# Enable Wayland & XWayland
BR2_PACKAGE_BATOCERA_WAYLAND_LABWC=y
BR2_PACKAGE_BATOCERA_XWAYLAND=y

# Firmware
# KICKPI K3B specific WiFi/BT firmware
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# KICKPI K3B specific WiFi/BT driver
BR2_PACKAGE_SEEKWAVE_SWT6621S=y

# Show a nice movie at bootup
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y
