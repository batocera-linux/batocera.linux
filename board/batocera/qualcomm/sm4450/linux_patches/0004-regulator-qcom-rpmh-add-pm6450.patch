From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] regulator: qcom-rpmh: add PM6450 regulators

Confirmed required on hardware Retroid Pocket Classic

--- a/drivers/regulator/qcom-rpmh-regulator.c
+++ b/drivers/regulator/qcom-rpmh-regulator.c
@@ -1478,6 +1478,45 @@
 	RPMH_VREG("ldo22",  LDO,  22, &pmic5_nldo,      NULL),
 };
 
+static const struct rpmh_vreg_init_data pm6450_vreg_data[] = {
+	/* smps1, smps5, smps6 are ARC-managed (mss.lvl, cx.lvl, ebi.lvl) */
+	RPMH_VREG("smps7",  SMPS, 7,  &pmic5_hfsmps515, NULL),
+	RPMH_VREG("smps8",  SMPS, 8,  &pmic5_hfsmps515, NULL),
+	RPMH_VREG("smps9",  SMPS, 9,  &pmic5_hfsmps515, NULL),
+	RPMH_VREG("ldo1",   LDO,  1,  &pmic5_nldo,      NULL),
+	/* ldo2 is ARC-managed (lcx.lvl) */
+	RPMH_VREG("ldo3",   LDO,  3,  &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo4",   LDO,  4,  &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo5",   LDO,  5,  &pmic5_nldo,      NULL),
