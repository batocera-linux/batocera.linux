+	RPMH_VREG("ldo7",   LDO,  7,  &pmic5_nldo,      NULL),
+	/* ldo8 is ARC-managed (lmx.lvl) */
+	RPMH_VREG("ldo9",   LDO,  9,  &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo10",  LDO,  10, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo11",  LDO,  11, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo12",  LDO,  12, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo13",  LDO,  13, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo14",  LDO,  14, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo15",  LDO,  15, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo16",  LDO,  16, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo17",  LDO,  17, &pmic5_nldo,      NULL),
+	RPMH_VREG("ldo18",  LDO,  18, &pmic5_pldo_lv,   NULL),
+	RPMH_VREG("ldo19",  LDO,  19, &pmic5_pldo_lv,   NULL),
+	RPMH_VREG("ldo20",  LDO,  20, &pmic5_pldo_lv,   NULL),
+	RPMH_VREG("ldo21",  LDO,  21, &pmic5_pldo_lv,   NULL),
+	RPMH_VREG("ldo22",  LDO,  22, &pmic5_pldo_lv,   NULL),
+	RPMH_VREG("ldo23",  LDO,  23, &pmic5_pldo_lv,   NULL),
+	RPMH_VREG("ldo24",  LDO,  24, &pmic5_pldo,      NULL),
+	RPMH_VREG("ldo25",  LDO,  25, &pmic5_pldo,      NULL),
+	RPMH_VREG("ldo26",  LDO,  26, &pmic5_pldo,      NULL),
+	RPMH_VREG("ldo27",  LDO,  27, &pmic5_pldo,      NULL),
+	RPMH_VREG("ldo28",  LDO,  28, &pmic5_pldo,      NULL),
+	/* PBS trigger resources sequencing the SD card rails */
+	{ .name = "pbs_sd",  .resource_name = "vrm.sd",  .hw_data = &pmic5_pbs },
+	{ .name = "pbs_px2", .resource_name = "vrm.px2", .hw_data = &pmic5_pbs },
+	{}
+};
+
 static const struct rpmh_vreg_init_data pmcx0102_vreg_data[] = {
 	RPMH_VREG("smps1",   SMPS, 1,    &pmic5_ftsmps530, "vdd-s1"),
 	RPMH_VREG("smps2",   SMPS, 2,    &pmic5_ftsmps530, "vdd-s2"),
@@ -1898,6 +1933,10 @@
 		.data = pm6350_vreg_data,
 	},
 	{
+		.compatible = "qcom,pm6450-rpmh-regulators",
+		.data = pm6450_vreg_data,
+	},
+	{
 		.compatible = "qcom,pmc8180-rpmh-regulators",
 		.data = pm8150_vreg_data,
 	},
