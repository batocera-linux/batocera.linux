From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Martin <dmanlfc@gmail.com>
Date: Tue, 22 Sep 2026 23:30:00 +0100
Subject: [PATCH] arm64: dts: qcom: sm4450: add CPU capacity and power coefficients

Without capacity-dmips-mhz the scheduler sees the six Cortex-A55 and two
Cortex-A78 cores as equal and may leave a heavy thread on an A55. Add
the capacity and dynamic-power-coefficient values sm6350 uses for its
A55/A7x clusters.

--- a/arch/arm64/boot/dts/qcom/sm4450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm4450.dtsi
@@ -52,6 +52,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a55";
 			reg = <0x0 0x0>;
+			capacity-dmips-mhz = <1024>;
+			dynamic-power-coefficient = <100>;
 			clocks = <&cpufreq_hw 0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
@@ -78,6 +80,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a55";
 			reg = <0x0 0x100>;
+			capacity-dmips-mhz = <1024>;
+			dynamic-power-coefficient = <100>;
 			clocks = <&cpufreq_hw 0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_100>;
@@ -98,6 +102,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a55";
 			reg = <0x0 0x200>;
+			capacity-dmips-mhz = <1024>;
+			dynamic-power-coefficient = <100>;
 			clocks = <&cpufreq_hw 0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_200>;
@@ -118,6 +124,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a55";
 			reg = <0x0 0x300>;
+			capacity-dmips-mhz = <1024>;
+			dynamic-power-coefficient = <100>;
 			clocks = <&cpufreq_hw 0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_300>;
@@ -138,6 +146,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a55";
 			reg = <0x0 0x400>;
+			capacity-dmips-mhz = <1024>;
+			dynamic-power-coefficient = <100>;
 			clocks = <&cpufreq_hw 0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_400>;
@@ -158,6 +168,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a55";
 			reg = <0x0 0x500>;
+			capacity-dmips-mhz = <1024>;
+			dynamic-power-coefficient = <100>;
 			clocks = <&cpufreq_hw 0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_500>;
@@ -178,6 +190,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a78";
 			reg = <0x0 0x600>;
+			capacity-dmips-mhz = <1894>;
+			dynamic-power-coefficient = <703>;
 			clocks = <&cpufreq_hw 1>;
 			enable-method = "psci";
 			next-level-cache = <&l2_600>;
@@ -198,6 +212,8 @@
 			device_type = "cpu";
 			compatible = "arm,cortex-a78";
 			reg = <0x0 0x700>;
+			capacity-dmips-mhz = <1894>;
+			dynamic-power-coefficient = <703>;
 			clocks = <&cpufreq_hw 1>;
 			enable-method = "psci";
 			next-level-cache = <&l2_700>;
