From: Philippe Simons <simons.philippe@gmail.com>
Subject: [PATCH] ASoC: qcom: sc8280xp: add MI2S clock and format support

Let the sndcard machine driver take an optional "i2s_clk" card clock and
enable it around MI2S streams, setting provider/consumer I2S formats on
the CPU DAI and every codec DAI sharing the bus. Needed for AudioReach
cards whose speaker amplifiers hang off an MI2S bus with the IBIT clock
supplied by q6prmcc.

ROCKNIX: added the senary case, scoped to the RP Classic by card name.
That board drives both of its amps from one channel; forcing mono for
every board using this driver leaves the RG55G1's MFC and I2S endpoint
at a single channel, so both of its amps reproduce the left sample.
---
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -2,6 +2,8 @@
 // Copyright (c) 2022, Linaro Limited
 
 #include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/string.h>
 #include <sound/soc.h>
@@ -20,6 +22,7 @@
 	struct snd_soc_card *card;
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
+	struct clk *i2s_clk;
 	bool jack_setup;
 };
 
@@ -67,6 +70,50 @@
 	return qcom_snd_wcd_jack_setup(rtd, &data->jack, &data->jack_setup);
 }
 
+static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
+{
+	unsigned int fmt = SND_SOC_DAIFMT_BP_FP;
+	unsigned int codec_dai_fmt = SND_SOC_DAIFMT_BC_FC | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	int i;
+
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX:
+	case SENARY_MI2S_RX:
+		clk_prepare_enable(pdata->i2s_clk);
+		snd_soc_dai_set_fmt(cpu_dai, fmt);
+		/* All codecs sharing the bus need the same format */
+		for_each_rtd_codec_dais(rtd, i, codec_dai)
+			snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		break;
+	default:
+		break;
+	}
+
+	return qcom_snd_sdw_startup(substream);
+}
+
+static void sc8280xp_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
+
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX:
+	case SENARY_MI2S_RX:
+		clk_disable_unprepare(pdata->i2s_clk);
+		break;
+	default:
+		break;
+	}
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
@@ -82,6 +129,18 @@
 	channels->min = 2;
 	channels->max = 2;
 	switch (cpu_dai->id) {
+	case SENARY_MI2S_RX:
+		/*
+		 * The Retroid Pocket Classic drives both of its amps from one
+		 * channel. Everything else on this port is stereo, and forcing
+		 * mono there leaves the MFC and the I2S endpoint configured for
+		 * a single channel, so both amps reproduce the left one.
+		 */
+		if (!strcmp(rtd->card->name, "RetroidPocketClassic")) {
+			channels->min = 1;
+			channels->max = 1;
+		}
+		break;
 	case TX_CODEC_DMA_TX_0:
 	case TX_CODEC_DMA_TX_1:
 	case TX_CODEC_DMA_TX_2:
@@ -115,8 +177,8 @@
 }
 
 static const struct snd_soc_ops sc8280xp_be_ops = {
-	.startup = qcom_snd_sdw_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.startup = sc8280xp_snd_startup,
+	.shutdown = sc8280xp_snd_shutdown,
 	.hw_free = sc8280xp_snd_hw_free,
 	.prepare = sc8280xp_snd_prepare,
 };
@@ -158,6 +220,10 @@
 	if (ret)
 		return ret;
 
+	data->i2s_clk = devm_clk_get_optional(dev, "i2s_clk");
+	if (IS_ERR(data->i2s_clk))
+		return dev_err_probe(dev, PTR_ERR(data->i2s_clk), "unable to get i2s clock\n");
+
 	card->driver_name = of_device_get_match_data(dev);
 	sc8280xp_add_be_ops(card);
 	return devm_snd_soc_register_card(dev, card);
