From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] drm/panel: chipwealth-ch13726a: per-rate frame-memory path, vendor timings, Retroid Pocket Classic

The DDIC routes video through its frame memory (B9=0x11) at 120 Hz and
bypasses it (B9=0x00) at 60 Hz; the vendor selects this per refresh rate
and driving 120 Hz in bypass mode washes the image out. Pick the path from
the mode the CRTC is programmed for. Add the sleep-out/display-on/sleep-in
delays and the power-to-reset gap from the vendor device trees, and a
Retroid Pocket Classic compatible (same module as the Thor bottom panel,
60 Hz preferred, 120 Hz selectable).

---
diff -Nur a/Documentation/devicetree/bindings/display/panel/chipwealth,ch13726a.yaml b/Documentation/devicetree/bindings/display/panel/chipwealth,ch13726a.yaml
--- a/Documentation/devicetree/bindings/display/panel/chipwealth,ch13726a.yaml	2026-09-05 14:10:58
+++ b/Documentation/devicetree/bindings/display/panel/chipwealth,ch13726a.yaml	2026-09-05 14:10:58
@@ -19,7 +19,9 @@
 properties:
   compatible:
     items:
-      - const: ayntec,thor-panel-bottom
+      - enum:
+          - ayntec,thor-panel-bottom
+          - retroid,pocket-classic-panel
       - const: chipwealth,ch13726a
 
   reg:
diff -Nur a/drivers/gpu/drm/panel/panel-chipwealth-ch13726a.c b/drivers/gpu/drm/panel/panel-chipwealth-ch13726a.c
--- a/drivers/gpu/drm/panel/panel-chipwealth-ch13726a.c	2026-09-05 14:10:58
+++ b/drivers/gpu/drm/panel/panel-chipwealth-ch13726a.c	2026-09-05 15:22:07
@@ -12,7 +12,10 @@
 #include <linux/regulator/consumer.h>
 
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
 #include <drm/drm_modes.h>
+#include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
 
 #include <video/mipi_display.h>
@@ -31,6 +34,7 @@
 	struct gpio_desc *reset_gpio;
 	struct ch13726a_desc *desc;
 	enum drm_panel_orientation orientation;
+	struct drm_connector *connector;
 };
 
 struct ch13726a_desc {
@@ -57,18 +61,41 @@
 	usleep_range(10000, 11000);
 }
 
+static const struct drm_display_mode *ch13726a_current_mode(struct ch13726a_panel *ctx)
+{
+	struct drm_connector *connector = ctx->connector;
+	const struct drm_crtc_state *crtc_state;
+	unsigned int i;
+
+	if (!connector || !connector->state || !connector->state->crtc)
+		return &ctx->desc->modes[0];
+
+	crtc_state = connector->state->crtc->state;
+	for (i = 0; i < ctx->desc->num_modes; i++)
+		if (drm_mode_match(&crtc_state->mode, &ctx->desc->modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return &ctx->desc->modes[i];
+
+	return &ctx->desc->modes[0];
+}
+
 static int ch13726a_on(struct ch13726a_panel *ctx)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
 	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf0, 0x50);
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb9, 0x00);
+	if (drm_mode_vrefresh(ch13726a_current_mode(ctx)) >= 110)
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb9, 0x11);
+	else
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb9, 0x00);
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
 
 	return dsi_ctx.accum_err;
 }
@@ -83,6 +113,7 @@
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 50);
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
 
 	return dsi_ctx.accum_err;
 }
@@ -99,6 +130,7 @@
 		return ret;
 	}
 
+	msleep(20);
 	ch13726a_reset(ctx);
 
 	ret = ch13726a_on(ctx);
@@ -159,11 +191,48 @@
 	.bpc = 8,
 };
 
+static const struct drm_display_mode rp_classic_modes[] = {
+	{
+		/* 60Hz */
+		.clock = (1080 + 28 + 4 + 36) * (1240 + 16 + 4 + 8) * 60 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 28,
+		.hsync_end = 1080 + 28 + 4,
+		.htotal = 1080 + 28 + 4 + 36,
+		.vdisplay = 1240,
+		.vsync_start = 1240 + 16,
+		.vsync_end = 1240 + 16 + 4,
+		.vtotal = 1240 + 16 + 4 + 8,
+	},
+	{
+		/* 120Hz */
+		.clock = (1080 + 28 + 4 + 36) * (1240 + 16 + 4 + 8) * 120 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 28,
+		.hsync_end = 1080 + 28 + 4,
+		.htotal = 1080 + 28 + 4 + 36,
+		.vdisplay = 1240,
+		.vsync_start = 1240 + 16,
+		.vsync_end = 1240 + 16 + 4,
+		.vtotal = 1240 + 16 + 4 + 8,
+	}
+};
+
+static struct ch13726a_desc rp_classic_desc = {
+	.modes = rp_classic_modes,
+	.num_modes = ARRAY_SIZE(rp_classic_modes),
+	.width_mm = 65,
+	.height_mm = 75,
+	.bpc = 8,
+};
+
 static int ch13726a_get_modes(struct drm_panel *panel,
 					struct drm_connector *connector)
 {
 	struct ch13726a_panel *ctx = to_ch13726a_panel(panel);
 
+	ctx->connector = connector;
+
 	for (uint8_t i = 0; i < ctx->desc->num_modes; i++) {
 		const struct drm_display_mode *m = &ctx->desc->modes[i];
 		struct drm_display_mode *mode;
@@ -315,6 +385,7 @@
 
 static const struct of_device_id ch13726a_of_match[] = {
 	{ .compatible = "ayntec,thor-panel-bottom", .data = &thor_bottom_desc },
+	{ .compatible = "retroid,pocket-classic-panel", .data = &rp_classic_desc },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, ch13726a_of_match);
