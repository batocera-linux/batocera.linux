+	.hsync_start = 1080 + 28,
+	.hsync_end = 1080 + 28 + 12,
+	.htotal = 1136,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 44,
+	.vsync_end = 1920 + 44 + 5,
+	.vtotal = 1974,
