From 2084a7d5bc09a7377cce054e3552ff0d9d0e6a70 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@gmail.com>
Date: Sat, 26 Sep 2026 19:07:35 -0500
Subject: [PATCH] gpu: drm: panel: hx83112a: add Retroid Pocket Duo Lite
 variant

Move the init sequence, mode, DSI flags and supplies into per-panel data
and add the Duo Lite top panel. It shares most of the Mangmi Air X init
but has its own CF, digital gamma and timings, runs in non-burst
sync-event mode and takes an extra 2.8V VCI supply.
---
 drivers/gpu/drm/panel/panel-hx83112a.c | 228 +++++++++++++++++++++++--
 1 file changed, 212 insertions(+), 16 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-hx83112a.c b/drivers/gpu/drm/panel/panel-hx83112a.c
index 41173a1..a8973cc 100644
--- a/drivers/gpu/drm/panel/panel-hx83112a.c
+++ b/drivers/gpu/drm/panel/panel-hx83112a.c
@@ -16,21 +16,39 @@
 #include <drm/drm_panel.h>
 #include <drm/drm_probe_helper.h>
 
+struct hx83112a;
+
+struct hx83112a_desc {
+	const struct drm_display_mode *mode;
+	unsigned long mode_flags;
+	const struct regulator_bulk_data *supplies;
+	unsigned int num_supplies;
+	int (*init)(struct hx83112a *ctx);
