+	.init = rp_duo_lite_init,
+};
+
 static int hx83112a_get_modes(struct drm_panel *panel,
 			      struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &hx83112a_mode);
+	struct hx83112a *ctx = to_hx83112a(panel);
+
+	return drm_connector_helper_get_modes_fixed(connector, ctx->desc->mode);
 }
 
 static enum drm_panel_orientation hx83112a_get_orientation(struct drm_panel *panel)
@@ -296,8 +491,10 @@ static int hx83112a_probe(struct mipi_dsi_device *dsi)
