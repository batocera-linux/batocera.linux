+
+static const struct hx83112a_desc rp_duo_lite_desc = {
+	.mode = &rp_duo_lite_mode,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS,
