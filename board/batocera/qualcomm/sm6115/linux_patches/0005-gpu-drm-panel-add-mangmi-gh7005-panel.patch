Subject: [PATCH] drm/panel: add the Mangmi GH7005 1280x960 DSI panel

IPS panel of the Mangmi Air Y. 

---
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 1e9eead..101f9b5 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -540,6 +540,15 @@ config DRM_PANEL_MANGMI_BM5460BB1
 	  Say Y here if you want to enable support for BM5460BB1
 	  display panels, such as the one found in the Fairphone 4 smartphone.
 
+config DRM_PANEL_MANGMI_GH7005
+	tristate "Mangmi GH7005 DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the GH7005 1280x960
+	  video-mode DSI panel found in the Mangmi Air Y.
+
 config DRM_PANEL_MANGMI_TD4310
 	tristate "Mangmi TD4310 DSI panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index db55eb3..a8296ce 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -53,6 +53,7 @@ obj-$(CONFIG_DRM_PANEL_LXD_M9189A) += panel-lxd-m9189a.o
 obj-$(CONFIG_DRM_PANEL_MAGNACHIP_D53E6EA8966) += panel-magnachip-d53e6ea8966.o
 obj-$(CONFIG_DRM_PANEL_MANGMI_HX83112A) += panel-hx83112a.o
 obj-$(CONFIG_DRM_PANEL_MANGMI_BM5460BB1) += panel-bm5460bb1.o
+obj-$(CONFIG_DRM_PANEL_MANGMI_GH7005) += panel-gh7005.o
 obj-$(CONFIG_DRM_PANEL_MANGMI_TD4310) += panel-td4310.o
 obj-$(CONFIG_DRM_PANEL_MOTOROLA_MOT) += panel-motorola-mot.o
 obj-$(CONFIG_DRM_PANEL_NEC_NL8048HL11) += panel-nec-nl8048hl11.o
diff --git a/drivers/gpu/drm/panel/panel-gh7005.c b/drivers/gpu/drm/panel/panel-gh7005.c
new file mode 100644
index 0000000..e5a97f1
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-gh7005.c
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct gh7005 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *vdd1;
+	struct regulator *vsp;
+	struct regulator *vsn;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+	enum drm_panel_orientation orientation;
+};
+
+static const struct { u8 reg, val; } gh7005_init[] = {
+	{ 0xee, 0x01 }, { 0xea, 0x07 }, { 0xeb, 0x12 }, { 0x05, 0x19 }, { 0x0a, 0x85 }, { 0x14, 0x58 },
+	{ 0x15, 0x58 }, { 0x17, 0x32 }, { 0x28, 0x1f }, { 0x29, 0x29 }, { 0x2a, 0x63 }, { 0x2f, 0xf3 },
+	{ 0xee, 0x02 }, { 0x39, 0x6f }, { 0x00, 0x00 }, { 0x01, 0x10 }, { 0x02, 0x18 }, { 0x03, 0x09 },
+	{ 0x04, 0x10 }, { 0x05, 0x42 }, { 0x06, 0x0b }, { 0x07, 0x0c }, { 0x08, 0x0c }, { 0x09, 0x0b },
+	{ 0x0a, 0x0f }, { 0x0b, 0x5f }, { 0x0c, 0x16 }, { 0x0d, 0x1e }, { 0x0e, 0x3a }, { 0x0f, 0x3d },
+	{ 0x10, 0x3f }, { 0x20, 0x00 }, { 0x21, 0x10 }, { 0x22, 0x18 }, { 0x23, 0x09 }, { 0x24, 0x10 },
+	{ 0x25, 0x42 }, { 0x26, 0x0b }, { 0x27, 0x0c }, { 0x28, 0x0c }, { 0x29, 0x0b }, { 0x2a, 0x0f },
+	{ 0x2b, 0x5f }, { 0x2c, 0x16 }, { 0x2d, 0x1e }, { 0x2e, 0x3a }, { 0x2f, 0x3d }, { 0x30, 0x3f },
+	{ 0xee, 0x04 }, { 0x00, 0x01 }, { 0x01, 0x01 }, { 0x02, 0xe0 }, { 0x03, 0x05 }, { 0x04, 0x00 },
+	{ 0x06, 0x14 }, { 0x07, 0x05 }, { 0x08, 0x12 }, { 0x09, 0x20 }, { 0x0a, 0x0f }, { 0x0b, 0x00 },
+	{ 0x20, 0x40 }, { 0x2a, 0x00 }, { 0x40, 0x80 }, { 0x41, 0x60 }, { 0xee, 0x05 }, { 0x00, 0x05 },
+	{ 0x01, 0x09 }, { 0x02, 0x05 }, { 0x03, 0x05 }, { 0x07, 0x01 }, { 0x08, 0x05 }, { 0x09, 0x00 },
+	{ 0x10, 0x08 }, { 0x11, 0x0c }, { 0x12, 0x25 }, { 0x13, 0x05 }, { 0x19, 0x90 }, { 0x1a, 0x77 },
+	{ 0x23, 0x00 }, { 0x30, 0x01 }, { 0x31, 0x01 }, { 0x32, 0x00 }, { 0x33, 0x14 }, { 0x34, 0x14 },
+	{ 0x35, 0xb4 }, { 0x36, 0x01 }, { 0x37, 0x01 }, { 0x38, 0x00 }, { 0x39, 0x14 }, { 0x3a, 0x14 },
+	{ 0x40, 0x00 }, { 0x41, 0x00 }, { 0x43, 0x11 }, { 0x44, 0x01 }, { 0x45, 0x81 }, { 0x46, 0x06 },
+	{ 0x47, 0x03 }, { 0xee, 0x06 }, { 0x00, 0x23 }, { 0x01, 0x01 }, { 0x02, 0x04 }, { 0x06, 0xcd },
+	{ 0x08, 0x67 }, { 0x09, 0x45 }, { 0x0a, 0x23 }, { 0x0b, 0x01 }, { 0xee, 0x07 }, { 0x00, 0x14 },
+	{ 0x01, 0x14 }, { 0x02, 0x16 }, { 0x03, 0x16 }, { 0x04, 0x10 }, { 0x05, 0x10 }, { 0x06, 0x12 },
+	{ 0x07, 0x12 }, { 0x08, 0x0d }, { 0x09, 0x0d }, { 0x0a, 0x00 }, { 0x0b, 0x00 }, { 0x0c, 0x0c },
+	{ 0x0d, 0x0c }, { 0x0e, 0x04 }, { 0x0f, 0x04 }, { 0x10, 0x3c }, { 0x11, 0x3c }, { 0x12, 0x20 },
+	{ 0x13, 0x20 }, { 0x14, 0x21 }, { 0x15, 0x21 }, { 0x20, 0x15 }, { 0x21, 0x15 }, { 0x22, 0x17 },
+	{ 0x23, 0x17 }, { 0x24, 0x11 }, { 0x25, 0x11 }, { 0x26, 0x13 }, { 0x27, 0x13 }, { 0x28, 0x0d },
+	{ 0x29, 0x0d }, { 0x2a, 0x01 }, { 0x2b, 0x01 }, { 0x2c, 0x0c }, { 0x2d, 0x0c }, { 0x2e, 0x04 },
+	{ 0x2f, 0x04 }, { 0x30, 0x3c }, { 0x31, 0x3c }, { 0x32, 0x20 }, { 0x33, 0x20 }, { 0x34, 0x21 },
+	{ 0x35, 0x21 }, { 0xee, 0x08 }, { 0x12, 0xda }, { 0x13, 0x9b }, { 0x18, 0x00 }, { 0x20, 0x00 },
+	{ 0x2c, 0x20 }, { 0x4b, 0xa0 }, { 0x61, 0x20 }, { 0xee, 0x0f }, { 0x00, 0x01 }, { 0xee, 0x00 },
+	{ 0xea, 0x00 }, { 0xeb, 0x00 }, { 0x36, 0x00 },
+};
+
+static inline struct gh7005 *to_gh7005(struct drm_panel *panel)
+{
+	return container_of(panel, struct gh7005, panel);
+}
+
+static int gh7005_write(struct gh7005 *ctx, u8 reg, u8 val)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	const u8 buf[2] = { reg, val };
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.tx_buf = buf,
+		.tx_len = sizeof(buf),
+		.flags = MIPI_DSI_MSG_USE_LPM,
+	};
+	ssize_t ret;
+
+	ret = dsi->host->ops->transfer(dsi->host, &msg);
+
+	return ret < 0 ? ret : 0;
+}
+
+static void gh7005_power_off(struct gh7005 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(20);
+	regulator_disable(ctx->vsn);
+	msleep(20);
+	regulator_disable(ctx->vsp);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	regulator_disable(ctx->vdd1);
+}
+
+static int gh7005_power_on(struct gh7005 *ctx)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->vdd1);
+	if (ret)
+		return ret;
+	msleep(20);
+
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	msleep(40);
+
+	ret = regulator_enable(ctx->vsp);
+	if (ret)
+		goto err_vdd1;
+	msleep(20);
+
+	ret = regulator_enable(ctx->vsn);
+	if (ret)
+		goto err_vsp;
+	msleep(30);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(10);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(10);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(10);
+
+	return 0;
+
+err_vsp:
+	regulator_disable(ctx->vsp);
+err_vdd1:
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	regulator_disable(ctx->vdd1);
+	return ret;
+}
+
+static int gh7005_prepare(struct drm_panel *panel)
+{
+	struct gh7005 *ctx = to_gh7005(panel);
+	struct device *dev = &ctx->dsi->dev;
+	unsigned int i;
+	int ret;
+
+	backlight_disable(panel->backlight);
+
+	ret = gh7005_power_on(ctx);
+	if (ret) {
+		dev_err(dev, "failed to power on: %d\n", ret);
+		return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(gh7005_init); i++) {
+		ret = gh7005_write(ctx, gh7005_init[i].reg, gh7005_init[i].val);
+		if (ret) {
+			dev_err(dev, "init write %u (0x%02x) failed: %d\n",
+				i, gh7005_init[i].reg, ret);
+			goto err;
+		}
+	}
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(ctx->dsi);
+	if (ret) {
+		dev_err(dev, "exit sleep failed: %d\n", ret);
+		goto err;
+	}
+	msleep(200);
+
+	ret = mipi_dsi_dcs_set_display_on(ctx->dsi);
+	if (ret) {
+		dev_err(dev, "display on failed: %d\n", ret);
+		goto err;
+	}
+	msleep(120);
+
+	return 0;
+
+err:
+	gh7005_power_off(ctx);
+	return ret;
+}
+
+static int gh7005_unprepare(struct drm_panel *panel)
+{
+	struct gh7005 *ctx = to_gh7005(panel);
+
+	mipi_dsi_dcs_set_display_off(ctx->dsi);
+	msleep(120);
+	mipi_dsi_dcs_enter_sleep_mode(ctx->dsi);
+	msleep(120);
+
+	gh7005_power_off(ctx);
+
+	return 0;
+}
+
+static const struct drm_display_mode gh7005_mode = {
+	.clock = (1280 + 60 + 32 + 32) * (960 + 16 + 8 + 8) * 60 / 1000,
+	.hdisplay = 1280,
+	.hsync_start = 1280 + 60,
+	.hsync_end = 1280 + 60 + 32,
+	.htotal = 1280 + 60 + 32 + 32,
+	.vdisplay = 960,
+	.vsync_start = 960 + 16,
+	.vsync_end = 960 + 16 + 8,
+	.vtotal = 960 + 16 + 8 + 8,
+	.width_mm = 84,
+	.height_mm = 63,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int gh7005_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &gh7005_mode);
+}
+
+static enum drm_panel_orientation gh7005_get_orientation(struct drm_panel *panel)
+{
+	struct gh7005 *ctx = to_gh7005(panel);
+
+	return ctx->orientation;
+}
+
+static const struct drm_panel_funcs gh7005_funcs = {
+	.prepare = gh7005_prepare,
+	.unprepare = gh7005_unprepare,
+	.get_modes = gh7005_get_modes,
+	.get_orientation = gh7005_get_orientation,
+};
+
+static int gh7005_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct gh7005 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct gh7005, panel, &gh7005_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vdd1 = devm_regulator_get(dev, "vdd1");
+	if (IS_ERR(ctx->vdd1))
+		return dev_err_probe(dev, PTR_ERR(ctx->vdd1), "failed to get vdd1\n");
+
+	ctx->vsp = devm_regulator_get(dev, "vsp");
+	if (IS_ERR(ctx->vsp))
+		return dev_err_probe(dev, PTR_ERR(ctx->vsp), "failed to get vsp\n");
+
+	ctx->vsn = devm_regulator_get(dev, "vsn");
+	if (IS_ERR(ctx->vsn))
+		return dev_err_probe(dev, PTR_ERR(ctx->vsn), "failed to get vsn\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ctx->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "failed to get enable gpio\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		ctx->orientation = DRM_MODE_PANEL_ORIENTATION_UNKNOWN;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void gh7005_remove(struct mipi_dsi_device *dsi)
+{
+	struct gh7005 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id gh7005_of_match[] = {
+	{ .compatible = "mangmi,gh7005" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gh7005_of_match);
+
+static struct mipi_dsi_driver gh7005_driver = {
+	.probe = gh7005_probe,
+	.remove = gh7005_remove,
+	.driver = {
+		.name = "panel-gh7005",
+		.of_match_table = gh7005_of_match,
+	},
+};
+module_mipi_dsi_driver(gh7005_driver);
+
+MODULE_DESCRIPTION("GH7005 1280x960 DSI panel (Mangmi Air Y)");
+MODULE_LICENSE("GPL");
