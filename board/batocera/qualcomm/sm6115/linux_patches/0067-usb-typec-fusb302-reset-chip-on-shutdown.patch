Subject: [PATCH] usb: typec: fusb302: reset the chip on shutdown

The AW35615 vendor driver soft-resets the port controller at shutdown so
that no source or OTG role is left configured across a power cycle.

---
diff --git a/drivers/usb/typec/tcpm/fusb302.c b/drivers/usb/typec/tcpm/fusb302.c
index 0011fe4..f40f82f 100644
--- a/drivers/usb/typec/tcpm/fusb302.c
+++ b/drivers/usb/typec/tcpm/fusb302.c
@@ -1858,6 +1858,19 @@ static const struct dev_pm_ops fusb302_pm_ops = {
 	.resume = fusb302_pm_resume,
 };
 
+static void fusb302_shutdown(struct i2c_client *client)
+{
+	struct fusb302_chip *chip = i2c_get_clientdata(client);
+
+	disable_irq(chip->gpio_int_n_irq);
+	cancel_work_sync(&chip->irq_work);
+	cancel_delayed_work_sync(&chip->bc_lvl_handler);
+
+	mutex_lock(&chip->lock);
+	fusb302_sw_reset(chip);
+	mutex_unlock(&chip->lock);
+}
+
 static struct i2c_driver fusb302_driver = {
 	.driver = {
 		   .name = "typec_fusb302",
@@ -1866,6 +1879,7 @@ static struct i2c_driver fusb302_driver = {
 		   },
 	.probe = fusb302_probe,
 	.remove = fusb302_remove,
+	.shutdown = fusb302_shutdown,
 	.id_table = fusb302_i2c_device_id,
 };
 module_i2c_driver(fusb302_driver);
