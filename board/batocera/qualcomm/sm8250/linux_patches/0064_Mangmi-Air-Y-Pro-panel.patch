+
+static int mangmi_airy_off(struct mangmi_airy *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_usleep_range(&dsi_ctx, 10000, 11000);
+
+	return dsi_ctx.accum_err;
+}
+
+static int mangmi_airy_prepare(struct drm_panel *panel)
+{
+	struct mangmi_airy *ctx = to_mangmi_airy(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(mangmi_airy_logic_supplies),
+				    ctx->logic_supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable logic regulators: %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(5000, 6000);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(mangmi_airy_bias_supplies),
+				    ctx->bias_supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable bias regulators: %d\n", ret);
+		regulator_bulk_disable(ARRAY_SIZE(mangmi_airy_logic_supplies),
+				       ctx->logic_supplies);
+		return ret;
+	}
+
+	usleep_range(5000, 6000);
+
+	mangmi_airy_reset(ctx);
+
+	ret = mangmi_airy_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(mangmi_airy_bias_supplies),
+				       ctx->bias_supplies);
+		usleep_range(5000, 6000);
+		regulator_bulk_disable(ARRAY_SIZE(mangmi_airy_logic_supplies),
+				       ctx->logic_supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int mangmi_airy_unprepare(struct drm_panel *panel)
+{
+	struct mangmi_airy *ctx = to_mangmi_airy(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = mangmi_airy_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(mangmi_airy_bias_supplies),
+			       ctx->bias_supplies);
+	usleep_range(5000, 6000);
+	regulator_bulk_disable(ARRAY_SIZE(mangmi_airy_logic_supplies),
+			       ctx->logic_supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode mangmi_airy_mode = {
+	.clock = (1280 + 60 + 32 + 32) * (960 + 16 + 8 + 8) * 60 / 1000,
+	.hdisplay = 1280,
+	.hsync_start = 1280 + 60,
+	.hsync_end = 1280 + 60 + 32,
+	.htotal = 1280 + 60 + 32 + 32,
+	.vdisplay = 960,
+	.vsync_start = 960 + 16,
+	.vsync_end = 960 + 16 + 8,
+	.vtotal = 960 + 16 + 8 + 8,
+	.width_mm = 81,
+	.height_mm = 61,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int mangmi_airy_get_modes(struct drm_panel *panel,
+					 struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &mangmi_airy_mode);
+}
+
+static const struct drm_panel_funcs mangmi_airy_panel_funcs = {
+	.prepare = mangmi_airy_prepare,
+	.unprepare = mangmi_airy_unprepare,
+	.get_modes = mangmi_airy_get_modes,
+};
+
+static int mangmi_airy_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct mangmi_airy *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct mangmi_airy, panel,
+				   &mangmi_airy_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(mangmi_airy_logic_supplies),
+					    mangmi_airy_logic_supplies,
+					    &ctx->logic_supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "Failed to get logic regulators\n");
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(mangmi_airy_bias_supplies),
+					    mangmi_airy_bias_supplies,
+					    &ctx->bias_supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "Failed to get bias regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void mangmi_airy_remove(struct mipi_dsi_device *dsi)
+{
+	struct mangmi_airy *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id mangmi_airy_of_match[] = {
+	{ .compatible = "mangmi,air-y-pro-panel" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mangmi_airy_of_match);
+
+static struct mipi_dsi_driver mangmi_airy_driver = {
+	.probe = mangmi_airy_probe,
+	.remove = mangmi_airy_remove,
+	.driver = {
+		.name = "panel-mangmi-air-y-pro",
+		.of_match_table = mangmi_airy_of_match,
+	},
+};
+module_mipi_dsi_driver(mangmi_airy_driver);
+
+MODULE_AUTHOR("ROCKNIX");
+MODULE_DESCRIPTION("DRM driver for the MANGMI Air Y Pro panel");
+MODULE_LICENSE("GPL");
