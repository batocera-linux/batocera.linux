+/*
+ * MANGMI Air Y Pro panel ("viego 4inch", 1280x960 60Hz video mode).
+ *
+ * Generated with linux-mdss-dsi-panel-driver-generator from the vendor device
+ * tree, then adapted for the regulators and reset timing that tree describes
+ * outside the DSI command stream.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct mangmi_airy {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *logic_supplies;
+	struct regulator_bulk_data *bias_supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+/*
+ * Brought up first and torn down last: the panel wants its logic rails stable
+ * before the bias rails move in either direction.
+ */
+static const struct regulator_bulk_data mangmi_airy_logic_supplies[] = {
+	{ .supply = "vddio" }, { .supply = "disp" },
+};
+
+/*
+ * AVDD/AVEE. Both rails come out of one LCDB block behind a single enable bit
+ * and cannot be sequenced independently, so the panel takes the one supply the
+ * hardware actually offers rather than a pair it could not control separately.
+ */
+static const struct regulator_bulk_data mangmi_airy_bias_supplies[] = {
+	{ .supply = "lab" },
+};
+
+static inline
+struct mangmi_airy *to_mangmi_airy(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct mangmi_airy, panel);
+}
+
+static void mangmi_airy_reset(struct mangmi_airy *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
