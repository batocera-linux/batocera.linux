#!/bin/sh
#
# Start/stop the battery status LED monitor daemon
#

export LC_ALL=C

case "$(batocera-model 2>/dev/null)" in
    AYN_Odin_2|AYN_Odin_2_Mini|AYN_Odin_2_Portal|AYN_Thor) ;;
    *) exit 0 ;;
esac

DAEMON="/usr/bin/battery_led_status"
PIDFILE="/var/run/battery-led-status.pid"
LED="/sys/class/leds/power-led"

[ -d "${LED}" ] || exit 0

start() {
    echo -n "Starting battery LED monitor: "
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON"
    echo "OK"
}

stop() {
    echo -n "Stopping battery LED monitor: "
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    echo 0 > "${LED}/brightness"
    echo "OK"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
