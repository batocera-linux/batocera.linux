# -----------------------------------------------------------------------------
# AYN Thor dual-screen touchscreen calibration
# -----------------------------------------------------------------------------

# Top Screen (DSI-2)
SUBSYSTEM=="input", KERNEL=="event*", \
  ENV{ID_INPUT_TOUCHSCREEN}=="1", \
  ATTRS{name}=="top_touchscreen", \
  ENV{WL_OUTPUT}="DSI-2", \
  ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 0.5 0"

# Bottom Screen (DSI-1)
SUBSYSTEM=="input", KERNEL=="event*", \
  ENV{ID_INPUT_TOUCHSCREEN}=="1", \
  ATTRS{name}=="bottom_touchscreen", \
  ENV{WL_OUTPUT}="DSI-1", \
  ENV{LIBINPUT_CALIBRATION_MATRIX}="0.637397 0 0.177876 0 0.5 0.5"
