#!/bin/sh
#
# Battery LED status monitor for AYN sm8550 handhelds (Qualcomm LPG RGB power LED)
#
# Colours & Behaviours:
#   Green        = Normal (>20%)
#   Orange       = Warning (<=20% and >10%)
#   Red          = Low battery (<=10%)
#   Flash Red    = Critical battery (<=5%)
#   Flash Green  = Charging
#   Flash Orange = Fake Suspend active (on battery)
#   Flash Green  = Fake Suspend active (charging)
#   Flash Red    = Fake Suspend active (low battery <=10%)
#   Yellow       = Standby (real suspend)
#

LED="/sys/class/leds/power-led"

BAT_CAP="/sys/class/power_supply/battery/capacity"
BAT_STATUS="/sys/class/power_supply/battery/status"

THRESHOLD_WARNING=${THRESHOLD_WARNING:-20}
THRESHOLD_LOW=${THRESHOLD_LOW:-10}
THRESHOLD_CRITICAL=${THRESHOLD_CRITICAL:-5}
POLL_INTERVAL=${POLL_INTERVAL:-1}

MAX=$(cat "${LED}/max_brightness")

set_led() {
  echo "${1} ${2} ${3}" > "${LED}/multi_intensity" 2>/dev/null
}

led_green()  { set_led 0 "${MAX}" 0; }
led_red()    { set_led "${MAX}" 0 0; }
led_orange() { set_led "${MAX}" $((MAX / 5)) 0; }
led_yellow() { set_led "${MAX}" "${MAX}" 0; }
led_off()    { set_led 0 0 0; }

BLINK_TOGGLE=0

led_blink_red() {
  if [ "${BLINK_TOGGLE}" = "1" ]; then led_red; else led_off; fi
}

led_blink_green() {
  if [ "${BLINK_TOGGLE}" = "1" ]; then led_green; else led_off; fi
}

led_blink_orange() {
  if [ "${BLINK_TOGGLE}" = "1" ]; then led_orange; else led_off; fi
}

get_state() {
  local capacity=${1}
  if   [ "${capacity}" -le "${THRESHOLD_CRITICAL}" ]; then
    echo "blink_red"
  elif [ "${capacity}" -le "${THRESHOLD_LOW}" ]; then
    echo "red"
  elif [ "${capacity}" -le "${THRESHOLD_WARNING}" ]; then
    echo "orange"
  else
    echo "green"
  fi
}

echo none > "${LED}/trigger"
echo "${MAX}" > "${LED}/brightness"

# solid colour held through a real suspend, set by the pm sleep hook
if [ "$1" = "standby" ]; then
  led_yellow
  exit 0
fi

PREV_STATE=""

while true; do
  CAP=$(cat "${BAT_CAP}" 2>/dev/null || echo 100)
  STATUS=$(cat "${BAT_STATUS}" 2>/dev/null || echo "Discharging")

  if [ "${BLINK_TOGGLE}" = "1" ]; then
    BLINK_TOGGLE=0
  else
    BLINK_TOGGLE=1
  fi

  STATE=$(get_state "${CAP}")

  if [ "${STATUS}" = "Charging" ]; then
    STATE="blink_green"
  fi

  if [ -f "/var/run/batocera-fake-suspend.flag" ]; then
    if [ "${CAP}" -le "${THRESHOLD_LOW}" ]; then
      STATE="blink_red"
    elif [ "${STATUS}" = "Charging" ]; then
      STATE="blink_green"
    else
      STATE="blink_orange"
    fi
  fi

  case ${STATE} in
    blink_*) ;;
    "${PREV_STATE}") sleep ${POLL_INTERVAL}; continue ;;
  esac

  case ${STATE} in
    green)        led_green        ;;
    orange)       led_orange       ;;
    red)          led_red          ;;
    blink_red)    led_blink_red    ;;
    blink_green)  led_blink_green  ;;
    blink_orange) led_blink_orange ;;
  esac
  PREV_STATE="${STATE}"

  sleep ${POLL_INTERVAL}
done
