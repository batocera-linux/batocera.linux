From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Martin <dmanlfc@gmail.com>
Date: Thu, 22 Oct 2026 09:25:36 +1000
Subject: [PATCH] arm64: dts: allwinner: orangepi-3-lts: enable uwe5622 wifi

Power the AW859A module on mmc1 from the PH7 switch with PM3/PM4 as
reset lines, keep bldo3 up for the PM bank and wifi IO, derive the
wifi and bt addresses from the SoC SID through addr-mgt and add a
sprd,unisoc-wifi node so the driver loads from the device tree.

---
 .../allwinner/sun50i-h6-orangepi-3-lts.dts    | 48 +++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts b/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts
index a2d2c85..fac2fbb 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts
@@ -76,6 +76,36 @@
 		regulator-max-microvolt = <5000000>;
 		regulator-always-on;
 	};
+
+	reg_wifi_3v3: wifi-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "wifi-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpio = <&pio 7 7 GPIO_ACTIVE_HIGH>; /* PH7 */
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&rtc 1>;
+		clock-names = "ext_clock";
+		reset-gpios = <&r_pio 1 3 GPIO_ACTIVE_LOW>, /* PM3 */
+			      <&r_pio 1 4 GPIO_ACTIVE_LOW>; /* PM4 */
+		post-power-on-delay-ms = <200>;
+	};
+
+	/* wifi and bt addresses derived from the SoC SID */
+	addr-mgt {
+		compatible = "allwinner,sunxi-addr_mgt";
+		type_addr_wifi = <0x2>;
+		type_addr_bt = <0x2>;
+	};
+
+	/* lets udev load sprdwl_ng through its of alias */
+	unisoc-wifi {
+		compatible = "sprd,unisoc-wifi";
+	};
 };
 
 &cpu0 {
@@ -145,6 +175,19 @@
 	status = "okay";
 };
 
+&mmc1 {
+	vmmc-supply = <&reg_wifi_3v3>;
+	vqmmc-supply = <&reg_bldo3>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	bus-width = <4>;
+	non-removable;
+	status = "okay";
+
+	wifi@1 {
+		reg = <1>;
+	};
+};
+
 &mmc2 {
 	vmmc-supply = <&reg_cldo1>;
 	vqmmc-supply = <&reg_bldo2>;
@@ -228,6 +271,7 @@
 			};
 
 			reg_bldo3: bldo3 {
+				regulator-always-on;
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
 				regulator-name = "vcc-pm-pg-dcxoio-wifi";
@@ -289,6 +333,10 @@
 	};
 };
 
+&r_pio {
+	vcc-pm-supply = <&reg_bldo3>;
+};
+
 &rtc {
 	clocks = <&ext_osc32k>;
 };
-- 
