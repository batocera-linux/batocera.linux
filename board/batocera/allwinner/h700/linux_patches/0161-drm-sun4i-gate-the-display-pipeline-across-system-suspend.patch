From: Kailash <6493816+kailashrs@users.noreply.github.com>
Subject: [PATCH] drm/sun4i: gate the display pipeline across system suspend

Nothing released the DE, mixer, TCON or tcon-top clocks on the way into
suspend, so the whole display block stayed clocked while the system
slept. Suspend the modeset state first, then the TCON, then the engines,
unwinding in reverse if a step fails. The mixer saves its global control
and clock registers and drops RT_EN before its clocks go; the DE2 CCU and
tcon-top release their bus clocks in suspend_late. Gated on the DE33 and
H616 TCON compatibles, so other SoCs are unaffected.

Measured on RG34XX-SP in deep sleep: DE_CLK 0x80000000 -> 0, TCON_LCD0_CLK
0x80000000 -> 0, DE and TCON_LCD bus gates 0x00010001 -> 0x00010000.

Origin: kailashrs/H700_rocknix_enhancement 77df6bbdc
Assisted-by: Claude:claude-opus-5
---
--- a/drivers/clk/sunxi-ng/ccu-sun8i-de2.c
+++ b/drivers/clk/sunxi-ng/ccu-sun8i-de2.c
@@ -286,14 +286,64 @@
 	.writeable_reg	= sun8i_de2_ccu_regmap_accessible_reg,
 };
 
+struct sunxi_de2_clk_state {
+	struct clk *bus;
+	struct clk *mod;
+	bool system_pm;
+	bool suspended;
+};
+
+static int __maybe_unused sunxi_de2_clk_suspend_late(struct device *dev)
+{
+	struct sunxi_de2_clk_state *state = dev_get_drvdata(dev);
+
+	if (!state->system_pm || state->suspended)
+		return 0;
+
+	/* Normal DRM suspend has quiesced all consumers. Keep registers retained. */
+	clk_disable_unprepare(state->mod);
+	clk_disable_unprepare(state->bus);
+	state->suspended = true;
+	return 0;
+}
+
+static int __maybe_unused sunxi_de2_clk_resume_early(struct device *dev)
+{
+	struct sunxi_de2_clk_state *state = dev_get_drvdata(dev);
+	int ret;
+
+	if (!state->suspended)
+		return 0;
+	ret = clk_prepare_enable(state->bus);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(state->mod);
+	if (ret) {
+		clk_disable_unprepare(state->bus);
+		return ret;
+	}
+	state->suspended = false;
+	return 0;
+}
+
+static const struct dev_pm_ops sunxi_de2_clk_pm_ops = {
+	.suspend_late = pm_sleep_ptr(sunxi_de2_clk_suspend_late),
+	.resume_early = pm_sleep_ptr(sunxi_de2_clk_resume_early),
+};
+
 static int sunxi_de2_clk_probe(struct platform_device *pdev)
 {
 	struct clk *bus_clk, *mod_clk;
+	struct sunxi_de2_clk_state *state;
 	struct reset_control *rstc;
 	void __iomem *reg;
 	const struct sunxi_ccu_desc *ccu_desc;
 	int ret;
 
+	state = devm_kzalloc(&pdev->dev, sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+
 	ccu_desc = of_device_get_match_data(&pdev->dev);
 	if (!ccu_desc)
 		return -EINVAL;
@@ -358,6 +408,12 @@
 			goto err_assert_reset;
 	}
 
+	state->bus = bus_clk;
+	state->mod = mod_clk;
+	state->system_pm = of_device_is_compatible(pdev->dev.of_node,
+						 "allwinner,sun50i-h616-de33-clk");
+	platform_set_drvdata(pdev, state);
+
 	ret = devm_sunxi_ccu_probe(&pdev->dev, reg, ccu_desc);
 	if (ret)
 		goto err_assert_reset;
@@ -414,6 +470,7 @@
 	.probe	= sunxi_de2_clk_probe,
 	.driver	= {
 		.name	= "sunxi-de2-clks",
+		.pm	= pm_sleep_ptr(&sunxi_de2_clk_pm_ops),
 		.of_match_table	= sunxi_de2_clk_ids,
 	},
 };
