From: Kailash <6493816+kailashrs@users.noreply.github.com>
Subject: [PATCH] pinctrl: sunxi: release the LCD0 pads while the panel is off

Vendor firmware selects an "lcd0_suspend" pin function over PD0-PD27 when
the LCD goes down: mux 7, pads disabled, no bias, so nothing is driven
into a panel whose rail has been removed. Mainline never exposed mux 7 on
this SoC. Add it as "io_disabled" on PD0-PD27, give the H616 dtsi a
matching lcd0_suspend_pins group, and let panel-mipi select the board's
"sleep" pinctrl state in unprepare and the default state in prepare; both
are no-ops on boards without a sleep state.

Measured on RG34XX-SP in deep sleep: PD_CFG0-2 0x22222222 -> 0x77777777,
PD_CFG3 0x00022222 -> 0x00027777, PD28 (pwm0) untouched.

Origin: kailashrs/H700_rocknix_enhancement af90bc4cd
Assisted-by: Claude:claude-opus-5
---
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -429,6 +429,20 @@
 				function = "lcd0";
 			};
 
+			/* Pad buffers off, no bias: nothing driven into an unpowered panel. */
+			/omit-if-no-ref/
+			lcd0_suspend_pins: lcd0-suspend-pins {
+				pins = "PD0", "PD1", "PD2", "PD3",
+				       "PD4", "PD5", "PD6", "PD7",
+				       "PD8", "PD9", "PD10", "PD11",
+				       "PD12", "PD13", "PD14", "PD15",
+				       "PD16", "PD17", "PD18", "PD19",
+				       "PD20", "PD21", "PD22", "PD23",
+				       "PD24", "PD25", "PD26", "PD27";
+				function = "io_disabled";
+				bias-disable;
+			};
+
 			/omit-if-no-ref/
 			lvds0_pins: lvds0-pins {
 				pins = "PD0", "PD1", "PD2", "PD3", "PD4",
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-2024.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-2024.dts
@@ -288,7 +288,8 @@
 			power-supply = <&reg_lcd>;
 
 			pinctrl-0 = <&lcd0_rgb888_pins>;
-			pinctrl-names = "default";
+			pinctrl-1 = <&lcd0_suspend_pins>;
+			pinctrl-names = "default", "sleep";
 
 			port {
 				panel_in_rgb: endpoint {
--- a/drivers/gpu/drm/panel/panel-mipi.c
+++ b/drivers/gpu/drm/panel/panel-mipi.c
@@ -23,6 +23,7 @@
 #include <linux/media-bus-format.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
 #include <linux/spi/spi.h>
@@ -557,6 +558,8 @@
 	struct panel_mipi *mipi = to_panel_mipi(panel);
 	int err, display_id;
 
+	pinctrl_pm_select_default_state(panel->dev);
+
 	err = regulator_bulk_enable(ARRAY_SIZE(mipi->supplies), mipi->supplies);
 	if (err)
 		return err;
@@ -628,6 +631,9 @@
 		msleep(mipi->reset_delay);
 	}
 
+	/* Release the pads before the panel loses power; no-op without a sleep state. */
+	pinctrl_pm_select_sleep_state(panel->dev);
+
 	regulator_bulk_disable(ARRAY_SIZE(mipi->supplies), mipi->supplies);
 
 	return 0;
