From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <noreply@rocknix.org>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH] arm64: dts: rockchip: rk3576: Add DP controller audio port

Add a port@2 endpoint to the DP node so the DRM bridge audio framework
(DRM_BRIDGE_OP_DP_AUDIO) can discover SAI7 as the CPU DAI via
hdmi_audio_dai_port=2, and the matching endpoint on SAI7.

Signed-off-by: ROCKNIX <noreply@rocknix.org>
---
diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3576.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
@@ -1508,6 +1508,7 @@
 			resets = <&cru SRST_DP0>;
 			phys = <&usbdp_phy PHY_TYPE_DP>;
 			power-domains = <&power RK3576_PD_VO1>;
+			#sound-dai-cells = <0>;
 			status = "disabled";
 
 			ports {
@@ -1521,6 +1522,13 @@
 				dp0_out: port@1 {
 					reg = <1>;
 				};
+
+				dp0_sound_in: port@2 {
+					reg = <2>;
+					dp0_i2s_in: endpoint {
+						remote-endpoint = <&sai7_dp_out>;
+					};
+				};
 			};
 		};
 
@@ -1578,6 +1586,12 @@
 			#sound-dai-cells = <0>;
 			sound-name-prefix = "SAI7";
 			status = "disabled";
+
+			port {
+				sai7_dp_out: endpoint {
+					remote-endpoint = <&dp0_i2s_in>;
+				};
+			};
 		};
 
 		sai8: sai@27ee0000 {
