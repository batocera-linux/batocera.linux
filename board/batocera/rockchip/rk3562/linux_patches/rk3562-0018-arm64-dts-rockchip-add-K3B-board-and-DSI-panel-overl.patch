@@ -272,6 +274,10 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3399-rockpro64-v2-screen.dtb
 rk3399-rockpro64-v2-screen-dtbs := rk3399-rockpro64-v2.dtb \
 	rk3399-rockpro64-screen.dtbo
 
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3562-kickpi-k3b-demo-dsi-panel.dtb
+rk3562-kickpi-k3b-demo-dsi-panel-dtbs := rk3562-kickpi-k3b.dtb \
