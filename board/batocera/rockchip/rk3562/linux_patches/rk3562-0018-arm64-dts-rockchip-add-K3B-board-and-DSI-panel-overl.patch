+		rk817_charger: charger {
+			monitored-battery = <&battery>;
+			/*
+			 * The mainline RK817 driver sets the USB input current
+			 * limit to 1.5 A during probe.  When no battery is
+			 * connected and the K3B is powered solely through Type-C,
+			 * the total peripheral current during boot can exceed 1.5 A
+			 * and cause the system to reboot.  Raise the limit to 3 A.
+			 *
+			 * It is preferable to apply this setting in the bootloader
+			 * as well, because Linux may configure the RK817 too late.
+			 */
+			rockchip,input-current-limit-microamp = <3000000>;
+			rockchip,resistor-sense-micro-ohms = <10000>;
+			rockchip,sleep-enter-current-microamp = <300000>;
+			rockchip,sleep-filter-current-microamp = <100000>;
+		};
+	};
