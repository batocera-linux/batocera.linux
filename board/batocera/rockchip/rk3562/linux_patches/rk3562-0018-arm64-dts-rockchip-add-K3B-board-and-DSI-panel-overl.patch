+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3562-kickpi-k3b-demo-dsi-panel.dtbo
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3562-kickpi-k3b.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3368-geekbox.dtb
