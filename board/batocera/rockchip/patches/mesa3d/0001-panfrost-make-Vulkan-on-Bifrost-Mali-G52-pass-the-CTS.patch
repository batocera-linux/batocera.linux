+
+      return panvk_queue_poll_job_errors(queue);
+   }
 
    if (vk_device_is_lost(&dev->vk)) {
       /* Check printf buffer one more time before exiting */
@@ -399,10 +542,10 @@ panvk_per_arch(QueueWaitIdle)(VkQueue _queue)
       return VK_ERROR_DEVICE_LOST;
    }
 
-   ASSERTED int ret = drmSyncobjWait(dev->drm_fd, &queue->sync, 1,
-                                     INT64_MAX, DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL,
-                                     NULL);
-   assert(!ret);
+   int ret = drmSyncobjWait(dev->drm_fd, &queue->sync, 1, INT64_MAX,
