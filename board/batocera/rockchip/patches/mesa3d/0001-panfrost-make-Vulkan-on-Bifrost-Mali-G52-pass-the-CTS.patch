index c655956afae..62b96d2fd48 100644
--- a/src/panfrost/compiler/bifrost/bifrost/bi_schedule.c
+++ b/src/panfrost/compiler/bifrost/bifrost/bi_schedule.c
@@ -349,6 +349,8 @@ bi_lower_atom_c(bi_context *ctx, struct bi_clause_state *clause,
    bi_instr *atom_cx =
       bi_atom_cx_to(&b, pinstr->dest[0], pinstr->src[0], pinstr->src[1],
                     pinstr->src[2], pinstr->src[0], pinstr->sr_count);
+   /* Not encoded, but needed to count the staging registers read */
+   atom_cx->atom_opc = pinstr->atom_opc;
