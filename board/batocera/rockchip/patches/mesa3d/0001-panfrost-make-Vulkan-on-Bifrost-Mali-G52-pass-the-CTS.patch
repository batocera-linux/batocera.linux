diff --git a/src/panfrost/compiler/bifrost/bir.c b/src/panfrost/compiler/bifrost/bir.c
index 8da950f32ae..e3f9760cdd7 100644
--- a/src/panfrost/compiler/bifrost/bir.c
+++ b/src/panfrost/compiler/bifrost/bir.c
@@ -71,6 +71,11 @@ bi_count_read_registers(const bi_instr *ins, unsigned s)
       return (ins->atom_opc == BI_ATOM_OPC_ACMPXCHG) ? 2 : 1;
    else if (s == 0 && ins->op == BI_OPCODE_ATOM_RETURN_I64)
       return (ins->atom_opc == BI_ATOM_OPC_ACMPXCHG) ? 4 : 2;
+   /* Same for the +ATOM_CX the scheduler lowers them to, which keeps their
+    * staging count and atomic opcode */
+   else if (s == 0 && ins->op == BI_OPCODE_ATOM_CX)
+      return (ins->atom_opc == BI_ATOM_OPC_ACMPXCHG) ? ins->sr_count
+                                                     : ins->sr_count / 2;
    else if (s == 0 && bi_get_opcode_props(ins)->sr_read)
       return bi_count_staging_registers(ins);
    else if (s == 4 && ins->op == BI_OPCODE_BLEND)
diff --git a/src/panfrost/vulkan/jm/panvk_queue.h b/src/panfrost/vulkan/jm/panvk_queue.h
