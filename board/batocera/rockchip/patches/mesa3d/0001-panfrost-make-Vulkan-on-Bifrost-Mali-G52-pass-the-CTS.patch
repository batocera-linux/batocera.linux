+       * previous issue of this batch must be done with them. It might still
+       * be queued if the command buffer is submitted more than once
+       * (VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT, or several times in
+       * the same vkQueueSubmit). All submits are ordered on queue->sync,
+       * which is the only GPU queue on JM, so waiting for it is enough. */
+      ret = drmSyncobjWait(dev->drm_fd, &queue->sync, 1, INT64_MAX,
+                           DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL, NULL);
+      if (ret)
+         return vk_queue_set_lost(&queue->vk, "syncobj wait failed: %m");
+
       util_dynarray_foreach(&batch->jobs, void *, job)
          memset((*job), 0, 4 * 4);
 
@@ -74,10 +151,16 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
          .in_sync_count = nr_in_fences,
