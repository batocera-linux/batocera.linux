       if (PANVK_DEBUG(TRACE) || PANVK_DEBUG(SYNC)) {
          ret = drmSyncobjWait(dev->drm_fd, &submit.out_sync, 1, INT64_MAX, 0,
@@ -110,6 +193,7 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
          .out_sync = queue->sync,
          .jc = batch->frag_jc.first_job,
          .requirements = PANFROST_JD_REQ_FS,
+         .jm_ctx_handle = queue->jm_ctx,
       };
 
       if (batch->vtc_jc.first_job) {
@@ -121,7 +205,13 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
       }
 
       ret = pan_kmod_ioctl(dev->drm_fd, DRM_IOCTL_PANFROST_SUBMIT, &submit);
-      assert(!ret);
+      if (ret)
+         return vk_queue_set_lost(&queue->vk, "PANFROST_SUBMIT failed: %m");
+
+      VkResult result = panvk_queue_track_job(queue);
+      if (result != VK_SUCCESS)
