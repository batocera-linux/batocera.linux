+#if PAN_ARCH < 9
+/* The Bifrost LOD query returns the level rounded to the nearest integer in
+ * .x, which is only right for VK_SAMPLER_MIPMAP_MODE_NEAREST. Recompute it from
+ * the unclamped LOD in .y and the sampler state, like Valhall does: clamp to
+ * the sampler LOD range and the texture levels, and pick the level according
+ * to the mipmap mode (fractional for linear filtering).
+ */
+static void
+fixup_tex_lod(nir_builder *b, nir_tex_instr *tex,
+              const struct lower_desc_ctx *ctx)
+{
+   int tex_src_idx = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+   int samp_src_idx = nir_tex_instr_src_index(tex, nir_tex_src_sampler_deref);
+   if (tex_src_idx < 0 || samp_src_idx < 0)
+      return;
+
+   nir_deref_instr *tex_deref = nir_src_as_deref(tex->src[tex_src_idx].src);
+   nir_deref_instr *samp_deref = nir_src_as_deref(tex->src[samp_src_idx].src);
+
+   b->cursor = nir_after_instr(&tex->instr);
+
+   nir_def *lambda_prime = nir_channel(b, &tex->def, 1);
+
+   nir_def *samp_w0 = load_resource_deref_desc(
+      b, samp_deref, VK_DESCRIPTOR_TYPE_SAMPLER, 0, 1, 32, ctx);
+   nir_def *samp_w1 = load_resource_deref_desc(
+      b, samp_deref, VK_DESCRIPTOR_TYPE_SAMPLER, 4, 1, 32, ctx);
+
+   /* Minimum and maximum LOD are 8.8 fixed point in word1[0:12] and
+    * word1[16:28]. */
+   nir_def *min_lod = nir_ubitfield_extract_imm(b, samp_w1, 0, 13);
+   nir_def *max_lod = nir_ubitfield_extract_imm(b, samp_w1, 16, 13);
+   min_lod = nir_fdiv_imm(b, nir_u2f32(b, min_lod), 256.0);
+   max_lod = nir_fdiv_imm(b, nir_u2f32(b, max_lod), 256.0);
+
+   nir_def *levels = load_tex_levels(b, tex_deref, tex->sampler_dim, ctx);
+   max_lod =
+      nir_fmin(b, max_lod, nir_u2f32(b, nir_iadd_imm(b, levels, -1)));
+
+   nir_def *lod = nir_fclamp(b, lambda_prime, min_lod, max_lod);
+
+   /* Mipmap mode is in word0[30:31]. */
+   nir_def *mipmap_mode = nir_ubitfield_extract_imm(b, samp_w0, 30, 2);
+
+   nir_def *nearest_lod =
+      nir_fadd_imm(b, nir_fceil(b, nir_fadd_imm(b, lod, 0.5)), -1.0);
+   lod = nir_bcsel(b, nir_ieq_imm(b, mipmap_mode, MALI_MIPMAP_MODE_NEAREST),
+                   nearest_lod, lod);
+   lod = nir_bcsel(b, nir_ieq_imm(b, mipmap_mode, MALI_MIPMAP_MODE_NONE),
+                   nir_imm_float(b, 0.0), lod);
+
+   nir_def *res = nir_vec2(b, lod, lambda_prime);
+   nir_def_rewrite_uses_after(&tex->def, res);
+
+   b->cursor = nir_before_instr(&tex->instr);
+}
+#endif
