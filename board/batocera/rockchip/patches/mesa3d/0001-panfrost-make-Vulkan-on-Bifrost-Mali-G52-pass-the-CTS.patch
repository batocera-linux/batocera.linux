-
    struct panvk_gpu_queue *queue = vk_zalloc(&device->vk.alloc, sizeof(*queue), 8,
                                          VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
    if (!queue)
@@ -356,10 +446,41 @@ panvk_per_arch(create_gpu_queue)(struct panvk_device *device,
       goto err_finish_queue;
    }
 
+   /* The default context is medium priority, other priorities need a
+    * dedicated JM context. Only priorities the kernel allows are advertised. */
+   if (priority == VK_QUEUE_GLOBAL_PRIORITY_REALTIME_KHR) {
+      result = panvk_error(device, VK_ERROR_NOT_PERMITTED_KHR);
+      goto err_destroy_sync;
+   }
+
+   if (priority != VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR) {
+      struct drm_panfrost_jm_ctx_create ctx_create = {
+         .priority = priority == VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR
+                        ? PANFROST_JM_CTX_PRIORITY_LOW
+                        : PANFROST_JM_CTX_PRIORITY_HIGH,
+      };
+
+      ret = pan_kmod_ioctl(device->drm_fd, DRM_IOCTL_PANFROST_JM_CTX_CREATE,
+                           &ctx_create);
+      if (ret) {
+         result = panvk_error(device, errno == EPERM || errno == EACCES
+                                         ? VK_ERROR_NOT_PERMITTED_KHR
+                                         : VK_ERROR_INITIALIZATION_FAILED);
+         goto err_destroy_sync;
+      }
+
+      queue->jm_ctx = ctx_create.handle;
+   }
+
+   queue->pending_jobs_fd = -1;
+   simple_mtx_init(&queue->pending_jobs_lock, mtx_plain);
    queue->vk.driver_submit = panvk_per_arch(gpu_queue_submit);
    *out_queue = &queue->vk;
    return VK_SUCCESS;
 
+err_destroy_sync:
+   drmSyncobjDestroy(device->drm_fd, queue->sync);
+
 err_finish_queue:
    vk_queue_finish(&queue->vk);
 
@@ -374,6 +495,17 @@ void panvk_per_arch(destroy_gpu_queue)(struct vk_queue *vk_queue)
    struct panvk_device *dev = to_panvk_device(vk_queue->base.device);
 
    vk_queue_finish(&queue->vk);
+   if (queue->pending_jobs_fd >= 0)
+      close(queue->pending_jobs_fd);
+   simple_mtx_destroy(&queue->pending_jobs_lock);
+   if (queue->jm_ctx) {
+      struct drm_panfrost_jm_ctx_destroy ctx_destroy = {
+         .handle = queue->jm_ctx,
+      };
+
+      pan_kmod_ioctl(dev->drm_fd, DRM_IOCTL_PANFROST_JM_CTX_DESTROY,
+                     &ctx_destroy);
+   }
    drmSyncobjDestroy(dev->drm_fd, queue->sync);
    vk_free(&dev->vk.alloc, queue);
 }
@@ -381,7 +513,10 @@ void panvk_per_arch(destroy_gpu_queue)(struct vk_queue *vk_queue)
 VkResult
