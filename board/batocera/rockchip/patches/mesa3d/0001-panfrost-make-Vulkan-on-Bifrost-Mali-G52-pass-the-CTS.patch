+#include "util/libsync.h"
+
+/* Report a job the kernel flagged as failed (fault or scheduler timeout), and
+ * stop tracking the jobs once they have all signaled. */
+static VkResult
+panvk_queue_poll_job_errors_locked(struct panvk_gpu_queue *queue)
+{
+   simple_mtx_assert_locked(&queue->pending_jobs_lock);
+
+   if (queue->pending_jobs_fd < 0)
+      return VK_SUCCESS;
+
+   struct sync_file_info info = {0};
+   if (ioctl(queue->pending_jobs_fd, SYNC_IOC_FILE_INFO, &info))
+      return vk_queue_set_lost(&queue->vk, "SYNC_IOC_FILE_INFO failed: %m");
+
+   if (info.status < 0) {
+      close(queue->pending_jobs_fd);
+      queue->pending_jobs_fd = -1;
+      return vk_queue_set_lost(&queue->vk, "GPU job failed: %s",
+                               strerror(-info.status));
+   }
+
+   if (info.status == 1) {
+      close(queue->pending_jobs_fd);
+      queue->pending_jobs_fd = -1;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+panvk_queue_poll_job_errors(struct panvk_gpu_queue *queue)
+{
+   simple_mtx_lock(&queue->pending_jobs_lock);
+   VkResult result = panvk_queue_poll_job_errors_locked(queue);
+   simple_mtx_unlock(&queue->pending_jobs_lock);
+
+   return result;
+}
+
+/* Add the job we just submitted, whose fence is now in queue->sync, to the
+ * set of jobs we check for errors. */
+static VkResult
+panvk_queue_track_job(struct panvk_gpu_queue *queue)
+{
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+
+   int fd = -1;
+   if (drmSyncobjExportSyncFile(dev->drm_fd, queue->sync, &fd))
+      return vk_queue_set_lost(&queue->vk, "sync file export failed: %m");
+
+   simple_mtx_lock(&queue->pending_jobs_lock);
+
+   VkResult result = panvk_queue_poll_job_errors_locked(queue);
+   if (result == VK_SUCCESS &&
+       sync_accumulate("panvk", &queue->pending_jobs_fd, fd))
+      result = vk_queue_set_lost(&queue->vk, "sync file merge failed: %m");
+
+   simple_mtx_unlock(&queue->pending_jobs_lock);
+   close(fd);
+
+   return result;
+}
+
+static VkResult
 panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
                          struct panvk_cmd_buffer *cmdbuf,
                          struct panvk_batch *batch, uint32_t *bos,
@@ -39,10 +105,21 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(dev->vk.physical);
-   ASSERTED int ret;
+   int ret;
 
    /* Reset the batch if it's already been issued */
    if (batch->issued) {
