+++ b/src/panfrost/vulkan/jm/panvk_queue.h
@@ -14,11 +14,26 @@
 
 #include "panvk_device.h"
 
+#include "util/simple_mtx.h"
+
 #include "vk_queue.h"
 
 struct panvk_gpu_queue {
    struct vk_queue vk;
    uint32_t sync;
+
+   /* Kernel JM context carrying the queue priority, 0 for the default
+    * (medium priority) context. */
+   uint32_t jm_ctx;
+
+   /* Merged sync_file of the jobs submitted since we last saw them all
+    * signaled. The kernel flags the fence of a job that faulted or got
+    * killed by the scheduler timeout with an error, which is how we detect
+    * device loss on JM. -1 when there's nothing to track. Protected by
+    * pending_jobs_lock since check_status() can run from any thread
+    * waiting on a fence, concurrently with submits. */
+   int pending_jobs_fd;
+   simple_mtx_t pending_jobs_lock;
 };
 
 VK_DEFINE_HANDLE_CASTS(panvk_gpu_queue, vk.base, VkQueue, VK_OBJECT_TYPE_QUEUE)
