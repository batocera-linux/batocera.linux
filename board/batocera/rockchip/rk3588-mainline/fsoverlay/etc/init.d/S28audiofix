#!/bin/bash

MODEL=$(batocera-model)

start() {
    setsid /usr/bin/rk3588-hdmi-audio --monitor >/dev/null 2>&1 &
    if [ -e /proc/asound/rockchipes8388 ]; then
        echo "Setting the ES8388 outputs to 0dB"
        amixer -q -c rockchipes8388 sset 'Output 1' 30
        amixer -q -c rockchipes8388 sset 'Output 2' 30
    fi
    if [[ "$MODEL" == FriendlyElec_NanoPi_M6* ]]; then
        echo "Routing the DAC to the headphone jack for NanoPi M6"
        for CTL in 'Stereo DAC MIXL DAC L1' 'Stereo DAC MIXR DAC R1' 'OUT MIXL DAC L1' 'OUT MIXR DAC R1' 'HPVOL' 'HPO MIX HPVOL' 'HP'; do
            amixer -q -c realtekrt5616co sset "$CTL" on
        done
    fi
}

stop() {
    :
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
