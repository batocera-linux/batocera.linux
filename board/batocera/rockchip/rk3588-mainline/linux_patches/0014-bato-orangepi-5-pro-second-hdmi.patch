Orange Pi 5 Pro: enable dp0, which drives the second HDMI port through
the LT8711UXD bridge on usbdp_phy0 lanes 0/1, and the bridge supply.

diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5-pro.dts b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5-pro.dts
index c9679bac1..eedf4d85e 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5-pro.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-orangepi-5-pro.dts
@@ -64,6 +64,19 @@ led-1 {
 		};
 	};
 
+	// Batocera - second HDMI port, dp0 through the LT8711UXD bridge
+	dp-con {
+		compatible = "dp-connector";
+		label = "HDMI2";
+		type = "full-size";
+
+		port {
+			dp_con_in: endpoint {
+				remote-endpoint = <&dp0_out_con>;
+			};
+		};
+	};
+
 	fan: pwm-fan {
 		compatible = "pwm-fan";
 		#cooling-cells = <2>;
@@ -85,6 +98,21 @@ vcc3v3_eth: regulator-vcc3v3-eth {
 		vin-supply = <&vcc_3v3_s3>;
 	};
 
+	// Batocera - LT8711UXD supply
+	vcc3v3_dp0: regulator-vcc3v3-dp0 {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&dp0_en>;
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-max-microvolt = <3300000>;
+		regulator-min-microvolt = <3300000>;
+		regulator-name = "vcc3v3_dp0";
+		vin-supply = <&vcc_3v3_s3>;
+	};
+
 	vcc5v0_otg: regulator-vcc5v0-otg {
 		compatible = "regulator-fixed";
 		enable-active-high;
@@ -116,6 +144,25 @@ typea_con: usb-a-connector {
 	};
 };
 
+// Batocera - second HDMI port
+&dp0 {
+	pinctrl-0 = <&dp0m0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&dp0_in {
+	dp0_in_vp2: endpoint {
+		remote-endpoint = <&vp2_out_dp0>;
+	};
+};
+
+&dp0_out {
+	dp0_out_con: endpoint {
+		remote-endpoint = <&dp_con_in>;
+	};
+};
+
 &i2c1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c1m4_xfer>;
@@ -217,6 +264,13 @@ bt_wake_host_irq: bt-wake-host-irq {
 		};
 	};
 
+	// Batocera - LT8711UXD supply
+	dp {
+		dp0_en: dp0-en {
+			rockchip,pins = <3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
 	ethernet {
 		ethernet_en: ethernet-en {
 			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_down>;
@@ -356,3 +410,14 @@ &usbdp_phy0 {
 	 */
 	rockchip,dp-lane-mux = <0 1>;
 };
+
+// Batocera - second HDMI port
+&vp2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	vp2_out_dp0: endpoint@a {
+		reg = <ROCKCHIP_VOP2_EP_DP0>;
+		remote-endpoint = <&dp0_in_vp2>;
+	};
+};
