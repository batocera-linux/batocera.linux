NanoPi M6: the M.2 reset is gpio3 PD1 as on the R6, gpio4 PA5 is its
presence pin. Enable HDMI audio, the pwm5 fan header and the IR receiver.

diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-nanopi-m6.dts b/arch/arm64/boot/dts/rockchip/rk3588s-nanopi-m6.dts
index 30c10ce..57f04e8 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s-nanopi-m6.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-nanopi-m6.dts
@@ -108,6 +108,21 @@
 		};
 	};
 
+	// Batocera - IR receiver on the pwm3 m0 pin
+	ir-receiver {
+		compatible = "gpio-ir-receiver";
+		gpios = <&gpio0 RK_PD4 GPIO_ACTIVE_LOW>;
+	};
+
+	// Batocera - fan header on pwm5m1
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		#cooling-cells = <2>;
+		cooling-levels = <0 35 64 100 150 255>;
+		fan-supply = <&vcc5v0_sys>;
+		pwms = <&pwm5 0 50000 0>;
+	};
+
 	vcc5v0_sys: regulator-vcc5v0-sys {
 		compatible = "regulator-fixed";
 		regulator-name = "vcc5v0_sys";
@@ -270,6 +285,11 @@
 	status = "okay";
 };
 
+// Batocera - HDMI audio
+&hdmi0_sound {
+	status = "okay";
+};
+
 &hdmi0_in {
 	hdmi0_in_vp0: endpoint {
 		remote-endpoint = <&vp0_out_hdmi0>;
@@ -384,6 +404,11 @@
 	};
 };
 
+// Batocera - HDMI audio
+&i2s5_8ch {
+	status = "okay";
+};
+
 &i2s0_8ch {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2s0_lrck
@@ -414,7 +439,8 @@
 &pcie2x1l2 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pcie_m2_0_prsnt>;
-	reset-gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
+	// Batocera - gpio4 PA5 is PRSNT, PERST# is gpio3 PD1
+	reset-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
 	vpcie3v3-supply = <&vcc_3v3_pcie20_m2>;
 	status = "okay";
 };
@@ -476,6 +502,13 @@
 	};
 };
 
+// Batocera - fan header on pwm5m1
+&pwm5 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm5m1_pins>;
+	status = "okay";
+};
+
 &saradc {
 	vref-supply = <&avcc_1v8_s0>;
 	status = "okay";
