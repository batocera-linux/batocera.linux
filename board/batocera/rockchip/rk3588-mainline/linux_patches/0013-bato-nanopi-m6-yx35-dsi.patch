+++ b/arch/arm64/boot/dts/rockchip/rk3588s-nanopi-m6-yx35.dtsi
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * FriendlyElec YX35 3.5" 480x800 MIPI-DSI LCD (ST7701S) with GT1x touch,
+ * on either of the NanoPi M6 DSI connectors.
+ */
+
+#include "rk3588s-nanopi-m6.dts"
+
+#define YX35_PANEL_DESCRIPTION \
+	"G size=45,75 delays=0,20,120,5,0 format=rgb888 lanes=2 flags=0xc03", \
+	"M clock=29700 horizontal=480,40,32,30 vertical=800,20,10,20 default=1", \
+	"I seq=0100 wait=0a", \
+	"I seq=1100 wait=7d", \
+	"I seq=ff7701000013", \
+	"I seq=ef08", \
+	"I seq=ff7701000010", \
+	"I seq=c06300", \
+	"I seq=c11414", \
+	"I seq=c23702", \
+	"I seq=cc10", \
+	"I seq=b0c5111b0d11070a090824051210a932df", \
+	"I seq=b1c519210b0e030c070726041211aa32df", \
+	"I seq=ff7701000011", \
+	"I seq=b04d", \
+	"I seq=b159", \
+	"I seq=b281", \
+	"I seq=b380", \
+	"I seq=b54e", \
+	"I seq=b785", \
+	"I seq=b832", \
+	"I seq=bb03", \
+	"I seq=c108", \
+	"I seq=c208", \
+	"I seq=d088", \
+	"I seq=e0000002", \
+	"I seq=e106280828052807280e3333", \
+	"I seq=e2303033333400000034000000", \
+	"I seq=e300003333", \
+	"I seq=e44444", \
+	"I seq=e5092f2c8c0b312c8c0d332c8c0f352c8c", \
+	"I seq=e600003333", \
+	"I seq=e74444", \
+	"I seq=e8082e2c8c0a302c8c0c322c8c0e342c8c", \
+	"I seq=e93600", \
+	"I seq=eb0001e4e4448840", \
+	"I seq=edfffcb24567fa01ffff10af76542bcfff", \
+	"I seq=ef080808453f54", \
+	"I seq=ff7701000013", \
+	"I seq=e8000e", \
+	"I seq=1100 wait=78", \
+	"I seq=e8000c wait=0a", \
+	"I seq=e80000", \
+	"I seq=ff7701000000", \
+	"I seq=3600", \
+	"I seq=2900"
+
+/ {
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <200>;
+	};
+};
+
+&pinctrl {
+	lcd {
+		lcd_rst0_gpio: lcd-rst0-gpio {
+			rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		lcd_rst1_gpio: lcd-rst1-gpio {
+			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	touch {
+		touch_dsi0_gpio: touch-dsi0-gpio {
+			rockchip,pins =
+				<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		touch_dsi1_gpio: touch-dsi1-gpio {
+			rockchip,pins =
+				<4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
