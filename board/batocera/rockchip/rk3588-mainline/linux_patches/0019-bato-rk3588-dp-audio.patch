RK3588 DP audio: S/PDIF sound card for each enabled DP output (dp0 from
spdif_tx2, dp1 from spdif_tx5) on the Orange Pi 5 Pro, Mekotronics R58X,
CoolPi 4B and Indiedroid Nova. The dp node takes one sound-dai cell to
pick the hdmi-codec S/PDIF DAI, as the vendor tree does.

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-blueberry-edge-v12-linux.dts b/arch/arm64/boot/dts/rockchip/rk3588-blueberry-edge-v12-linux.dts
--- a/arch/arm64/boot/dts/rockchip/rk3588-blueberry-edge-v12-linux.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-blueberry-edge-v12-linux.dts
@@ -197,15 +197,36 @@ dp1_con_in: endpoint {
 			};
 		};
 	};
+
+	// Batocera - DP1 audio over S/PDIF
+	dp1_sound: dp1-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "dp1";
+
+		simple-audio-card,codec {
+			sound-dai = <&dp1 1>;
+		};
+
+		simple-audio-card,cpu {
+			sound-dai = <&spdif_tx5>;
+		};
+	};
 };
 
 // Batocera - second video output on dp1
 &dp1 {
+	// Batocera - select the S/PDIF DAI
+	#sound-dai-cells = <1>;
 	pinctrl-0 = <&dp1m0_pins>;
 	pinctrl-names = "default";
 	status = "okay";
 };
 
+// Batocera - DP audio source
+&spdif_tx5 {
+	status = "okay";
+};
+
 &dp1_in {
 	dp1_in_vp2: endpoint {
 		remote-endpoint = <&vp2_out_dp1>;
