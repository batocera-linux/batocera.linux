+	.flags = V4L2_VP9_FRAME_FLAG_X_SUBSAMPLING |
+		 V4L2_VP9_FRAME_FLAG_Y_SUBSAMPLING,
+	.frame_width_minus_1 = 7,
+	.frame_height_minus_1 = 7,
+	.render_width_minus_1 = 7,
+	.render_height_minus_1 = 7,
+	.bit_depth = 8,
+};
+
 static int vdec_init_ctrls(struct amvdec_session *sess)
 {
 	struct v4l2_ctrl_handler *ctrl_handler = &sess->ctrl_handler;
@@ -1118,6 +1162,21 @@ static int vdec_init_ctrls(struct amvdec_session *sess)
 			v4l2_ctrl_new_custom(ctrl_handler, &h264_ctrls[i], NULL);
 	}
 
+	if (vdec_format_by_pixfmt(sess->core, V4L2_PIX_FMT_VP9_FRAME)) {
