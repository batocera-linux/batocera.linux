+};
+
+struct codec_vp9 {
+	/* VP9 context lock */
+	struct mutex lock;
+
+	/* Common part with the HEVC decoder */
+	struct codec_hevc_common common;
+
+	/* Buffer for the VP9 Workspace */
+	void      *workspace_vaddr;
+	dma_addr_t workspace_paddr;
+	struct amvdec_dma_guard workspace_guard;
+
+	/* Per-capture motion-vector buffers, indexed by vb2 buffer index. */
+	void      *mv_vaddr[MAX_REF_PIC_NUM];
+	dma_addr_t mv_paddr[MAX_REF_PIC_NUM];
+	struct amvdec_dma_guard mv_guard[MAX_REF_PIC_NUM];
+
+	/* Firmware-parsed bitstream parameters. */
+	union rpm_param rpm_param;
+	bool request_size, request_parked, request_failed;
+	bool restream_pending;
+
+	/* Coded bit depth is 10. */
+	int is_10bit;
+
+	/* Coded resolution reported by the hardware */
+	u32 width, height;
+
+	/* All ref frames used by the HW at a given time */
+	struct list_head ref_frames_list;
+	u32 frames_num;
+
+	struct vp9_frame *frame_refs[REFS_PER_FRAME];
+
+	u32 lcu_total;
+
+	/* loop filter */
+	int default_filt_lvl;
+	struct loop_filter_info_n lfi;
+	struct loopfilter lf;
+	struct segmentation seg_4lf;
+
+	struct vp9_frame *cur_frame;
+	struct vp9_frame *prev_frame;
+};
+
+static void codec_vp9_guard_fail_session(struct amvdec_session *sess)
+{
+	dev_err(sess->core->dev, "VP9 DMA guard changed; failing session\n");
+	vb2_queue_error(&sess->m2m_ctx->out_q_ctx.q);
+	vb2_queue_error(&sess->m2m_ctx->cap_q_ctx.q);
+}
+
+static int codec_vp9_verify_guards(struct amvdec_session *sess,
+				   const char *prefix)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	char name[96];
+	int ret = 0;
+	int i;
+
+	if (vp9->workspace_vaddr) {
+		scnprintf(name, sizeof(name), "%s.workspace", prefix);
+		ret |= meson_amvdec_dma_verify_guard(sess->core->dev, name,
+						       &vp9->workspace_guard);
+	}
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		if (!vp9->mv_vaddr[i])
+			continue;
+		scnprintf(name, sizeof(name), "%s.mv[%d]", prefix, i);
+		ret |= meson_amvdec_dma_verify_guard(sess->core->dev, name,
+						       &vp9->mv_guard[i]);
+	}
+	ret |= meson_amvdec_codec_hevc_verify_fbc_guards(sess, &vp9->common, prefix);
+	if (!ret)
+		return 0;
+
+	codec_vp9_guard_fail_session(sess);
+	return -EIO;
+}
+
+static int div_r32(s64 m, int n)
+{
+	s64 qu = div_s64(m, n);
+
+	return (int)qu;
+}
+
+static int clip_prob(int p)
+{
+	return clamp_val(p, 1, 255);
+}
+
+static int segfeature_active(struct segmentation *seg, int segment_id,
+			     enum SEG_LVL_FEATURES feature_id)
+{
+	return seg->enabled &&
+		(seg->feature_mask[segment_id] & (1 << feature_id));
+}
+
+static int get_segdata(struct segmentation *seg, int segment_id,
+		       enum SEG_LVL_FEATURES feature_id)
+{
+	return seg->feature_data[segment_id][feature_id];
+}
+
+static void vp9_update_sharpness(struct loop_filter_info_n *lfi,
+				 int sharpness_lvl)
+{
+	int lvl;
+
+	/* For each possible value for the loop filter fill out limits*/
+	for (lvl = 0; lvl <= MAX_LOOP_FILTER; lvl++) {
+		/* Set loop filter parameters that control sharpness.*/
+		int block_inside_limit = lvl >> ((sharpness_lvl > 0) +
+					(sharpness_lvl > 4));
+
+		if (sharpness_lvl > 0) {
+			if (block_inside_limit > (9 - sharpness_lvl))
+				block_inside_limit = (9 - sharpness_lvl);
+		}
+
+		if (block_inside_limit < 1)
+			block_inside_limit = 1;
+
+		lfi->lfthr[lvl].lim = (u8)block_inside_limit;
+		lfi->lfthr[lvl].mblim = (u8)(2 * (lvl + 2) +
+				block_inside_limit);
+	}
+}
+
+/* Instantiate this function once when decode is started */
+static void
+vp9_loop_filter_init(struct amvdec_core *core, struct codec_vp9 *vp9)
+{
+	struct loop_filter_info_n *lfi = &vp9->lfi;
+	struct loopfilter *lf = &vp9->lf;
+	struct segmentation *seg_4lf = &vp9->seg_4lf;
+	int i;
+
+	memset(lfi, 0, sizeof(struct loop_filter_info_n));
+	memset(lf, 0, sizeof(struct loopfilter));
+	memset(seg_4lf, 0, sizeof(struct segmentation));
+	lf->sharpness_level = 0;
+	vp9_update_sharpness(lfi, lf->sharpness_level);
+	lf->last_sharpness_level = lf->sharpness_level;
+
+	for (i = 0; i < 32; i++) {
+		unsigned int thr;
+
+		thr = ((lfi->lfthr[i * 2 + 1].lim & 0x3f) << 8) |
+			(lfi->lfthr[i * 2 + 1].mblim & 0xff);
+		thr = (thr << 16) | ((lfi->lfthr[i * 2].lim & 0x3f) << 8) |
+			(lfi->lfthr[i * 2].mblim & 0xff);
+
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFG9, thr);
+	}
+
+	if (core->platform->revision >= AMVDEC_REVISION_SM1)
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFGB,
+				 (0x3 << 14) | /* dw fifo thres r and b */
+				 (0x3 << 12) | /* dw fifo thres r or b */
+				 (0x3 << 10) | /* dw fifo thres not r/b */
+				 BIT(0)); /* VP9 video format */
+	else if (core->platform->revision >= AMVDEC_REVISION_G12A)
+		/* VP9 video format */
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFGB, (0x54 << 8) | BIT(0));
+	else
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFGB, 0x40400001);
+}
+
+static void
+vp9_loop_filter_frame_init(struct amvdec_core *core, struct segmentation *seg,
+			   struct loop_filter_info_n *lfi,
+			   struct loopfilter *lf, int default_filt_lvl)
+{
+	int i;
+	int seg_id;
+
+	/*
+	 * n_shift is the multiplier for lf_deltas
+	 * the multiplier is:
+	 * - 1 for when filter_lvl is between 0 and 31
+	 * - 2 when filter_lvl is between 32 and 63
+	 */
+	const int scale = 1 << (default_filt_lvl >> 5);
+
+	/* update limits if sharpness has changed */
+	if (lf->last_sharpness_level != lf->sharpness_level) {
+		vp9_update_sharpness(lfi, lf->sharpness_level);
+		lf->last_sharpness_level = lf->sharpness_level;
+
+		/* Write to register */
+		for (i = 0; i < 32; i++) {
+			unsigned int thr;
+
+			thr = ((lfi->lfthr[i * 2 + 1].lim & 0x3f) << 8) |
+			      (lfi->lfthr[i * 2 + 1].mblim & 0xff);
+			thr = (thr << 16) |
+			      ((lfi->lfthr[i * 2].lim & 0x3f) << 8) |
+			      (lfi->lfthr[i * 2].mblim & 0xff);
+
+			meson_amvdec_write_dos(core, HEVC_DBLK_CFG9, thr);
+		}
+	}
+
+	for (seg_id = 0; seg_id < MAX_SEGMENTS; seg_id++) {
+		int lvl_seg = default_filt_lvl;
+
+		if (segfeature_active(seg, seg_id, SEG_LVL_ALT_LF)) {
+			const int data = get_segdata(seg, seg_id,
+						SEG_LVL_ALT_LF);
+			lvl_seg = clamp_t(int,
+					  seg->abs_delta == SEGMENT_ABSDATA ?
+						data : default_filt_lvl + data,
+					  0, MAX_LOOP_FILTER);
+		}
+
+		if (!lf->mode_ref_delta_enabled) {
+			memset(lfi->lvl[seg_id], lvl_seg,
+			       sizeof(lfi->lvl[seg_id]));
+		} else {
+			int ref, mode;
+			const int intra_lvl =
+				lvl_seg + lf->ref_deltas[INTRA_FRAME] * scale;
+			lfi->lvl[seg_id][INTRA_FRAME][0] =
+				clamp_val(intra_lvl, 0, MAX_LOOP_FILTER);
+
+			for (ref = LAST_FRAME; ref < MAX_REF_FRAMES; ++ref) {
+				for (mode = 0; mode < MAX_MODE_LF_DELTAS;
+				     ++mode) {
+					const int inter_lvl =
+						lvl_seg +
+						lf->ref_deltas[ref] * scale +
+						lf->mode_deltas[mode] * scale;
+					lfi->lvl[seg_id][ref][mode] =
+						clamp_val(inter_lvl, 0,
+							  MAX_LOOP_FILTER);
+				}
+			}
+		}
+	}
+
+	for (i = 0; i < 16; i++) {
+		unsigned int level;
+
+		level = ((lfi->lvl[i >> 1][3][i & 1] & 0x3f) << 24) |
+			((lfi->lvl[i >> 1][2][i & 1] & 0x3f) << 16) |
+			((lfi->lvl[i >> 1][1][i & 1] & 0x3f) << 8) |
+			(lfi->lvl[i >> 1][0][i & 1] & 0x3f);
+		if (!default_filt_lvl)
+			level = 0;
+
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFGA, level);
+	}
+}
+
+static void codec_vp9_free_mv_buffers(struct amvdec_core *core,
+				      struct codec_vp9 *vp9)
+{
+	int i;
+
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		if (!vp9->mv_vaddr[i])
+			continue;
+
+		meson_amvdec_dma_free_guarded(core->dev, vp9->mv_paddr[i],
+					&vp9->mv_guard[i]);
+		vp9->mv_vaddr[i] = NULL;
+		vp9->mv_paddr[i] = 0;
+		memset(&vp9->mv_guard[i], 0, sizeof(vp9->mv_guard[i]));
+	}
+}
+
+static int codec_vp9_alloc_workspace(struct amvdec_core *core,
+				     struct codec_vp9 *vp9)
+{
+	int i;
+
+	/* Allocate some memory for the VP9 decoder's state */
+	vp9->workspace_vaddr = meson_amvdec_dma_alloc_guarded(core->dev, SIZE_WORKSPACE,
+							&vp9->workspace_paddr,
+							      GFP_KERNEL,
+							      &vp9->workspace_guard);
+	if (!vp9->workspace_vaddr) {
+		dev_err(core->dev, "Failed to allocate VP9 Workspace\n");
+		return -ENOMEM;
+	}
+
+	/*
+	 * Allocate every MV slot before decoding so the threaded ISR always has
+	 * a valid DMA address.
+	 */
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		vp9->mv_vaddr[i] = meson_amvdec_dma_alloc_guarded(core->dev,
+							    MPRED_MV_BUF_SIZE,
+							      &vp9->mv_paddr[i],
+							      GFP_KERNEL,
+							      &vp9->mv_guard[i]);
+		if (!vp9->mv_vaddr[i]) {
+			dev_err(core->dev, "Failed to allocate VP9 MV buffer\n");
+			codec_vp9_free_mv_buffers(core, vp9);
+			meson_amvdec_dma_free_guarded(core->dev, vp9->workspace_paddr,
+						&vp9->workspace_guard);
+			vp9->workspace_vaddr = NULL;
+			vp9->workspace_paddr = 0;
+			return -ENOMEM;
+		}
+	}
+
+	return 0;
+}
+
+static void codec_vp9_setup_workspace(struct amvdec_session *sess,
+				      struct codec_vp9 *vp9)
+{
+	struct amvdec_core *core = sess->core;
+	u32 revision = core->platform->revision;
+	dma_addr_t wkaddr = vp9->workspace_paddr;
+
+	meson_amvdec_write_dos(core, HEVCD_IPP_LINEBUFF_BASE, wkaddr + IPP_OFFSET);
+	meson_amvdec_write_dos(core, VP9_RPM_BUFFER, wkaddr + RPM_OFFSET);
+	meson_amvdec_write_dos(core, VP9_SHORT_TERM_RPS, wkaddr + SH_TM_RPS_OFFSET);
+	meson_amvdec_write_dos(core, VP9_PPS_BUFFER, wkaddr + PPS_OFFSET);
+	meson_amvdec_write_dos(core, VP9_SAO_UP, wkaddr + SAO_UP_OFFSET);
+
+	meson_amvdec_write_dos(core, VP9_STREAM_SWAP_BUFFER,
+			 wkaddr + SWAP_BUF_OFFSET);
+	meson_amvdec_write_dos(core, VP9_STREAM_SWAP_BUFFER2,
+			 wkaddr + SWAP_BUF2_OFFSET);
+	meson_amvdec_write_dos(core, VP9_SCALELUT, wkaddr + SCALELUT_OFFSET);
+
+	if (core->platform->revision >= AMVDEC_REVISION_G12A)
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFGE,
+				 wkaddr + DBLK_PARA_OFFSET);
+
+	meson_amvdec_write_dos(core, HEVC_DBLK_CFG4, wkaddr + DBLK_PARA_OFFSET);
+	meson_amvdec_write_dos(core, HEVC_DBLK_CFG5, wkaddr + DBLK_DATA_OFFSET);
+	meson_amvdec_write_dos(core, VP9_SEG_MAP_BUFFER, wkaddr + SEG_MAP_OFFSET);
+	meson_amvdec_write_dos(core, VP9_PROB_SWAP_BUFFER, wkaddr + PROB_OFFSET);
+	meson_amvdec_write_dos(core, VP9_COUNT_SWAP_BUFFER, wkaddr + COUNT_OFFSET);
+	meson_amvdec_write_dos(core, LMEM_DUMP_ADR, wkaddr + LMEM_OFFSET);
+
+	if (codec_hevc_use_mmu(revision, sess->pixfmt_cap, vp9->is_10bit)) {
+		meson_amvdec_write_dos(core, HEVC_SAO_MMU_VH0_ADDR,
+				 wkaddr + MMU_VBH_OFFSET);
+		meson_amvdec_write_dos(core, HEVC_SAO_MMU_VH1_ADDR,
+				 wkaddr + MMU_VBH_OFFSET + (MMU_VBH_SIZE / 2));
+
+		if (revision >= AMVDEC_REVISION_G12A)
+			meson_amvdec_write_dos(core, HEVC_ASSIST_MMU_MAP_ADDR,
+					 vp9->common.mmu_map_paddr);
+		else
+			meson_amvdec_write_dos(core, VP9_MMU_MAP_BUFFER,
+					 vp9->common.mmu_map_paddr);
+	}
+}
+
+/*
+ * Initialize VP9 hardware at startup and after stream-counter restart
+ * without replacing request or reference metadata.
+ */
+static void codec_vp9_hw_init(struct amvdec_session *sess, struct codec_vp9 *vp9)
+{
+	struct amvdec_core *core = sess->core;
+	u32 val;
+	int i;
+
+	codec_vp9_setup_workspace(sess, vp9);
+	meson_amvdec_write_dos_bits(core, HEVC_STREAM_CONTROL, BIT(0));
+	/* stream_fifo_hole */
+	if (core->platform->revision >= AMVDEC_REVISION_G12A)
+		meson_amvdec_write_dos_bits(core, HEVC_STREAM_FIFO_CTL, BIT(29));
+
+	val = meson_amvdec_read_dos(core, HEVC_PARSER_INT_CONTROL) & 0x7fffffff;
+	val |= (3 << 29) | BIT(24) | BIT(22) | BIT(7) | BIT(4) | BIT(0);
+	meson_amvdec_write_dos(core, HEVC_PARSER_INT_CONTROL, val);
+	meson_amvdec_write_dos_bits(core, HEVC_SHIFT_STATUS, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_SHIFT_CONTROL, BIT(10) | BIT(9) |
+			 (3 << 6) | BIT(5) | BIT(2) | BIT(1) | BIT(0));
+	meson_amvdec_write_dos(core, HEVC_CABAC_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_CORE_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_SHIFT_STARTCODE, 0x00000001);
+
+	meson_amvdec_write_dos(core, VP9_DEC_STATUS_REG, 0);
+
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_WRITE, BIT(16));
+	for (i = 0; i < ARRAY_SIZE(meson_amvdec_hevc_parser_cmd); ++i)
+		meson_amvdec_write_dos(core, HEVC_PARSER_CMD_WRITE,
+				 meson_amvdec_hevc_parser_cmd[i]);
+
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_0, PARSER_CMD_SKIP_CFG_0);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_1, PARSER_CMD_SKIP_CFG_1);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_2, PARSER_CMD_SKIP_CFG_2);
+	meson_amvdec_write_dos(core, HEVC_PARSER_IF_CONTROL,
+			 BIT(5) | BIT(2) | BIT(0));
+
+	meson_amvdec_write_dos(core, HEVCD_IPP_TOP_CNTL, BIT(0));
+	meson_amvdec_write_dos(core, HEVCD_IPP_TOP_CNTL, BIT(1));
+
+	meson_amvdec_write_dos(core, VP9_WAIT_FLAG, 1);
+
+	/* clear mailbox interrupt */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	/* enable mailbox interrupt */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_MASK, 1);
+	/* disable PSCALE for hardware sharing */
+	meson_amvdec_write_dos(core, HEVC_PSCALE_CTRL, 0);
+	/* Let the uCode do all the parsing */
+	meson_amvdec_write_dos(core, NAL_SEARCH_CTL, 0x8);
+
+	meson_amvdec_write_dos(core, DECODE_STOP_POS, 0);
+	meson_amvdec_write_dos(core, VP9_DECODE_MODE, DECODE_MODE_SINGLE);
+
+	pr_debug("decode_count: %u; decode_size: %u\n",
+		 meson_amvdec_read_dos(core, HEVC_DECODE_COUNT),
+		 meson_amvdec_read_dos(core, HEVC_DECODE_SIZE));
+
+	meson_amvdec_write_dos(core, HEVC_DECODE_SIZE, 0);
+	vp9_loop_filter_init(core, vp9);
+}
+
+/* See meson_amvdec_codec_hevc_arm_restream(): the same 2 GiB counter limit applies here. */
+void meson_amvdec_codec_vp9_arm_restream(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+
+	if (!vp9)
+		return;
+	if (meson_amvdec_read_dos(sess->core, HEVC_SHIFT_BYTE_COUNT) <
+	    (HEVC_STREAM_RESTART_MIB << 20))
+		return;
+	vp9->restream_pending = true;
+}
+
+bool meson_amvdec_codec_vp9_restream_pending(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+
+	return vp9 && vp9->restream_pending;
+}
+
+int meson_amvdec_codec_vp9_restream_reinit(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+
+	codec_vp9_hw_init(sess, vp9);
+	/*
+	 * Restore the capture address table and decode head after resetting the
+	 * core. Firmware remains halted during this setup.
+	 */
+	if (meson_amvdec_codec_hevc_setup_buffers(sess, &vp9->common, vp9->is_10bit))
+		return -EIO;
+	meson_amvdec_codec_hevc_setup_decode_head(sess, vp9->is_10bit);
+	vp9->request_parked = false;
+	vp9->restream_pending = false;
+	return 0;
+}
+
+static int codec_vp9_start(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9;
+	int i;
+	int ret;
+
+	vp9 = kzalloc_obj(*vp9);
+	if (!vp9)
+		return -ENOMEM;
+
+	/* Reclaim unused FBC pool pages before allocating the contiguous workspace. */
+	meson_amvdec_codec_hevc_fbc_pool_reclaim();
+
+	ret = codec_vp9_alloc_workspace(core, vp9);
+	if (ret)
+		goto free_vp9;
+
+	vp9->request_size = true;
+	codec_vp9_hw_init(sess, vp9);
+	dev_dbg(core->dev, "request start size=0 mode=0 origin_shift=%u rpm_bytes=%u\n",
+		meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT), RPM_BUF_SIZE);
+
+	INIT_LIST_HEAD(&vp9->ref_frames_list);
+	mutex_init(&vp9->lock);
+	for (i = 0; i < REFS_PER_FRAME; ++i)
+		vp9->frame_refs[i] = NULL;
+	sess->priv = vp9;
+
+	return 0;
+
+free_vp9:
+	kfree(vp9);
+	return ret;
+}
+
+static int codec_vp9_stop(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9 = sess->priv;
+	struct vp9_frame *frame, *next;
+
+	mutex_lock(&vp9->lock);
+	list_for_each_entry_safe(frame, next, &vp9->ref_frames_list, list) {
+		list_del(&frame->list);
+		kfree(frame);
+	}
+	vp9->cur_frame = NULL;
+	vp9->prev_frame = NULL;
+	if (vp9->workspace_vaddr) {
+		codec_vp9_verify_guards(sess, "vp9.stop");
+		meson_amvdec_dma_free_guarded(core->dev, vp9->workspace_paddr,
+					&vp9->workspace_guard);
+		vp9->workspace_vaddr = NULL;
+		vp9->workspace_paddr = 0;
+		/*
+		 * Free MV buffers under the workspace lock; the IRQ handler checks the
+		 * workspace pointer under the same lock.
+		 */
+		codec_vp9_free_mv_buffers(core, vp9);
+	}
+
+	meson_amvdec_codec_hevc_free_fbc_buffers(sess, &vp9->common);
+	mutex_unlock(&vp9->lock);
+
+	/*
+	 * Release unused pool pages while retaining the newest parked generation
+	 * for possible display scanout.
+	 */
+	meson_amvdec_codec_hevc_fbc_pool_reclaim();
+
+	return 0;
+}
+
+/*
+ * Program LAST & GOLDEN frames into the motion compensation reference cache
+ * controller
+ */
+static void codec_vp9_set_mcrcc(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9 = sess->priv;
+	u32 val;
+
+	/* Reset mcrcc */
+	meson_amvdec_write_dos(core, HEVCD_MCRCC_CTL1, 0x2);
+	/* Disable on I-frame */
+	if (vp9->cur_frame->type == KEY_FRAME || vp9->cur_frame->intra_only) {
+		meson_amvdec_write_dos(core, HEVCD_MCRCC_CTL1, 0x0);
+		return;
+	}
+
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, BIT(1));
+	val = meson_amvdec_read_dos(core, HEVCD_MPP_ANC_CANVAS_DATA_ADDR) & 0xffff;
+	val |= (val << 16);
+	meson_amvdec_write_dos(core, HEVCD_MCRCC_CTL2, val);
+	val = meson_amvdec_read_dos(core, HEVCD_MPP_ANC_CANVAS_DATA_ADDR) & 0xffff;
+	val |= (val << 16);
+	meson_amvdec_write_dos(core, HEVCD_MCRCC_CTL3, val);
+
+	/* Enable mcrcc progressive-mode */
+	meson_amvdec_write_dos(core, HEVCD_MCRCC_CTL1, 0xff0);
+}
+
+static int codec_vp9_set_sao(struct amvdec_session *sess,
+			     struct vb2_buffer *vb)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9 = sess->priv;
+
+	dma_addr_t buf_y_paddr;
+	dma_addr_t buf_u_v_paddr;
+	u32 val;
+	u32 output_size = meson_amvdec_get_output_size(sess);
+
+	if (vb->index >= MAX_REF_PIC_NUM)
+		return -EINVAL;
+
+	/* Driver-owned compressed body, as for HEVC: AM21C's one plane is the header */
+	if (codec_hevc_use_downsample(sess->pixfmt_cap, vp9->is_10bit) ||
+	    codec_hevc_use_mmu(core->platform->revision, sess->pixfmt_cap,
+			       vp9->is_10bit))
+		buf_y_paddr =
+			meson_amvdec_codec_hevc_fbc_body_addr(&vp9->common, vb->index);
+	else
+		buf_y_paddr =
+		       vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	if (codec_hevc_use_fbc(sess->pixfmt_cap, vp9->is_10bit)) {
+		if (!buf_y_paddr)
+			return -EINVAL;
+		meson_amvdec_write_dos(core, HEVC_CM_BODY_START_ADDR, buf_y_paddr);
+	}
+
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M) {
+		if (vb2_plane_size(vb, 0) < output_size ||
+		    vb2_plane_size(vb, 1) < output_size / 2)
+			return -EINVAL;
+		buf_y_paddr =
+		       vb2_dma_contig_plane_dma_addr(vb, 0);
+		buf_u_v_paddr =
+		       vb2_dma_contig_plane_dma_addr(vb, 1);
+		meson_amvdec_write_dos(core, HEVC_SAO_Y_START_ADDR, buf_y_paddr);
+		meson_amvdec_write_dos(core, HEVC_SAO_C_START_ADDR, buf_u_v_paddr);
+		meson_amvdec_write_dos(core, HEVC_SAO_Y_WPTR, buf_y_paddr);
+		meson_amvdec_write_dos(core, HEVC_SAO_C_WPTR, buf_u_v_paddr);
+	}
+
+	if (codec_hevc_use_mmu(core->platform->revision, sess->pixfmt_cap,
+			       vp9->is_10bit)) {
+		dma_addr_t header_adr;
+
+		if (codec_hevc_use_downsample(sess->pixfmt_cap, vp9->is_10bit))
+			header_adr = vp9->common.mmu_header_paddr[vb->index];
+		else
+			header_adr = vb2_dma_contig_plane_dma_addr(vb, 0);
+		if (!header_adr)
+			return -EINVAL;
+		meson_amvdec_write_dos(core, HEVC_CM_HEADER_START_ADDR, header_adr);
+		/* use HEVC_CM_HEADER_START_ADDR */
+		meson_amvdec_write_dos_bits(core, HEVC_SAO_CTRL5, BIT(10));
+	}
+
+	meson_amvdec_write_dos(core, HEVC_SAO_Y_LENGTH,
+			 output_size);
+	meson_amvdec_write_dos(core, HEVC_SAO_C_LENGTH,
+			 (output_size / 2));
+
+	if (core->platform->revision >= AMVDEC_REVISION_G12A) {
+		meson_amvdec_clear_dos_bits(core, HEVC_DBLK_CFGB,
+				      BIT(4) | BIT(5) | BIT(8) | BIT(9));
+		/* enable first, compressed write */
+		if (codec_hevc_use_fbc(sess->pixfmt_cap, vp9->is_10bit))
+			meson_amvdec_write_dos_bits(core, HEVC_DBLK_CFGB, BIT(8));
+
+		/* enable second, uncompressed write */
+		if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M)
+			meson_amvdec_write_dos_bits(core, HEVC_DBLK_CFGB, BIT(9));
+
+		/* dblk pipeline mode=1 for performance */
+		if (sess->width >= 1280)
+			meson_amvdec_write_dos_bits(core, HEVC_DBLK_CFGB, BIT(4));
+
+		pr_debug("HEVC_DBLK_CFGB: %08X\n",
+			 meson_amvdec_read_dos(core, HEVC_DBLK_CFGB));
+	}
+
+	val = meson_amvdec_read_dos(core, HEVC_SAO_CTRL1) & ~0x3ff0;
+	val |= 0xff0; /* Set endianness for 2-bytes swaps (nv12) */
+	if (core->platform->revision < AMVDEC_REVISION_G12A) {
+		val &= ~0x3;
+		if (!codec_hevc_use_fbc(sess->pixfmt_cap, vp9->is_10bit))
+			val |= BIT(0); /* disable cm compression */
+
+	}
+
+	meson_amvdec_write_dos(core, HEVC_SAO_CTRL1, val);
+	pr_debug("HEVC_SAO_CTRL1: %08X\n", val);
+
+	/* no downscale for NV12 */
+	val = meson_amvdec_read_dos(core, HEVC_SAO_CTRL5) & ~0xff0000;
+	meson_amvdec_write_dos(core, HEVC_SAO_CTRL5, val);
+
+	val = meson_amvdec_read_dos(core, HEVCD_IPP_AXIIF_CONFIG) & ~0x30;
+	val |= 0xf;
+	val &= ~BIT(12); /* NV12 */
+	meson_amvdec_write_dos(core, HEVCD_IPP_AXIIF_CONFIG, val);
+	return 0;
+}
+
+static dma_addr_t codec_vp9_get_frame_mv_paddr(struct codec_vp9 *vp9,
+					       struct vp9_frame *frame)
+{
+	u32 idx = frame->index;
+
+	if (WARN_ON_ONCE(idx >= MAX_REF_PIC_NUM))
+		idx = 0;
+
+	return vp9->mv_paddr[idx];
+}
+
+/*
+ * VP9 8.4 permits previous-frame MV reads only for inter pictures without
+ * error resilience.
+ */
+static bool codec_vp9_may_use_prev_mvs(struct codec_vp9 *vp9)
+{
+	union rpm_param *p = &vp9->rpm_param;
+
+	if (p->p.frame_type == KEY_FRAME || p->p.error_resilient_mode)
+		return false;
+	return p->p.show_frame ? true : !p->p.intra_only;
+}
+
+static int codec_vp9_set_mpred_mv(struct amvdec_core *core,
+				  struct codec_vp9 *vp9, bool inter)
+{
+	dma_addr_t mpred_mv_rd_end_addr;
+	u64 mv_extent = (u64)vp9->lcu_total * MV_MEM_UNIT;
+	int use_prev_frame_mvs = inter && codec_vp9_may_use_prev_mvs(vp9) &&
+				 vp9->prev_frame &&
+				 vp9->prev_frame->width ==
+					vp9->cur_frame->width &&
+				 vp9->prev_frame->height ==
+					vp9->cur_frame->height &&
+				 !vp9->prev_frame->intra_only &&
+				 vp9->prev_frame->show &&
+				 vp9->prev_frame->type != KEY_FRAME;
+
+	if (vp9->cur_frame->index >= MAX_REF_PIC_NUM ||
+	    (inter && vp9->prev_frame &&
+	     vp9->prev_frame->index >= MAX_REF_PIC_NUM))
+		return -EINVAL;
+
+	if (!vp9->lcu_total || mv_extent > MPRED_MV_BUF_SIZE) {
+		dev_err_ratelimited(core->dev,
+				    "VP9 MV extent %llu exceeds buffer %u (lcu_total %u)\n",
+				    mv_extent, MPRED_MV_BUF_SIZE,
+				    vp9->lcu_total);
+		return -EINVAL;
+	}
+
+	meson_amvdec_write_dos(core, HEVC_MPRED_CTRL3, 0x24122412);
+	meson_amvdec_write_dos(core, HEVC_MPRED_ABV_START_ADDR,
+			 vp9->workspace_paddr + MPRED_ABV_OFFSET);
+
+	meson_amvdec_clear_dos_bits(core, HEVC_MPRED_CTRL4, BIT(6));
+	if (use_prev_frame_mvs)
+		meson_amvdec_write_dos_bits(core, HEVC_MPRED_CTRL4, BIT(6));
+
+	meson_amvdec_write_dos(core, HEVC_MPRED_MV_WR_START_ADDR,
+			 codec_vp9_get_frame_mv_paddr(vp9, vp9->cur_frame));
+	meson_amvdec_write_dos(core, HEVC_MPRED_MV_WPTR,
+			 codec_vp9_get_frame_mv_paddr(vp9, vp9->cur_frame));
+
+	if (!inter || !vp9->prev_frame) {
+		meson_amvdec_write_dos(core, HEVC_MPRED_MV_RD_START_ADDR,
+				 codec_vp9_get_frame_mv_paddr(vp9,
+							      vp9->cur_frame));
+		meson_amvdec_write_dos(core, HEVC_MPRED_MV_RPTR,
+				 codec_vp9_get_frame_mv_paddr(vp9,
+							      vp9->cur_frame));
+		meson_amvdec_write_dos(core, HEVC_MPRED_MV_RD_END_ADDR,
+				 codec_vp9_get_frame_mv_paddr(vp9,
+							      vp9->cur_frame));
+		return 0;
+	}
+
+	meson_amvdec_write_dos(core, HEVC_MPRED_MV_RD_START_ADDR,
+			 codec_vp9_get_frame_mv_paddr(vp9, vp9->prev_frame));
+	meson_amvdec_write_dos(core, HEVC_MPRED_MV_RPTR,
+			 codec_vp9_get_frame_mv_paddr(vp9, vp9->prev_frame));
+
+	mpred_mv_rd_end_addr =
+			codec_vp9_get_frame_mv_paddr(vp9, vp9->prev_frame) +
+			(dma_addr_t)mv_extent;
+	meson_amvdec_write_dos(core, HEVC_MPRED_MV_RD_END_ADDR, mpred_mv_rd_end_addr);
+	return 0;
+}
+
+static struct vp9_frame *codec_vp9_get_frame_by_idx(struct codec_vp9 *vp9,
+						    int idx)
+{
+	struct vp9_frame *frame;
+
+	list_for_each_entry(frame, &vp9->ref_frames_list, list) {
+		if (frame->index == idx)
+			return frame;
+	}
+
+	return NULL;
+}
+
+static void codec_vp9_drop_frame(struct codec_vp9 *vp9, struct vp9_frame *frame)
+{
+	if (!frame->done)
+		vp9->frames_num--;
+	list_del(&frame->list);
+	kfree(frame);
+}
+
+static int codec_vp9_sync_ref_ctrl(struct amvdec_session *sess,
+				   struct codec_vp9 *vp9)
+{
+	static const char * const names[REFS_PER_FRAME] = {
+		"LAST", "GOLDEN", "ALT",
+	};
+	const struct v4l2_ctrl_vp9_frame *ctrl = &vp9->cur_frame->vp9_frame;
+	const u64 timestamps[REFS_PER_FRAME] = {
+		ctrl->last_frame_ts,
+		ctrl->golden_frame_ts,
+		ctrl->alt_frame_ts,
+	};
+	int i;
+
+	for (i = 0; i < REFS_PER_FRAME; ++i) {
+		struct vb2_buffer *vb;
+
+		vb = sess->request_job.refs[i];
+		if (sess->request_job.ref_ts[i] != timestamps[i])
+			return -EINVAL;
+		if (!vb) {
+			dev_err_ratelimited(sess->core->dev_dec,
+					    "VP9 %s reference timestamp %llu not found\n",
+				names[i], timestamps[i]);
+			return -ENOENT;
+		}
+
+		if (vb == &vp9->cur_frame->vbuf->vb2_buf) {
+			dev_err_ratelimited(sess->core->dev_dec,
+					    "VP9 %s reference timestamp %llu names current frame\n",
+				names[i], timestamps[i]);
+			return -EINVAL;
+		}
+
+		vp9->frame_refs[i] = codec_vp9_get_frame_by_idx(vp9,
+								vb->index);
+		if (!vp9->frame_refs[i]) {
+			dev_err_ratelimited(sess->core->dev_dec,
+					    "VP9 %s reference buffer %u has no frame metadata\n",
+				names[i], vb->index);
+			return -ENOENT;
+		}
+		if (vp9->frame_refs[i]->width != vp9->width ||
+		    vp9->frame_refs[i]->height != vp9->height) {
+			dev_err_ratelimited(sess->core->dev_dec,
+					    "VP9 %s reference geometry %ux%u differs from current %ux%u\n",
+				names[i], vp9->frame_refs[i]->width,
+				vp9->frame_refs[i]->height, vp9->width, vp9->height);
+			return -EOPNOTSUPP;
+		}
+	}
+
+	return 0;
+}
+
+static void codec_vp9_set_refs(struct amvdec_session *sess,
+			       struct codec_vp9 *vp9)
+{
+	struct amvdec_core *core = sess->core;
+	int i;
+
+	for (i = 0; i < REFS_PER_FRAME; ++i) {
+		struct vp9_frame *frame = vp9->frame_refs[i];
+		int id_y;
+		int id_u_v;
+
+		if (!frame)
+			continue;
+
+		if (codec_hevc_use_fbc(sess->pixfmt_cap, vp9->is_10bit)) {
+			id_y = frame->index;
+			id_u_v = id_y;
+		} else {
+			id_y = frame->index * 2;
+			id_u_v = id_y + 1;
+		}
+
+		meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_DATA_ADDR,
+				 (id_u_v << 16) | (id_u_v << 8) | id_y);
+	}
+}
+
+static void codec_vp9_set_mc(struct amvdec_session *sess,
+			     struct codec_vp9 *vp9)
+{
+	struct amvdec_core *core = sess->core;
+	u32 scale = 0;
+	u32 use_mmu;
+	u32 sz;
+	int i;
+
+	use_mmu = codec_hevc_use_mmu(core->platform->revision,
+				     sess->pixfmt_cap, vp9->is_10bit);
+
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+	codec_vp9_set_refs(sess, vp9);
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR,
+			 (16 << 8) | 1);
+	codec_vp9_set_refs(sess, vp9);
+
+	meson_amvdec_write_dos(core, VP9D_MPP_REFINFO_TBL_ACCCONFIG, BIT(2));
+	for (i = 0; i < REFS_PER_FRAME; ++i) {
+		if (!vp9->frame_refs[i])
+			continue;
+
+		if (vp9->frame_refs[i]->width != vp9->width ||
+		    vp9->frame_refs[i]->height != vp9->height)
+			scale = 1;
+
+		sz = meson_amvdec_amfbc_body_size(vp9->frame_refs[i]->width,
+					    vp9->frame_refs[i]->height,
+					    vp9->is_10bit, use_mmu);
+
+		meson_amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
+				 vp9->frame_refs[i]->width);
+		meson_amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
+				 vp9->frame_refs[i]->height);
+		meson_amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
+				 (vp9->frame_refs[i]->width << 14) /
+				 vp9->width);
+		meson_amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA,
+				 (vp9->frame_refs[i]->height << 14) /
+				 vp9->height);
+		meson_amvdec_write_dos(core, VP9D_MPP_REFINFO_DATA, sz >> 5);
+	}
+
+	meson_amvdec_write_dos(core, VP9D_MPP_REF_SCALE_ENBL, scale);
+}
+
+static struct vp9_frame *codec_vp9_get_new_frame(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	union rpm_param *param = &vp9->rpm_param;
+	struct vb2_v4l2_buffer *vbuf;
+	struct vp9_frame *new_frame;
+
+	new_frame = kzalloc_obj(*new_frame);
+	if (!new_frame)
+		return NULL;
+
+	vbuf = sess->request_job.dst;
+	if (!vbuf) {
+		dev_err_ratelimited(sess->core->dev, "No dst buffer available\n");
+		kfree(new_frame);
+		return NULL;
+	}
+
+	if (codec_vp9_get_frame_by_idx(vp9, vbuf->vb2_buf.index)) {
+		struct vp9_frame *old_frame;
+
+		old_frame = codec_vp9_get_frame_by_idx(vp9,
+						       vbuf->vb2_buf.index);
+		if (old_frame == vp9->prev_frame) {
+			/*
+			 * Retire previous-frame metadata on buffer reuse only when
+			 * the current picture cannot read those motion vectors.
+			 */
+			if (codec_vp9_may_use_prev_mvs(vp9)) {
+				kfree(new_frame);
+				meson_amvdec_abort(sess);
+				return NULL;
+			}
+			vp9->prev_frame = NULL;
+		}
+		codec_vp9_drop_frame(vp9, old_frame);
+
+	}
+
+	/* Same guard as HEVC: no frame into an unbacked CAPTURE buffer */
+	if (meson_amvdec_codec_hevc_ensure_frame_buffer(sess, &vp9->common,
+					   &vbuf->vb2_buf, vp9->is_10bit)) {
+		kfree(new_frame);
+		return NULL;
+	}
+
+	if (meson_amvdec_dst_buf_prepare_stateless(sess, vbuf,
+						   &new_frame->vp9_frame, &new_frame->input_end)) {
+		meson_amvdec_dst_buf_error_stateless(sess, vbuf);
+		kfree(new_frame);
+		return NULL;
+	}
+
+	new_frame->vbuf = vbuf;
+	new_frame->index = vbuf->vb2_buf.index;
+	/*
+	 * intra_only is coded only for hidden pictures (VP9 6.2). Ignore the RPM
+	 * bit for shown pictures.
+	 */
+	new_frame->intra_only = param->p.show_frame ? 0 : param->p.intra_only;
+	new_frame->show = param->p.show_frame;
+	new_frame->type = param->p.frame_type;
+
+	new_frame->width = vp9->width;
+	new_frame->height = vp9->height;
+	list_add_tail(&new_frame->list, &vp9->ref_frames_list);
+	vp9->frames_num++;
+
+	return new_frame;
+}
+
+static void codec_vp9_show_existing_frame(struct codec_vp9 *vp9)
+{
+	union rpm_param *param = &vp9->rpm_param;
+
+	if (!param->p.show_existing_frame)
+		return;
+
+	pr_debug("showing frame %u\n", param->p.frame_to_show_idx);
+}
+
+static void codec_vp9_process_frame(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9 = sess->priv;
+	union rpm_param *param = &vp9->rpm_param;
+	int intra_only;
+	bool inter;
+
+	vp9->cur_frame = codec_vp9_get_new_frame(sess);
+	if (!vp9->cur_frame) {
+		meson_amvdec_abort(sess);
+		return;
+	}
+
+	pr_debug("frame %d: type: %08X; show_exist: %u; show: %u, intra_only: %u\n",
+		 vp9->cur_frame->index,
+		 param->p.frame_type, param->p.show_existing_frame,
+		 param->p.show_frame, param->p.intra_only);
+
+	intra_only = param->p.show_frame ? 0 : param->p.intra_only;
+
+	if (param->p.frame_type != KEY_FRAME && !intra_only) {
+		int ret;
+
+		ret = codec_vp9_sync_ref_ctrl(sess, vp9);
+
+		if (ret) {
+			meson_amvdec_dst_buf_error_stateless(sess,
+						       vp9->cur_frame->vbuf);
+			codec_vp9_drop_frame(vp9, vp9->cur_frame);
+			vp9->cur_frame = NULL;
+			meson_amvdec_abort(sess);
+			return;
+		}
+	}
+
+	codec_vp9_show_existing_frame(vp9);
+
+	if (codec_hevc_use_mmu(core->platform->revision, sess->pixfmt_cap,
+			       vp9->is_10bit) &&
+	    meson_amvdec_codec_hevc_fill_mmu_map(sess, &vp9->common,
+				    &vp9->cur_frame->vbuf->vb2_buf,
+				    vp9->is_10bit)) {
+		meson_amvdec_dst_buf_error_stateless(sess, vp9->cur_frame->vbuf);
+		codec_vp9_drop_frame(vp9, vp9->cur_frame);
+		vp9->cur_frame = NULL;
+		meson_amvdec_abort(sess);
+		return;
+	}
+
+	inter = param->p.frame_type != KEY_FRAME && !intra_only;
+	if (inter)
+		codec_vp9_set_mc(sess, vp9);
+	if (codec_vp9_set_mpred_mv(core, vp9, inter)) {
+		meson_amvdec_dst_buf_error_stateless(sess, vp9->cur_frame->vbuf);
+		codec_vp9_drop_frame(vp9, vp9->cur_frame);
+		vp9->cur_frame = NULL;
+		meson_amvdec_abort(sess);
+		return;
+	}
+
+	meson_amvdec_write_dos(core, HEVC_PARSER_PICTURE_SIZE,
+			 (vp9->height << 16) | vp9->width);
+	codec_vp9_set_mcrcc(sess);
+	if (codec_vp9_set_sao(sess, &vp9->cur_frame->vbuf->vb2_buf)) {
+		meson_amvdec_dst_buf_error_stateless(sess, vp9->cur_frame->vbuf);
+		codec_vp9_drop_frame(vp9, vp9->cur_frame);
+		vp9->cur_frame = NULL;
+		meson_amvdec_abort(sess);
+		return;
+	}
+
+	vp9_loop_filter_frame_init(core, &vp9->seg_4lf,
+				   &vp9->lfi, &vp9->lf,
+				   vp9->default_filt_lvl);
+
+	u32 end = vp9->cur_frame->input_end;
+
+	if (!end || vp9->request_parked || vp9->request_failed) {
+		vp9->request_failed = true;
+		meson_amvdec_abort(sess);
+		return;
+	}
+	/*
+	 * Firmware completes a picture when consumed + 4 reaches DECODE_SIZE.
+	 * After header parsing, publish a size no greater than the current shift
+	 * position plus one so boolean-decoder read-ahead cannot prevent completion.
+	 * Restore the real endpoint before releasing the next frame search.
+	 */
+	u32 shift = meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT);
+	u32 size = vp9->request_size ? min(end, shift + 1) : 0;
+
+	meson_amvdec_write_dos(core, HEVC_DECODE_SIZE, size);
+	meson_amvdec_trace(sess, AMVDEC_TR_KICK, size, end, shift);
+	dev_dbg(core->dev, "kick ts=%llu idx=%u size=%u end=%u shift=%u show=%u\n",
+		vp9->cur_frame->vbuf->vb2_buf.timestamp,
+		 vp9->cur_frame->index, size, end, shift, vp9->cur_frame->show);
+	/* ask uCode to start decoding */
+	meson_amvdec_write_dos_action(core, VP9_DEC_STATUS_REG,
+				VP9_10B_DECODE_SLICE);
+}
+
+static void codec_vp9_process_lf(struct codec_vp9 *vp9)
+{
+	union rpm_param *param = &vp9->rpm_param;
+	int i;
+
+	vp9->lf.mode_ref_delta_enabled = param->p.mode_ref_delta_enabled;
+	vp9->lf.sharpness_level = param->p.sharpness_level;
+	vp9->default_filt_lvl = param->p.filter_level;
+	vp9->seg_4lf.enabled = param->p.seg_enabled;
+	vp9->seg_4lf.abs_delta = param->p.seg_abs_delta;
+
+	for (i = 0; i < 4; i++)
+		vp9->lf.ref_deltas[i] = param->p.ref_deltas[i];
+
+	for (i = 0; i < 2; i++)
+		vp9->lf.mode_deltas[i] = param->p.mode_deltas[i];
+
+	for (i = 0; i < MAX_SEGMENTS; i++)
+		vp9->seg_4lf.feature_mask[i] =
+			(param->p.seg_lf_info[i] & 0x8000) ?
+				(1 << SEG_LVL_ALT_LF) : 0;
+
+	for (i = 0; i < MAX_SEGMENTS; i++)
+		vp9->seg_4lf.feature_data[i][SEG_LVL_ALT_LF] =
+			(param->p.seg_lf_info[i] & 0x100) ?
+				-(param->p.seg_lf_info[i] & 0x3f)
+				: (param->p.seg_lf_info[i] & 0x3f);
+}
+
+static void codec_vp9_configure(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+
+	mutex_lock(&vp9->lock);
+	if (meson_amvdec_codec_hevc_setup_buffers(sess, &vp9->common, vp9->is_10bit)) {
+		mutex_unlock(&vp9->lock);
+		meson_amvdec_abort(sess);
+		return;
+	}
+
+	codec_vp9_setup_workspace(sess, vp9);
+	meson_amvdec_codec_hevc_setup_decode_head(sess, vp9->is_10bit);
+	codec_vp9_process_lf(vp9);
+	codec_vp9_process_frame(sess);
+
+	mutex_unlock(&vp9->lock);
+}
+
+/* Read firmware parameters from the workspace RPM block. */
+static void codec_vp9_fetch_rpm(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	u16 *rpm_vaddr = vp9->workspace_vaddr + RPM_OFFSET;
+	int i, j;
+
+	for (i = 0; i < RPM_WORDS; i += 4)
+		for (j = 0; j < 4; j++)
+			vp9->rpm_param.l.data[i + j] = rpm_vaddr[i + 3 - j];
+}
+
+static int codec_vp9_process_rpm(struct amvdec_session *sess,
+				 struct codec_vp9 *vp9)
+{
+	union rpm_param *param = &vp9->rpm_param;
+	int src_changed = 0;
+	int is_10bit = 0;
+	int pic_width_64;
+	int pic_height_32;
+	int pic_width_lcu;
+	int pic_height_lcu;
+
+	if (param->p.width < amvdec_min_coded_width(sess->fmt_out->pixfmt) ||
+	    param->p.height < amvdec_min_coded_height(sess->fmt_out->pixfmt)) {
+		dev_err_ratelimited(sess->core->dev,
+				    "VP9 coded size %ux%u below hardware floor\n",
+				    param->p.width, param->p.height);
+		return -EINVAL;
+	}
+	if (param->p.width > sess->fmt_out->max_width ||
+	    param->p.height > sess->fmt_out->max_height) {
+		dev_err_ratelimited(sess->core->dev,
+				    "VP9 coded size %ux%u above format maximum\n",
+				    param->p.width, param->p.height);
+		return -EINVAL;
+	}
+	if (param->p.width != sess->width || param->p.height != sess->height) {
+		dev_err_ratelimited(sess->core->dev,
+				    "VP9 coded size changed from negotiated %ux%u to %ux%u\n",
+				    sess->width, sess->height,
+				    param->p.width, param->p.height);
+		return -EINVAL;
+	}
+
+	pic_width_64 = ALIGN(param->p.width, 64);
+	pic_height_32 = ALIGN(param->p.height, 32);
+	pic_width_lcu  = (pic_width_64 % LCU_SIZE) ?
+			 pic_width_64 / LCU_SIZE  + 1 :
+			 pic_width_64 / LCU_SIZE;
+	pic_height_lcu = (pic_height_32 % LCU_SIZE) ?
+			 pic_height_32 / LCU_SIZE + 1 :
+			 pic_height_32 / LCU_SIZE;
+	vp9->lcu_total = pic_width_lcu * pic_height_lcu;
+
+	if (param->p.bit_depth == 10)
+		is_10bit = 1;
+
+	if (vp9->width != param->p.width || vp9->height != param->p.height ||
+	    vp9->is_10bit != is_10bit)
+		src_changed = 1;
+
+	vp9->width = param->p.width;
+	vp9->height = param->p.height;
+	vp9->is_10bit = is_10bit;
+
+	pr_debug("width: %u; height: %u; is_10bit: %d; src_changed: %d\n",
+		 vp9->width, vp9->height, is_10bit, src_changed);
+
+	return src_changed;
+}
+
+static void codec_vp9_show_frame(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct vp9_frame *tmp, *n;
+
+	list_for_each_entry_safe(tmp, n, &vp9->ref_frames_list, list) {
+		if (!tmp->show || tmp == vp9->cur_frame)
+			continue;
+
+		if (!tmp->done) {
+			pr_debug("Doning %u\n", tmp->index);
+			if (codec_vp9_verify_guards(sess, "vp9.show"))
+				meson_amvdec_dst_buf_error_stateless(sess, tmp->vbuf);
+			else
+				meson_amvdec_dst_buf_done_stateless(sess, tmp->vbuf,
+								    V4L2_FIELD_NONE);
+			tmp->done = 1;
+			vp9->frames_num--;
+		}
+
+	}
+}
+
+static void vp9_tree_merge_probs(unsigned int *prev_prob,
+				 unsigned int *cur_prob,
+				 int coef_node_start, int tree_left,
+				 int tree_right,
+				 int tree_i, int node)
+{
+	int prob_32, prob_res, prob_shift;
+	int pre_prob, new_prob;
+	int den, m_count, get_prob, factor;
+
+	prob_32 = prev_prob[coef_node_start / 4 * 2];
+	prob_res = coef_node_start & 3;
+	prob_shift = prob_res * 8;
+	pre_prob = (prob_32 >> prob_shift) & 0xff;
+
+	den = tree_left + tree_right;
+
+	if (den == 0) {
+		new_prob = pre_prob;
+	} else {
+		m_count = min(den, MODE_MV_COUNT_SAT);
+		get_prob =
+			clip_prob(div_r32(((int64_t)tree_left * 256 +
+					   (den >> 1)),
+					  den));
+
+		/* weighted_prob */
+		factor = count_to_update_factor[m_count];
+		new_prob = round_power_of_two(pre_prob * (256 - factor) +
+					      get_prob * factor, 8);
+	}
+
+	cur_prob[coef_node_start / 4 * 2] =
+		(cur_prob[coef_node_start / 4 * 2] & (~(0xff << prob_shift))) |
+		(new_prob << prob_shift);
+}
+
+static void adapt_coef_probs_cxt(unsigned int *prev_prob,
+				 unsigned int *cur_prob,
+				 unsigned int *count,
+				 int update_factor,
+				 int cxt_num,
+				 int coef_cxt_start,
+				 int coef_count_cxt_start)
+{
+	int prob_32, prob_res, prob_shift;
+	int pre_prob, new_prob;
+	int num, den, m_count, get_prob, factor;
+	int node, coef_node_start;
+	int count_sat = 24;
+	int cxt;
+
+	for (cxt = 0; cxt < cxt_num; cxt++) {
+		const int n0 = count[coef_count_cxt_start];
+		const int n1 = count[coef_count_cxt_start + 1];
+		const int n2 = count[coef_count_cxt_start + 2];
+		const int neob = count[coef_count_cxt_start + 3];
+		const int nneob = count[coef_count_cxt_start + 4];
+		const unsigned int branch_ct[3][2] = {
+			{ neob, nneob },
+			{ n0, n1 + n2 },
+			{ n1, n2 }
+		};
+
+		coef_node_start = coef_cxt_start;
+		for (node = 0 ; node < 3 ; node++) {
+			prob_32 = prev_prob[coef_node_start / 4 * 2];
+			prob_res = coef_node_start & 3;
+			prob_shift = prob_res * 8;
+			pre_prob = (prob_32 >> prob_shift) & 0xff;
+
+			/* get binary prob */
+			num = branch_ct[node][0];
+			den = branch_ct[node][0] + branch_ct[node][1];
+			m_count = min(den, count_sat);
+
+			get_prob = (den == 0) ?
+					128u :
+					clip_prob(div_r32(((int64_t)num * 256 +
+							  (den >> 1)), den));
+
+			factor = update_factor * m_count / count_sat;
+			new_prob =
+				round_power_of_two(pre_prob * (256 - factor) +
+						   get_prob * factor, 8);
+
+			cur_prob[coef_node_start / 4 * 2] =
+				(cur_prob[coef_node_start / 4 * 2] &
+				 (~(0xff << prob_shift))) |
+				(new_prob << prob_shift);
+
+			coef_node_start += 1;
+		}
+
+		coef_cxt_start = coef_cxt_start + 3;
+		coef_count_cxt_start = coef_count_cxt_start + 5;
+	}
+}
+
+static void adapt_coef_probs(int prev_kf, int cur_kf, int pre_fc,
+			     unsigned int *prev_prob, unsigned int *cur_prob,
+			     unsigned int *count)
+{
+	int tx_size, coef_tx_size_start, coef_count_tx_size_start;
+	int plane, coef_plane_start, coef_count_plane_start;
+	int type, coef_type_start, coef_count_type_start;
+	int band, coef_band_start, coef_count_band_start;
+	int cxt_num;
+	int coef_cxt_start, coef_count_cxt_start;
+	int node, coef_node_start, coef_count_node_start;
+
+	int tree_i, tree_left, tree_right;
+	int mvd_i;
+
+	int update_factor = cur_kf ? 112 : (prev_kf ? 128 : 112);
+
+	int prob_32;
+	int prob_res;
+	int prob_shift;
+	int pre_prob;
+
+	int den;
+	int get_prob;
+	int m_count;
+	int factor;
+
+	int new_prob;
+
+	for (tx_size = 0 ; tx_size < 4 ; tx_size++) {
+		coef_tx_size_start = VP9_COEF_START +
+				tx_size * 4 * VP9_COEF_SIZE_ONE_SET;
+		coef_count_tx_size_start = VP9_COEF_COUNT_START +
+				tx_size * 4 * VP9_COEF_COUNT_SIZE_ONE_SET;
+		coef_plane_start = coef_tx_size_start;
+		coef_count_plane_start = coef_count_tx_size_start;
+
+		for (plane = 0 ; plane < 2 ; plane++) {
+			coef_type_start = coef_plane_start;
+			coef_count_type_start = coef_count_plane_start;
+
+			for (type = 0 ; type < 2 ; type++) {
+				coef_band_start = coef_type_start;
+				coef_count_band_start = coef_count_type_start;
+
+				for (band = 0 ; band < 6 ; band++) {
+					if (band == 0)
+						cxt_num = 3;
+					else
+						cxt_num = 6;
+					coef_cxt_start = coef_band_start;
+					coef_count_cxt_start =
+						coef_count_band_start;
+
+					adapt_coef_probs_cxt(prev_prob,
+							     cur_prob,
+							     count,
+							     update_factor,
+							     cxt_num,
+							     coef_cxt_start,
+							coef_count_cxt_start);
+
+					if (band == 0) {
+						coef_band_start += 10;
+						coef_count_band_start += 15;
+					} else {
+						coef_band_start += 18;
+						coef_count_band_start += 30;
+					}
+				}
+				coef_type_start += VP9_COEF_SIZE_ONE_SET;
+				coef_count_type_start +=
+					VP9_COEF_COUNT_SIZE_ONE_SET;
+			}
+
+			coef_plane_start += 2 * VP9_COEF_SIZE_ONE_SET;
+			coef_count_plane_start +=
+				2 * VP9_COEF_COUNT_SIZE_ONE_SET;
+		}
+	}
+
+	if (cur_kf == 0) {
+		/* mode_mv_merge_probs - merge_intra_inter_prob */
+		for (coef_count_node_start = VP9_INTRA_INTER_COUNT_START;
+		     coef_count_node_start < (VP9_MV_CLASS0_HP_1_COUNT_START +
+					      VP9_MV_CLASS0_HP_1_COUNT_SIZE);
+		     coef_count_node_start += 2) {
+			if (coef_count_node_start ==
+					VP9_INTRA_INTER_COUNT_START)
+				coef_node_start = VP9_INTRA_INTER_START;
+			else if (coef_count_node_start ==
+					VP9_COMP_INTER_COUNT_START)
+				coef_node_start = VP9_COMP_INTER_START;
+			else if (coef_count_node_start ==
+					VP9_TX_MODE_COUNT_START)
+				coef_node_start = VP9_TX_MODE_START;
+			else if (coef_count_node_start ==
+					VP9_SKIP_COUNT_START)
+				coef_node_start = VP9_SKIP_START;
+			else if (coef_count_node_start ==
+					VP9_MV_SIGN_0_COUNT_START)
+				coef_node_start = VP9_MV_SIGN_0_START;
+			else if (coef_count_node_start ==
+					VP9_MV_SIGN_1_COUNT_START)
+				coef_node_start = VP9_MV_SIGN_1_START;
+			else if (coef_count_node_start ==
+					VP9_MV_BITS_0_COUNT_START)
+				coef_node_start = VP9_MV_BITS_0_START;
+			else if (coef_count_node_start ==
+					VP9_MV_BITS_1_COUNT_START)
+				coef_node_start = VP9_MV_BITS_1_START;
+			else if (coef_count_node_start ==
+					VP9_MV_CLASS0_HP_0_COUNT_START)
+				coef_node_start = VP9_MV_CLASS0_HP_0_START;
+			/*
+			 * Otherwise this is a further entry of the current
+			 * section and coef_node_start already points at it.
+			 */
+
+			den = count[coef_count_node_start] +
+			      count[coef_count_node_start + 1];
+
+			prob_32 = prev_prob[coef_node_start / 4 * 2];
+			prob_res = coef_node_start & 3;
+			prob_shift = prob_res * 8;
+			pre_prob = (prob_32 >> prob_shift) & 0xff;
+
+			if (den == 0) {
+				new_prob = pre_prob;
+			} else {
+				m_count = min(den, MODE_MV_COUNT_SAT);
+				get_prob =
+				clip_prob(div_r32(((int64_t)
+					count[coef_count_node_start] * 256 +
+					(den >> 1)),
+					den));
+
+				/* weighted prob */
+				factor = count_to_update_factor[m_count];
+				new_prob =
+					round_power_of_two(pre_prob *
+							   (256 - factor) +
+							   get_prob * factor,
+							   8);
+			}
+
+			cur_prob[coef_node_start / 4 * 2] =
+				(cur_prob[coef_node_start / 4 * 2] &
+				 (~(0xff << prob_shift))) |
+				(new_prob << prob_shift);
+
+			coef_node_start = coef_node_start + 1;
+		}
+
+		coef_node_start = VP9_INTER_MODE_START;
+		coef_count_node_start = VP9_INTER_MODE_COUNT_START;
+		for (tree_i = 0 ; tree_i < 7 ; tree_i++) {
+			for (node = 0 ; node < 3 ; node++) {
+				unsigned int start = coef_count_node_start;
+
+				switch (node) {
+				case 2:
+					tree_left = count[start + 1];
+					tree_right = count[start + 3];
+					break;
+				case 1:
+					tree_left = count[start + 0];
+					tree_right = count[start + 1] +
+						     count[start + 3];
+					break;
+				default:
+					tree_left = count[start + 2];
+					tree_right = count[start + 0] +
+						     count[start + 1] +
+						     count[start + 3];
+					break;
+				}
+
+				vp9_tree_merge_probs(prev_prob, cur_prob,
+						     coef_node_start,
+						     tree_left, tree_right,
+						     tree_i, node);
+
+				coef_node_start = coef_node_start + 1;
+			}
+
+			coef_count_node_start = coef_count_node_start + 4;
+		}
+
+		coef_node_start = VP9_IF_Y_MODE_START;
+		coef_count_node_start = VP9_IF_Y_MODE_COUNT_START;
+		for (tree_i = 0 ; tree_i < 14 ; tree_i++) {
+			for (node = 0 ; node < 9 ; node++) {
+				unsigned int start = coef_count_node_start;
+
+				switch (node) {
+				case 8:
+					tree_left =
+						count[start + D153_PRED];
+					tree_right =
+						count[start + D207_PRED];
+					break;
+				case 7:
+					tree_left =
+						count[start + D63_PRED];
+					tree_right =
+						count[start + D207_PRED] +
+						count[start + D153_PRED];
+					break;
+				case 6:
+					tree_left =
+						count[start + D45_PRED];
+					tree_right =
+						count[start + D207_PRED] +
+						count[start + D153_PRED] +
+						count[start + D63_PRED];
+					break;
+				case 5:
+					tree_left =
+						count[start + D135_PRED];
+					tree_right =
+						count[start + D117_PRED];
+					break;
+				case 4:
+					tree_left =
+						count[start + H_PRED];
+					tree_right =
+						count[start + D117_PRED] +
+						count[start + D135_PRED];
+					break;
+				case 3:
+					tree_left =
+						count[start + H_PRED] +
+						count[start + D117_PRED] +
+						count[start + D135_PRED];
+					tree_right =
+						count[start + D45_PRED] +
+						count[start + D207_PRED] +
+						count[start + D153_PRED] +
+						count[start + D63_PRED];
+					break;
+				case 2:
+					tree_left =
+						count[start + V_PRED];
+					tree_right =
+						count[start + H_PRED] +
+						count[start + D117_PRED] +
+						count[start + D135_PRED] +
+						count[start + D45_PRED] +
+						count[start + D207_PRED] +
+						count[start + D153_PRED] +
+						count[start + D63_PRED];
+					break;
+				case 1:
+					tree_left =
+						count[start + TM_PRED];
+					tree_right =
+						count[start + V_PRED] +
+						count[start + H_PRED] +
+						count[start + D117_PRED] +
+						count[start + D135_PRED] +
+						count[start + D45_PRED] +
+						count[start + D207_PRED] +
+						count[start + D153_PRED] +
+						count[start + D63_PRED];
+					break;
+				default:
+					tree_left =
+						count[start + DC_PRED];
+					tree_right =
+						count[start + TM_PRED] +
+						count[start + V_PRED] +
+						count[start + H_PRED] +
+						count[start + D117_PRED] +
+						count[start + D135_PRED] +
+						count[start + D45_PRED] +
+						count[start + D207_PRED] +
+						count[start + D153_PRED] +
+						count[start + D63_PRED];
+					break;
+				}
+
+				vp9_tree_merge_probs(prev_prob, cur_prob,
+						     coef_node_start,
+						     tree_left, tree_right,
+						     tree_i, node);
+
+				coef_node_start = coef_node_start + 1;
+			}
+			coef_count_node_start = coef_count_node_start + 10;
+		}
+
+		coef_node_start = VP9_PARTITION_P_START;
+		coef_count_node_start = VP9_PARTITION_P_COUNT_START;
+		for (tree_i = 0 ; tree_i < 16 ; tree_i++) {
+			for (node = 0 ; node < 3 ; node++) {
+				unsigned int start = coef_count_node_start;
+
+				switch (node) {
+				case 2:
+					tree_left = count[start + 2];
+					tree_right = count[start + 3];
+					break;
+				case 1:
+					tree_left = count[start + 1];
+					tree_right = count[start + 2] +
+						     count[start + 3];
+					break;
+				default:
+					tree_left = count[start + 0];
+					tree_right = count[start + 1] +
+						     count[start + 2] +
+						     count[start + 3];
+					break;
+				}
+
+				vp9_tree_merge_probs(prev_prob, cur_prob,
+						     coef_node_start,
+						     tree_left, tree_right,
+						     tree_i, node);
+
+				coef_node_start = coef_node_start + 1;
+			}
+
+			coef_count_node_start = coef_count_node_start + 4;
+		}
+
+		coef_node_start = VP9_INTERP_START;
+		coef_count_node_start = VP9_INTERP_COUNT_START;
+		for (tree_i = 0 ; tree_i < 4 ; tree_i++) {
+			for (node = 0 ; node < 2 ; node++) {
+				unsigned int start = coef_count_node_start;
+
+				switch (node) {
+				case 1:
+					tree_left = count[start + 1];
+					tree_right = count[start + 2];
+					break;
+				default:
+					tree_left = count[start + 0];
+					tree_right = count[start + 1] +
+						     count[start + 2];
+					break;
+				}
+
+				vp9_tree_merge_probs(prev_prob, cur_prob,
+						     coef_node_start,
+						     tree_left, tree_right,
+						     tree_i, node);
+
+				coef_node_start = coef_node_start + 1;
+			}
+			coef_count_node_start = coef_count_node_start + 3;
+		}
+
+		coef_node_start = VP9_MV_JOINTS_START;
+		coef_count_node_start = VP9_MV_JOINTS_COUNT_START;
+		for (tree_i = 0 ; tree_i < 1 ; tree_i++) {
+			for (node = 0 ; node < 3 ; node++) {
+				unsigned int start = coef_count_node_start;
+
+				switch (node) {
+				case 2:
+					tree_left = count[start + 2];
+					tree_right = count[start + 3];
+					break;
+				case 1:
+					tree_left = count[start + 1];
+					tree_right = count[start + 2] +
+						     count[start + 3];
+					break;
+				default:
+					tree_left = count[start + 0];
+					tree_right = count[start + 1] +
+						     count[start + 2] +
+						     count[start + 3];
+					break;
+				}
+
+				vp9_tree_merge_probs(prev_prob, cur_prob,
+						     coef_node_start,
+						     tree_left, tree_right,
+						     tree_i, node);
+
+				coef_node_start = coef_node_start + 1;
+			}
+			coef_count_node_start = coef_count_node_start + 4;
+		}
+
+		for (mvd_i = 0 ; mvd_i < 2 ; mvd_i++) {
+			coef_node_start = mvd_i ? VP9_MV_CLASSES_1_START :
+						  VP9_MV_CLASSES_0_START;
+			coef_count_node_start = mvd_i ?
+					VP9_MV_CLASSES_1_COUNT_START :
+					VP9_MV_CLASSES_0_COUNT_START;
+			tree_i = 0;
+			for (node = 0; node < 10; node++) {
+				unsigned int start = coef_count_node_start;
+
+				switch (node) {
+				case 9:
+					tree_left = count[start + 9];
+					tree_right = count[start + 10];
+					break;
+				case 8:
+					tree_left = count[start + 7];
+					tree_right = count[start + 8];
+					break;
+				case 7:
+					tree_left = count[start + 7] +
+						     count[start + 8];
+					tree_right = count[start + 9] +
+						     count[start + 10];
+					break;
+				case 6:
+					tree_left = count[start + 6];
+					tree_right = count[start + 7] +
+						     count[start + 8] +
+						     count[start + 9] +
+						     count[start + 10];
+					break;
+				case 5:
+					tree_left = count[start + 4];
+					tree_right = count[start + 5];
+					break;
+				case 4:
+					tree_left = count[start + 4] +
+						    count[start + 5];
+					tree_right = count[start + 6] +
+						     count[start + 7] +
+						     count[start + 8] +
+						     count[start + 9] +
+						     count[start + 10];
+					break;
+				case 3:
+					tree_left = count[start + 2];
+					tree_right = count[start + 3];
+					break;
+				case 2:
+					tree_left = count[start + 2] +
+						    count[start + 3];
+					tree_right = count[start + 4] +
+						     count[start + 5] +
+						     count[start + 6] +
+						     count[start + 7] +
+						     count[start + 8] +
+						     count[start + 9] +
+						     count[start + 10];
+					break;
+				case 1:
+					tree_left = count[start + 1];
+					tree_right = count[start + 2] +
+						     count[start + 3] +
+						     count[start + 4] +
+						     count[start + 5] +
+						     count[start + 6] +
+						     count[start + 7] +
+						     count[start + 8] +
+						     count[start + 9] +
+						     count[start + 10];
+					break;
+				default:
+					tree_left = count[start + 0];
+					tree_right = count[start + 1] +
+						     count[start + 2] +
+						     count[start + 3] +
+						     count[start + 4] +
+						     count[start + 5] +
+						     count[start + 6] +
+						     count[start + 7] +
+						     count[start + 8] +
+						     count[start + 9] +
+						     count[start + 10];
+					break;
+				}
+
+				vp9_tree_merge_probs(prev_prob, cur_prob,
+						     coef_node_start,
+						     tree_left, tree_right,
+						     tree_i, node);
+
+				coef_node_start = coef_node_start + 1;
+			}
+
+			coef_node_start = mvd_i ? VP9_MV_CLASS0_1_START :
+						  VP9_MV_CLASS0_0_START;
+			coef_count_node_start =	mvd_i ?
+						VP9_MV_CLASS0_1_COUNT_START :
+						VP9_MV_CLASS0_0_COUNT_START;
+			tree_i = 0;
+			node = 0;
+			tree_left = count[coef_count_node_start + 0];
+			tree_right = count[coef_count_node_start + 1];
+
+			vp9_tree_merge_probs(prev_prob, cur_prob,
+					     coef_node_start,
+					     tree_left, tree_right,
+					     tree_i, node);
+			coef_node_start = mvd_i ? VP9_MV_CLASS0_FP_1_START :
+						  VP9_MV_CLASS0_FP_0_START;
+			coef_count_node_start =	mvd_i ?
+					VP9_MV_CLASS0_FP_1_COUNT_START :
+					VP9_MV_CLASS0_FP_0_COUNT_START;
+
+			for (tree_i = 0; tree_i < 3; tree_i++) {
+				for (node = 0; node < 3; node++) {
+					unsigned int start =
+						coef_count_node_start;
+					switch (node) {
+					case 2:
+						tree_left = count[start + 2];
+						tree_right = count[start + 3];
+						break;
+					case 1:
+						tree_left = count[start + 1];
+						tree_right = count[start + 2] +
+							     count[start + 3];
+						break;
+					default:
+						tree_left = count[start + 0];
+						tree_right = count[start + 1] +
+							     count[start + 2] +
+							     count[start + 3];
+						break;
+					}
+
+					vp9_tree_merge_probs(prev_prob,
+							     cur_prob,
+							     coef_node_start,
+							     tree_left,
+							     tree_right,
+							     tree_i, node);
+
+					coef_node_start = coef_node_start + 1;
+				}
+				coef_count_node_start =
+					coef_count_node_start + 4;
+			}
+		}
+	}
+}
+
+static int codec_vp9_adapt_pending(struct amvdec_session *sess, u32 prob_status)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+
+	if ((prob_status & 0xff) == 0xfd && vp9->cur_frame) {
+		if ((prob_status >> 8) >= 4)
+			return -EINVAL;
+		/* VP9_REQ_ADAPT_PROB */
+		u8 *prev_prob_b = ((u8 *)vp9->workspace_vaddr +
+					 PROB_OFFSET) +
+					((prob_status >> 8) * 0x1000);
+		u8 *cur_prob_b = ((u8 *)vp9->workspace_vaddr +
+					 PROB_OFFSET) + 0x4000;
+		u8 *count_b = (u8 *)vp9->workspace_vaddr +
+				   COUNT_OFFSET;
+		int last_frame_type = vp9->prev_frame ?
+						vp9->prev_frame->type :
+						KEY_FRAME;
+
+		/*
+		 * Intra-only pictures produce no inter-mode or MV counts; preserve those
+		 * probabilities during adaptation (VP9 8.4).
+		 */
+		adapt_coef_probs(last_frame_type == KEY_FRAME,
+				 vp9->cur_frame->type == KEY_FRAME ||
+				 vp9->cur_frame->intra_only ? 1 : 0,
+				 prob_status >> 8,
+				 (unsigned int *)prev_prob_b,
+				 (unsigned int *)cur_prob_b,
+				 (unsigned int *)count_b);
+
+		memcpy(prev_prob_b, cur_prob_b, ADAPT_PROB_SIZE);
+		meson_amvdec_write_dos(core, VP9_ADAPT_PROB_REG, 0);
+	}
+
+	return 0;
+}
+
+void meson_amvdec_codec_vp9_request_input_ready(struct amvdec_session *sess, u32 end)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+
+	if (!vp9)
+		return;
+	meson_amvdec_trace(sess, AMVDEC_TR_READY, end, vp9->request_parked,
+		     meson_amvdec_read_dos(core, VP9_DEC_STATUS_REG));
+	mutex_lock(&vp9->lock);
+	/*
+	 * A small picture can be decoded, and the firmware parked at 0x0a,
+	 * before the feed worker that submitted it gets here.  The input being
+	 * reported is then the picture that has just completed, not the next
+	 * one: there is nothing to release and nothing wrong.
+	 */
+	if (vp9->request_parked && vp9->cur_frame &&
+	    end == vp9->cur_frame->input_end) {
+		mutex_unlock(&vp9->lock);
+		return;
+	}
+	if (vp9->request_parked && !vp9->request_failed) {
+		if (!vp9->cur_frame || end <= vp9->cur_frame->input_end ||
+		    meson_amvdec_read_dos(core, VP9_DEC_STATUS_REG) != 0x0a) {
+			dev_err(core->dev,
+				"invalid next request: end=%u prev_end=%d status=%x\n",
+				end, vp9->cur_frame ? (int)vp9->cur_frame->input_end : -1,
+				meson_amvdec_read_dos(core, VP9_DEC_STATUS_REG));
+			vp9->request_failed = true;
+			meson_amvdec_abort(sess);
+		} else {
+			meson_amvdec_write_dos(core, HEVC_DECODE_SIZE, end);
+			vp9->request_parked = false;
+			dev_dbg(core->dev, "resume endpoint=%u queued=%d\n",
+				end, atomic_read(&sess->esparser_queued_bufs));
+			meson_amvdec_write_dos_action(core, VP9_DEC_STATUS_REG, 0xff);
+		}
+	}
+	mutex_unlock(&vp9->lock);
+}
+
+static irqreturn_t codec_vp9_threaded_isr(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9 = sess->priv;
+	u32 dec_status = meson_amvdec_read_dos(core, VP9_DEC_STATUS_REG);
+	u32 prob_status = meson_amvdec_read_dos(core, VP9_ADAPT_PROB_REG);
+	int rpm_ret;
+	int i;
+
+	if (!vp9)
+		return IRQ_HANDLED;
+
+	mutex_lock(&vp9->lock);
+	if (!vp9->workspace_vaddr) {
+		/* Skip the IRQ when codec stop clears the workspace under this lock. */
+		goto unlock;
+	}
+
+	dev_dbg(core->dev_dec, "VP9 dec_status: %08X prob_status: %08X\n",
+		dec_status, prob_status);
+
+	meson_amvdec_trace(sess, AMVDEC_TR_IRQ, dec_status,
+			   meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+			   meson_amvdec_read_dos(core, HEVC_DECODE_SIZE));
+	dev_dbg(core->dev, "request irq status=%x shift=%u size=%u prob=%x lcu=%x\n",
+		dec_status, meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+		 meson_amvdec_read_dos(core, HEVC_DECODE_SIZE), prob_status,
+		 meson_amvdec_read_dos(core, HEVC_PARSER_LCU_START));
+	if (vp9->request_failed)
+		goto unlock;
+	if (dec_status == VP9_DECPIC_DATA_DONE) {
+		struct vp9_frame *f = vp9->cur_frame;
+
+		if (!vp9->request_size || !f || f->done || vp9->request_parked ||
+		    codec_vp9_adapt_pending(sess, prob_status))
+			goto request_fail;
+		f->done = 1;
+		vp9->frames_num--;
+		vp9->request_parked = true;
+		meson_amvdec_codec_vp9_arm_restream(sess);
+		meson_amvdec_trace(sess, AMVDEC_TR_DONE,
+				   meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+				   f->index, f->show);
+		dev_dbg(core->dev, "done ts=%llu idx=%u show=%u; parked\n",
+			f->vbuf->vb2_buf.timestamp, f->index, f->show);
+		meson_amvdec_request_signal(sess, f->vbuf);
+		goto unlock;
+	}
+	/*
+	 * Buffer-empty statuses wait for input. ACTION_DONE is the host resume
+	 * token, not a firmware verdict.
+	 */
+	if (dec_status == VP9_SEARCH_BUFEMPTY ||
+	    dec_status == VP9_DECODE_BUFEMPTY ||
+	    dec_status == VP9_ACTION_DONE) {
+		dev_dbg(core->dev,
+			"not a verdict status=%x; ignoring\n",
+			dec_status);
+		goto unlock;
+	}
+	if (dec_status != VP9_HEAD_PARSER_DONE) {
+request_fail:
+		dev_err(core->dev,
+			"request failed: event=%x parked=%d queued=%d frames=%u cur=%d show=%d size=%u shift=%u prob=%x\n",
+			dec_status, vp9->request_parked,
+			atomic_read(&sess->esparser_queued_bufs), vp9->frames_num,
+			vp9->cur_frame ? (int)vp9->cur_frame->index : -1,
+			vp9->cur_frame ? (int)vp9->cur_frame->show : -1,
+			meson_amvdec_read_dos(core, HEVC_DECODE_SIZE),
+			meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT), prob_status);
+		vp9->request_failed = true;
+		meson_amvdec_abort(sess);
+		goto unlock;
+	}
+
+	pr_debug("ISR: %08X;%08X\n", dec_status, prob_status);
+
+	if (codec_vp9_adapt_pending(sess, prob_status)) {
+		meson_amvdec_abort(sess);
+		goto unlock;
+	}
+
+	/* Invalidate first 3 refs */
+	for (i = 0; i < REFS_PER_FRAME ; ++i)
+		vp9->frame_refs[i] = NULL;
+
+	vp9->prev_frame = vp9->cur_frame;
+
+	codec_vp9_fetch_rpm(sess);
+	rpm_ret = codec_vp9_process_rpm(sess, vp9);
+	if (rpm_ret < 0) {
+		meson_amvdec_abort(sess);
+		goto unlock;
+	}
+	if (rpm_ret) {
+		/* No frame is actually processed */
+		vp9->cur_frame = NULL;
+
+		/* Show the remaining frame */
+		codec_vp9_show_frame(sess);
+
+		/* Drop the IRQ lock before configuration, which acquires the same lock. */
+		mutex_unlock(&vp9->lock);
+		codec_vp9_configure(sess);
+		return IRQ_HANDLED;
+	}
+
+	codec_vp9_process_lf(vp9);
+	codec_vp9_process_frame(sess);
+	codec_vp9_show_frame(sess);
+
+unlock:
+	mutex_unlock(&vp9->lock);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t codec_vp9_isr(struct amvdec_session *sess)
+{
+	return IRQ_WAKE_THREAD;
+}
+
+struct amvdec_codec_ops meson_amvdec_codec_vp9_ops = {
+	.start = codec_vp9_start,
+	.stop = codec_vp9_stop,
+	.isr = codec_vp9_isr,
+	.threaded_isr = codec_vp9_threaded_isr,
+};
