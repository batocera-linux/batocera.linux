From db2413b8333b2efef6586ed58308907e9a65f62c Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sun, 4 Oct 2026 17:22:40 +0000
Subject: [PATCH 201/210] dt-bindings: mmc: amlogic,meson-gx-mmc: add the S4
 compatible

The S4 controllers are compatible with the AXG ones but have a second
input sampling interface whose receive delay has to be tuned for UHS
timings. Add a compatible for them with the AXG fallback.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 Documentation/devicetree/bindings/mmc/amlogic,meson-gx-mmc.yaml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/mmc/amlogic,meson-gx-mmc.yaml b/Documentation/devicetree/bindings/mmc/amlogic,meson-gx-mmc.yaml
index 976f36de2091..79e8042f9fa3 100644
--- a/Documentation/devicetree/bindings/mmc/amlogic,meson-gx-mmc.yaml
+++ b/Documentation/devicetree/bindings/mmc/amlogic,meson-gx-mmc.yaml
@@ -21,6 +21,7 @@ properties:
     oneOf:
       - items:
           - enum:
+              - amlogic,s4-mmc
               - amlogic,t7-mmc
           - const: amlogic,meson-axg-mmc
       - const: amlogic,meson-axg-mmc
