log="/userdata/system/logs/amd-tdp.log"

restore_platform_profile() {
    PROFILE=$(/usr/bin/batocera-settings-get global.platformprofile)
    /usr/bin/batocera-platform-profile set "${PROFILE:-$PREVIOUS_PROFILE}"
}

case "$1" in
  start)
    # ES only offers the platform profiles listed here, and TDP only once a maximum is detected
    /usr/bin/batocera-settings-set system.platformprofile.choices "$(/usr/bin/batocera-platform-profile list)"
    # the firmware keeps the last profile across reboots, read the limits in the highest power one
    PREVIOUS_PROFILE=$(/usr/bin/batocera-platform-profile max)
    if ! lscpu | grep -q AuthenticAMD; then
        restore_platform_profile
        /usr/bin/batocera-settings-set system.cpu.tdp ""
        echo "Authentic AMD CPU not found, exiting TDP..."
        exit 1
    else
        # check if tdp capable processor exists for Ryzen Mobile Processor
        if ! ryzenadj -i | head -n 1 | grep -q "unsupported model"; then
            echo "" > $log
            echo "*** ------------------------------------- ***" >> $log
            echo "" >> $log
            echo "Supported Ryzen Mobile Processor found for TDP..." >> $log
            RYZEN_INFO=$(/usr/bin/ryzenadj -i)
            MAX_TDP=$(echo "$RYZEN_INFO" | awk '/PPT LIMIT FAST/ {printf "%.0f\n", $6}')
            # Check if MAX_TDP is defined and not-empty
            if [ -n "$MAX_TDP" ]; then
                echo "Maximum reported TDP is $MAX_TDP Watts" >> $log
                /usr/bin/batocera-settings-set system.cpu.tdp "${MAX_TDP}"
                SLOW_PERCENT=$(echo "$RYZEN_INFO" | awk '/PPT LIMIT FAST/ {f=$6} /PPT LIMIT SLOW/ {s=$6} END {if (f > 0 && s > 0) printf "%.0f\n", (s < f ? s : f) * 100 / f}')
                echo "Reported slow limit is ${SLOW_PERCENT:-unknown}% of fast" >> $log
                /usr/bin/batocera-settings-set system.cpu.tdp.slowpercent "${SLOW_PERCENT}"
                restore_platform_profile
                # set the global TDP if set
                TDP_PERCENTAGE=$(printf "%.0f" "$(/usr/bin/batocera-settings-get global.tdp)")
                if [ -n "$TDP_PERCENTAGE" ] && [ "$TDP_PERCENTAGE" -ge 10 ]; then
                    TDP_VALUE=$(awk -v max_tdp="$MAX_TDP" -v tdp_percentage="$TDP_PERCENTAGE" 'BEGIN { printf("%.0f\n", max_tdp * tdp_percentage / 100) }')
                    echo "Setting Ryzen Mobile Processor global TDP to $TDP_VALUE Watts" >> $log
                    /usr/bin/batocera-amd-tdp $TDP_VALUE
                else
                    echo "No global TDP value set, using detected maximum!" >> $log
                fi
            else
                restore_platform_profile
                /usr/bin/batocera-settings-set system.cpu.tdp ""
                echo "Maximum TDP is not defined, exiting TDP..." >> $log
                exit 1
            fi
        else
            restore_platform_profile
            /usr/bin/batocera-settings-set system.cpu.tdp ""
            echo "Supported AMD Processor NOT found for TDP..."
            exit 1
        fi
    fi
    ;;
  stop)
    # no stop behavior necessary
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
