#!/bin/bash

if ! { [ -e /sys/devices/system/cpu/cpufreq/policy0/scaling_governor ] && [ -e /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors ]; }; then
  exit 0
fi

case "$1" in
  start|restart|reload)
    /usr/bin/batocera-power-mode auto &
    ;;

  stop)
    # Do nothing to avoid delaying shutdown
    :
    ;;

  list)
    cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|reload|list}"
    exit 1
    ;;
esac
