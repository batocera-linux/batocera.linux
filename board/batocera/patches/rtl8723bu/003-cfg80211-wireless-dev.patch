Subject: [PATCH] Take a wireless_dev in the cfg80211 callbacks changed in 7.1

Kernel 7.1 switched these seven callbacks from net_device to
wireless_dev; only add_key had been converted, so the rest were handed a
wireless_dev that rtw_netdev_priv() then read as a net_device.

--- a/os_dep/ioctl_cfg80211.c
+++ b/os_dep/ioctl_cfg80211.c
@@ -1574,7 +1574,11 @@
 
 }
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int cfg80211_rtw_get_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 static int cfg80211_rtw_get_key(struct wiphy *wiphy, struct net_device *ndev,
+#endif
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6,1,0)) || defined(COMPAT_KERNEL_RELEASE)
 				int link_id, u8 key_index, bool pairwise, const u8 *mac_addr,
 #elif (LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,37)) || defined(COMPAT_KERNEL_RELEASE)
@@ -1586,11 +1590,18 @@
 				void (*callback)(void *cookie,
 						 struct key_params*))
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
+#endif
 	DBG_871X(FUNC_NDEV_FMT"\n", FUNC_NDEV_ARG(ndev));
 	return 0;
 }
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int cfg80211_rtw_del_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 static int cfg80211_rtw_del_key(struct wiphy *wiphy, struct net_device *ndev,
+#endif
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6,1,0)) || defined(COMPAT_KERNEL_RELEASE)
 				int link_id, u8 key_index, bool pairwise, const u8 *mac_addr)
 #elif (LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,37)) || defined(COMPAT_KERNEL_RELEASE)
@@ -1599,6 +1610,9 @@
 				u8 key_index, const u8 *mac_addr)
 #endif	// (LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,37))
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
+#endif
 	_adapter *padapter = (_adapter *)rtw_netdev_priv(ndev);
 	struct security_priv *psecuritypriv = &padapter->securitypriv;
 
@@ -1655,8 +1669,13 @@
 
 }
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int cfg80211_rtw_get_station(struct wiphy *wiphy,
+				    struct wireless_dev *wdev,
+#else
 static int cfg80211_rtw_get_station(struct wiphy *wiphy,
 				    struct net_device *ndev,
+#endif
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3, 16, 0))
 				    u8 *mac,
 #else
@@ -1664,6 +1683,9 @@
 #endif
 				    struct station_info *sinfo)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
+#endif
 	int ret = 0;
 	_adapter *padapter = (_adapter *)rtw_netdev_priv(ndev);
 	struct mlme_priv *pmlmepriv = &padapter->mlmepriv;
@@ -4033,7 +4055,10 @@
 
 #endif //(LINUX_VERSION_CODE < KERNEL_VERSION(3,4,0))
 
-#if (LINUX_VERSION_CODE <= KERNEL_VERSION(3, 15, 0))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int	cfg80211_rtw_add_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+			       const u8 *mac, struct station_parameters *params)
+#elif (LINUX_VERSION_CODE <= KERNEL_VERSION(3, 15, 0))
 static int	cfg80211_rtw_add_station(struct wiphy *wiphy, struct net_device *ndev,
 			       u8 *mac, struct station_parameters *params)
 #else
@@ -4041,12 +4066,18 @@
 			       const u8 *mac, struct station_parameters *params)
 #endif
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
+#endif
 	DBG_871X(FUNC_NDEV_FMT"\n", FUNC_NDEV_ARG(ndev));
 
 	return 0;
 }
 
-#if (LINUX_VERSION_CODE < KERNEL_VERSION(3,16,0))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int cfg80211_rtw_del_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+				    struct station_del_parameters *params)
+#elif (LINUX_VERSION_CODE < KERNEL_VERSION(3,16,0))
 static int cfg80211_rtw_del_station(struct wiphy *wiphy, struct net_device *ndev,
 				    u8 *mac)
 #elif (LINUX_VERSION_CODE < KERNEL_VERSION(3,19, 0))
@@ -4057,6 +4088,9 @@
 				    struct station_del_parameters *params)
 #endif
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
+#endif
 	int ret=0;
 	_irqL irqL;
 	_list	*phead, *plist;
@@ -4148,7 +4182,11 @@
 
 }
 
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int	cfg80211_rtw_change_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+#else
 static int	cfg80211_rtw_change_station(struct wiphy *wiphy, struct net_device *ndev,
+#endif
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3,16,0))
 			u8 *mac,
 #else
@@ -4156,6 +4194,9 @@
 #endif
 			struct station_parameters *params)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
+#endif
 	DBG_871X(FUNC_NDEV_FMT"\n", FUNC_NDEV_ARG(ndev));
 
 	return 0;
@@ -4181,7 +4222,10 @@
 	return psta;
 }
 
-#if (LINUX_VERSION_CODE < KERNEL_VERSION(3, 16, 0)) || \
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+static int	cfg80211_rtw_dump_station(struct wiphy *wiphy, struct wireless_dev *wdev,
+			       int idx, u8 *mac, struct station_info *sinfo)
+#elif (LINUX_VERSION_CODE < KERNEL_VERSION(3, 16, 0)) || \
     (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 1, 0))
 static int	cfg80211_rtw_dump_station(struct wiphy *wiphy, struct net_device *ndev,
 			       int idx, u8 *mac, struct station_info *sinfo)
@@ -4190,6 +4234,9 @@
 			       int idx, const u8 *mac, struct station_info *sinfo)
 #endif
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+	struct net_device *ndev = wdev->netdev;
