Subject: [PATCH] Fix build for kernel 7.2

strncpy() was removed from the kernel and cfg80211 remain_on_channel
gained an rx_addr argument.

--- a/include/osdep_service_linux.h
+++ b/include/osdep_service_linux.h
@@ -402,5 +402,21 @@
 
 #define STRUCT_PACKED __attribute__ ((packed))
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+/* strncpy() was removed from the kernel in 7.2 */
+static inline char *rtw_strncpy(char *dest, const char *src, size_t count)
+{
+	char *tmp = dest;
+
+	while (count) {
+		if ((*tmp = *src) != 0)
+			src++;
+		tmp++;
+		count--;
+	}
+	return dest;
+}
+#define strncpy rtw_strncpy
+#endif
 
 #endif
--- a/os_dep/ioctl_cfg80211.c
+++ b/os_dep/ioctl_cfg80211.c
@@ -4608,7 +4608,11 @@
 #if (LINUX_VERSION_CODE < KERNEL_VERSION(3,8,0))
 	enum nl80211_channel_type channel_type,
 #endif
-	unsigned int duration, u64 *cookie)
+	unsigned int duration, u64 *cookie
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0))
+	, const u8 *rx_addr
+#endif
+	)
 {
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3,6,0))
 	struct net_device *ndev = wdev_to_ndev(wdev);
