@@ -262,31 +263,69 @@
   return nullptr;
 }
 
+// Software decoding is left to CDVDVideoCodecFFmpeg, which converts formats the renderer lacks.
 static const AVCodec* FindDecoder(CDVDStreamInfo& hints)
 {
   const AVCodec* codec = nullptr;
   void* i = 0;
 
-  if (!(hints.codecOptions & CODEC_FORCE_SOFTWARE))
-    while ((codec = av_codec_iterate(&i)))
-    {
-      if (!av_codec_is_decoder(codec))
-        continue;
-      if (codec->id != hints.codec)
-        continue;
-
-      const AVCodecHWConfig* config = FindHWConfig(codec);
-      if (config)
-        return codec;
-    }
+  if (hints.codecOptions & CODEC_FORCE_SOFTWARE)
+    return nullptr;
+
+  while ((codec = av_codec_iterate(&i)))
+  {
+    if (!av_codec_is_decoder(codec))
+      continue;
+    if (codec->id != hints.codec)
+      continue;
 
-  codec = avcodec_find_decoder(hints.codec);
-  if (codec && (codec->capabilities & AV_CODEC_CAP_DR1) == AV_CODEC_CAP_DR1)
-    return codec;
+    const AVCodecHWConfig* config = FindHWConfig(codec);
+    if (config)
+      return codec;
+  }
 
   return nullptr;
 }
 
+// Copies a software frame into a YUV420P DMA buffer the renderer can import.
+static CVideoBuffer* ConvertFrame(AVFrame* src, CProcessInfo& processInfo,
+                                  const VideoPicture& picture)
+{
+  thread_local std::unique_ptr<SwsContext, decltype(&sws_freeContext)> sws(nullptr,
+                                                                          sws_freeContext);
+  const int width = src->width;
+  const int height = src->height;
+
+  sws.reset(sws_getCachedContext(sws.release(), width, height,
+                                 static_cast<AVPixelFormat>(src->format), width, height,
+                                 AV_PIX_FMT_YUV420P, SWS_BILINEAR, nullptr, nullptr, nullptr));
+  if (!sws)
+    return nullptr;
+
+  const int size = av_image_get_buffer_size(AV_PIX_FMT_YUV420P, width, height, 1);
+  auto buffer = dynamic_cast<CVideoBufferDMA*>(
+      processInfo.GetVideoBufferManager().Get(AV_PIX_FMT_YUV420P, size, nullptr));
+  if (!buffer)
+    return nullptr;
+
+  AVFrame* frame = av_frame_alloc();
+  if (!frame)
+  {
+    buffer->Release();
+    return nullptr;
+  }
+  frame->format = AV_PIX_FMT_YUV420P;
+  buffer->Export(frame, width, height);
+  buffer->SyncStart();
+  sws_scale(sws.get(), src->data, src->linesize, 0, height, frame->data, frame->linesize);
+  buffer->SyncEnd();
+  av_frame_free(&frame);
+
+  buffer->SetPictureParams(picture);
+  buffer->SetDimensions(width, height);
+  return buffer;
+}
